@model IEnumerable<PetLink.Models.Event>

@{
    ViewData["Title"] = "My Events";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary-blue fw-bold mb-0">
            <i class="bi bi-calendar-event me-2"></i>My Events
        </h2>
        <a asp-action="Create" class="btn btn-primary rounded-pill">
            <i class="bi bi-plus-circle me-2"></i>Create Event
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-primary-light rounded-4">
            <i class="bi bi-calendar-x fs-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No events created yet</h4>
            <p class="text-muted">Click "Create Event" to add your first event.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var eventItem in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                        <div class="position-relative" style="height: 160px; overflow: hidden;">
                            <img src="@(string.IsNullOrEmpty(eventItem.ImageUrl) ? "/images/default-event.jpg" : eventItem.ImageUrl)" 
                                 alt="@eventItem.Name" style="width: 100%; height: 100%; object-fit: cover;">
                            <span class="badge @(eventItem.Status == EventStatus.Pending ? "bg-warning" : 
                                           eventItem.Status == EventStatus.Approved ? "bg-success" : "bg-secondary") 
                                        position-absolute top-0 end-0 m-2 rounded-pill">
                                @eventItem.Status
                            </span>
                        </div>
                        <div class="card-body">
                            <h5 class="fw-bold text-primary-darkblue">@eventItem.Name</h5>
                            <p class="text-muted small mb-2">
                                <i class="bi bi-calendar-event me-1"></i> @eventItem.StartDate.ToString("dd MMM yyyy")
                            </p>
                            <p class="text-muted small mb-3">
                                <i class="bi bi-geo-alt me-1"></i> @eventItem.Location
                            </p>
                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@eventItem.Id" class="btn btn-outline-primary btn-sm rounded-pill flex-grow-1">
                                    View
                                </a>
                                <a asp-action="Edit" asp-route-id="@eventItem.Id" class="btn btn-outline-secondary btn-sm rounded-pill">
                                    Edit
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>