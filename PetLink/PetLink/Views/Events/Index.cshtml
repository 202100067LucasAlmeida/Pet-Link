@model IEnumerable<PetLink.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<section class="breadcrumb-section py-3" style="background-color: var(--petlink-card-bg); border-bottom: 1px solid var(--petlink-border);">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-highlight-darkblue">HOME</a></li>
                <li class="breadcrumb-item active text-highlight-blue" aria-current="page">EVENTS</li>
            </ol>
        </nav>
    </div>
</section>

<div class="container my-5">
    <div class="row">
        <!-- Filters Sidebar -->
        <div class="col-lg-3 mb-4 mb-lg-0">
            <div class="card filter-card rounded-4 shadow-sm p-4" style="background-color: var(--petlink-card-bg); border: 1px solid var(--petlink-border);">
                <h4 class="fw-bold text-primary-darkblue mb-3">Filters</h4>
                
                <form method="get" asp-action="Index" id="filterForm">
                    <!-- Location -->
                    <div class="mb-4">
                        <label class="filter-section-title"><i class="bi bi-geo-alt me-2"></i> LOCATION</label>
                        <input type="text" name="location" class="form-control rounded-3" placeholder="City or region" value="@ViewBag.CurrentLocation" style="background-color: var(--petlink-grey-bg);">
                    </div>

                    <!-- Date Range -->
                    <div class="mb-4">
                        <label class="filter-section-title"><i class="bi bi-calendar me-2"></i> DATE</label>
                        <div class="mb-2">
                            <label class="small text-muted">From</label>
                            <input type="date" name="startDate" class="form-control rounded-3" value="@ViewBag.CurrentStartDate" style="background-color: var(--petlink-grey-bg);">
                        </div>
                        <div>
                            <label class="small text-muted">To</label>
                            <input type="date" name="endDate" class="form-control rounded-3" value="@ViewBag.CurrentEndDate" style="background-color: var(--petlink-grey-bg);">
                        </div>
                    </div>

                    <!-- Event Type -->
                    <div class="mb-4">
                        <label class="filter-section-title"><i class="bi bi-tag me-2"></i> EVENT TYPE</label>
                        <select name="type" class="form-select rounded-3" style="background-color: var(--petlink-grey-bg);">
                            <option value="">All Types</option>
                            @foreach (EventType type in Enum.GetValues(typeof(EventType)))
                            {
                                <option value="@type" selected="@(ViewBag.CurrentType != null && (EventType)ViewBag.CurrentType == type)">@type</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-bold">Apply Filters</button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100 rounded-pill py-2 mt-2">Reset</a>
                </form>
            </div>
        </div>

        <!-- Events List -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="display-6 fw-bold text-primary-darkblue mb-1">Upcoming Events</h1>
                    <p class="text-muted">@Model.Count() events found</p>
                </div>
                @if (User.IsInRole("Shelter"))
                {
                    <a asp-action="Create" class="btn btn-primary rounded-pill">
                        <i class="bi bi-plus-circle me-2"></i>Create Event
                    </a>
                }
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5 bg-primary-light rounded-4">
                    <i class="bi bi-calendar-x fs-1 text-muted"></i>
                    <h4 class="mt-3 text-muted">No events found</h4>
                    <p class="text-muted">Try adjusting your filters or check back later for upcoming events.</p>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var eventItem in Model)
                    {
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 hover-shadow transition-all" style="background-color: var(--petlink-card-bg);">
                                <div class="position-relative" style="height: 200px; overflow: hidden;">
                                    <img src="@(string.IsNullOrEmpty(eventItem.ImageUrl) ? "/images/default-event.jpg" : eventItem.ImageUrl)" 
                                         alt="@eventItem.Name" 
                                         style="width: 100%; height: 100%; object-fit: cover;">
                                    <span class="badge bg-primary position-absolute top-0 end-0 m-3 rounded-pill">@eventItem.Type</span>
                                </div>
                                <div class="card-body">
                                    <h5 class="fw-bold text-primary-darkblue mb-2">@eventItem.Name</h5>
                                    <p class="text-muted small mb-2">
                                        <i class="bi bi-calendar-event me-1"></i> @eventItem.StartDate.ToString("dd MMM yyyy, HH:mm")
                                        @if (eventItem.EndDate.HasValue)
                                        {
                                            <span> - @eventItem.EndDate.Value.ToString("dd MMM yyyy, HH:mm")</span>
                                        }
                                    </p>
                                    <p class="text-muted small mb-3">
                                        <i class="bi bi-geo-alt me-1"></i> @eventItem.Location
                                    </p>
                                    <p class="small mb-3" style="color: var(--petlink-dark); opacity: 0.8;">
                                        @(eventItem.Description.Length > 100 ? eventItem.Description.Substring(0, 100) + "..." : eventItem.Description)
                                    </p>
                                    <a asp-action="Details" asp-route-id="@eventItem.Id" class="btn btn-outline-primary rounded-pill w-100">
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>