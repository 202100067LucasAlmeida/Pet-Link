@model PetLink.Models.Event

@{
    ViewData["Title"] = Model.Name;
}

<section class="breadcrumb-section py-3" style="background-color: var(--petlink-card-bg); border-bottom: 1px solid var(--petlink-border);">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-highlight-darkblue">HOME</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-highlight-darkblue">EVENTS</a></li>
                <li class="breadcrumb-item active text-highlight-blue">@Model.Name</li>
            </ol>
        </nav>
    </div>
</section>

<div class="container py-4">
    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/default-event.jpg" : Model.ImageUrl)" 
                     alt="@Model.Name" class="img-fluid w-100" style="max-height: 400px; object-fit: cover;">
                
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h1 class="display-5 fw-bold text-primary-darkblue mb-2">@Model.Name</h1>
                            <span class="badge bg-primary rounded-pill">@Model.Type</span>
                        </div>
                        
                        @* Botões de ação - apenas para o organizador ou admin *@
                        @if (User.Identity.IsAuthenticated)
                        {
                            var userId = User.FindFirst("UserId")?.Value;
                            bool isOrganizer = userId != null && Model.OrganizerId.ToString() == userId;
                            bool isAdmin = User.IsInRole("Admin");
                            
                            if (isOrganizer || isAdmin)
                            {
                                <div class="d-flex gap-2">
                                    @* Botão Editar - apenas para o organizador (Shelter) *@
                                    @if (isOrganizer)
                                    {
                                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </a>
                                    }
                                    
                                    @* Botão Eliminar - apenas para Admin *@
                                    @if (isAdmin)
                                    {
                                        <button type="button" class="btn btn-outline-danger rounded-pill" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </button>
                                    }
                                </div>
                            }
                        }
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-calendar-event fs-4 text-primary me-3"></i>
                                <div>
                                    <small class="text-muted d-block">Date</small>
                                    <strong>@Model.StartDate.ToString("dd MMM yyyy, HH:mm")</strong>
                                    @if (Model.EndDate.HasValue)
                                    {
                                        <span class="text-muted"> - @Model.EndDate.Value.ToString("dd MMM yyyy, HH:mm")</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-geo-alt fs-4 text-primary me-3"></i>
                                <div>
                                    <small class="text-muted d-block">Location</small>
                                    <strong>@Model.Location</strong>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-building fs-4 text-primary me-3"></i>
                                <div>
                                    <small class="text-muted d-block">Organized by</small>
                                    <strong>@Model.Organizer?.Name</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h5 class="fw-bold text-primary-darkblue mb-3">About this event</h5>
                    <p class="text-muted mb-4" style="line-height: 1.6;">@Model.Description</p>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 20px;">
                <div class="card-header bg-primary text-white py-3 rounded-top-4">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2"></i>Event Status</h5>
                </div>
                <div class="card-body">
                    @if (Model.Status == EventStatus.Approved)
                    {
                        <div class="alert alert-success border-0 rounded-3">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <strong>Approved</strong><br>
                            <small>This event is confirmed and open to the public.</small>
                        </div>
                    }
                    else if (Model.Status == EventStatus.Pending)
                    {
                        <div class="alert alert-warning border-0 rounded-3">
                            <i class="bi bi-clock-history me-2"></i>
                            <strong>Pending Approval</strong><br>
                            <small>This event is awaiting admin review.</small>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary border-0 rounded-3">
                            <i class="bi bi-x-circle me-2"></i>
                            <strong>@Model.Status</strong>
                        </div>
                    }

    @if (User.Identity.IsAuthenticated && Model.Status == EventStatus.Approved)
    {
        var userId = User.FindFirst("UserId")?.Value;
        bool isOrganizer = userId != null && Model.OrganizerId.ToString() == userId;
        
        if (!isOrganizer)
        {
            <div class="mt-3">
                <button class="btn btn-primary rounded-pill w-100 fw-bold" id="registerInterestBtn" data-event-id="@Model.Id">
                    <i class="bi bi-calendar-plus me-2"></i>Enroll
                </button>
                <div id="interestStatus" class="mt-2 text-center small" style="display: none;">
                    <i class="bi bi-check-circle-fill text-success me-1"></i>
                    <span>You are registered for this event</span>
                </div>
            </div>
        }
    }

                    @if (User.IsInRole("Shelter"))
                    {
                        <hr>
                        <div class="text-center">
                            <i class="bi bi-share fs-4 text-muted"></i>
                            <p class="small text-muted mt-2 mb-0">Share this event with your community</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold text-danger" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Event
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>
                <p class="text-muted small">This action cannot be undone. All data related to this event will be permanently removed.</p>
            </div>
            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger rounded-pill">
                        <i class="bi bi-trash me-1"></i>Delete Event
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function() {
            var eventId = @Model.Id;
            var registerBtn = $('#registerInterestBtn');
            var interestStatus = $('#interestStatus');

            // Verificar se já está registado
            $.ajax({
                url: '/Events/CheckInterest/' + eventId,
                type: 'GET',
                success: function(data) {
                    if (data.registered) {
                        registerBtn.hide();
                        interestStatus.show();
                    }
                }
            });

            // Registar interesse
            registerBtn.click(function() {
                $.ajax({
                    url: '/Events/RegisterInterest/' + eventId,
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            if (response.registered) {
                                registerBtn.hide();
                                interestStatus.show();
                                showNotification('You are now registered for this event!');
                            } else {
                                registerBtn.show();
                                interestStatus.hide();
                                showNotification('Interest removed.');
                            }
                        } else {
                            showNotification(response.message, 'error');
                        }
                    },
                    error: function() {
                        showNotification('Error registering interest. Please try again.', 'error');
                    }
                });
            });

            function showNotification(message, type) {
                var toast = $(`<div class="toast-notification">${message}</div>`);
                $('body').append(toast);
                setTimeout(() => toast.fadeOut(300, function() { $(this).remove(); }), 2000);
            }
        });
    </script>
}