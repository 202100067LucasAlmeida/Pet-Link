@model PetLink.Models.AnimalListing

@{
    ViewData["Title"] = Model.Name + " - Pet Details";
}

<link rel="stylesheet" href="~/css/adopt.css" asp-append-version="true" />

<section class="breadcrumb-section py-3"
         style="background-color: var(--petlink-card-bg); border-bottom: 1px solid var(--petlink-border);">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"
                                                   class="text-decoration-none text-highlight-darkblue">HOME</a>
                </li>
                <li class="breadcrumb-item"><a asp-controller="AnimalListings" asp-action="Index"
                                                   class="text-decoration-none text-highlight-darkblue">ADOPT</a>
                </li>
                <li class="breadcrumb-item active text-highlight-blue" aria-current="page">@Model.Name</li>
            </ol>
        </nav>
    </div>
</section>

<section class="py-4">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            @if (Model.Status.ToString() == "Published")
                            {
                                <span class="badge bg-success mb-2">AVAILABLE FOR ADOPTION</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary mb-2">@Model.Status.ToString().ToUpper()</span>
                            }

                            <h1 class="display-5 text-primary-darkblue mb-2 fw-bold">@Model.Name</h1>
                            <p class="lead text-secondary-grey text-highlight-darkblue">
                                @Model.Species • @Model.Location • @Model.AgeMonths months
                            </p>
                        </div>
                    </div>
                </div>

                <div class="position-relative mb-4 shadow-sm"
                     style="border-radius: 1.5rem; overflow: hidden; background: var(--petlink-grey-bg); border: 1px solid var(--petlink-border);">
                    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/default-pet.jpg" : Model.ImageUrl)"
                         alt="@Model.Name's photo" class="img-fluid w-100"
                         style="max-height: 500px; min-height: 400px; object-fit: cover;" />
                    
                    @if (!ViewBag.IsOwner && (User.IsInRole("User") || User.IsInRole("PetSitter")))
                    {
                        <button class="btn-heart position-absolute top-0 end-0 m-3" data-pet-id="@Model.Id"
                                id="favoriteBtn">
                            <i class="bi bi-heart" id="favoriteIcon"></i>
                        </button>
                    }
                </div>

                @* Galeria de Fotos *@
                @if (Model.Photos != null && Model.Photos.Any())
                {
                    <div class="row g-2 mb-4">
                        @foreach (var photo in Model.Photos)
                        {
                            <div class="col-3 col-md-2">
                                <a href="@photo.Url" target="_blank">
                                    <img src="@photo.Url" class="img-fluid rounded-3 border"
                                         style="height: 80px; width: 100%; object-fit: cover; border-color: var(--petlink-border) !important;" />
                                </a>
                            </div>
                        }
                    </div>
                }

                <div class="shadow-sm card border-0 rounded-4 mb-5" style="background-color: var(--petlink-card-bg);">
                    <div class="card-body p-0">
                        <div class="p-4 d-flex justify-content-around flex-wrap rounded-top-4 border-bottom"
                             style="background-color: var(--petlink-grey-bg); border-color: var(--petlink-border) !important;">
                            <div class="text-center">
                                <span class="d-block text-secondary-grey small fw-bold text-uppercase">Age</span>
                                <span class="text-primary-darkblue fs-5 fw-semibold">@Model.AgeMonths mo.</span>
                            </div>
                            <div class="text-center">
                                <span class="d-block text-secondary-grey small fw-bold text-uppercase">Location</span>
                                <span class="text-primary-darkblue fs-5 fw-semibold">@Model.Location</span>
                            </div>
                            <div class="text-center">
                                <span class="d-block text-secondary-grey small fw-bold text-uppercase">Species</span>
                                <span class="text-primary-darkblue fs-5 fw-semibold">@Model.Species</span>
                            </div>
                        </div>

                        <div class="p-4">
                            <p class="lead text-secondary-grey mb-4"
                                   style="color: var(--petlink-dark) !important; opacity: 0.8;">
                                @Model.Description
                            </p>

                            @if (!ViewBag.IsOwner)
                            {
                                @if (ViewBag.HasApplied != null && ViewBag.HasApplied)
                                {
                                    <div class="alert border-0 rounded-4 text-center"
                                         style="background-color: var(--petlink-light-bg); color: var(--petlink-primary);">
                                        <i class="bi bi-check me-2"></i> You have already applied to adopt
                                        @Model.Name!
                                    </div>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-primary fw-bold rounded-pill px-5 py-2"
                                            data-bs-toggle="modal" data-bs-target="#adoptModal">
                                        Adopt @Model.Name
                                    </button>

                                    <p class="mt-3 small text-secondary-grey">
                                        By clicking "Adopt", you agree to our
                                        <a href="#" class="text-decoration-none">Adoption Terms</a>.
                                    </p>
                                }
                            }
                            else
                            {
                                <div class="alert alert-info border-0 rounded-4 text-center"
                                     style="background-color: var(--petlink-light-bg); color: var(--petlink-primary);">
                                    <i class="bi bi-info-circle me-2"></i>This is your pet's listing.
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- ========== MEDICAL HISTORY COM BADGES DINÂMICAS ========== -->
                <div class="medical-history mb-5">
                    <h3 class="h4 text-primary-darkblue mb-3 fw-bold">
                        <i class="bi bi-heart-pulse me-2"></i>Medical History
                    </h3>
                    
                    <div class="row g-3">
                        <!-- Vaccinated Badge -->
                        <div class="col-md-4">
                            <div class="card border-0 rounded-3 h-100 text-center p-3"
                                 style="background-color: var(--petlink-grey-bg);">
                                <div class="mb-2">
                                    @if (Model.IsVaccinated)
                                    {
                                        <i class="bi bi-shield-check text-success" style="font-size: 2rem;"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-shield-exclamation text-danger" style="font-size: 2rem;"></i>
                                    }
                                </div>
                                <h6 class="fw-bold mb-1 @(Model.IsVaccinated ? "text-success" : "text-danger")">
                                    @(Model.IsVaccinated ? "VACCINATED" : "NOT VACCINATED")
                                </h6>
                                <small class="text-secondary-grey">
                                    @(Model.IsVaccinated ? "Pet has up-to-date vaccinations" : "Vaccination status unknown")
                                </small>
                            </div>
                        </div>

                        <!-- Dewormed Badge -->
                        <div class="col-md-4">
                            <div class="card border-0 rounded-3 h-100 text-center p-3"
                                 style="background-color: var(--petlink-grey-bg);">
                                <div class="mb-2">
                                    @if (Model.IsDewormed)
                                    {
                                        <i class="bi bi-capsule text-success" style="font-size: 2rem;"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-exclamation-triangle text-danger" style="font-size: 2rem;"></i>
                                    }
                                </div>
                                <h6 class="fw-bold mb-1 @(Model.IsDewormed ? "text-success" : "text-danger")">
                                    @(Model.IsDewormed ? "DEWORMED" : "NOT DEWORMED")
                                </h6>
                                <small class="text-secondary-grey">
                                    @(Model.IsDewormed ? "Pet has been dewormed" : "Deworming status unknown")
                                </small>
                            </div>
                        </div>

                        <!-- Sterilized Badge -->
                        <div class="col-md-4">
                            <div class="card border-0 rounded-3 h-100 text-center p-3"
                                 style="background-color: var(--petlink-grey-bg);">
                                <div class="mb-2">
                                    @if (Model.IsSterilized)
                                    {
                                        <i class="bi bi-heart-pulse text-success" style="font-size: 2rem;"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-info-circle text-danger" style="font-size: 2rem;"></i>
                                    }
                                </div>
                                <h6 class="fw-bold mb-1 @(Model.IsSterilized ? "text-success" : "text-danger")">
                                    @(Model.IsSterilized ? "STERILIZED" : "NOT STERILIZED")
                                </h6>
                                <small class="text-secondary-grey">
                                    @(Model.IsSterilized ? "Pet is neutered/spayed" : "Sterilization status unknown")
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- In Details.cshtml, add this after the health information display -->
                    @if (User.IsInRole("Admin") && Model.HealthDocuments.Any())
                    {
                        <div class="card mt-4">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0"><i class="bi bi-check2-circle me-2"></i>Document Verification Status</h5>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Document Type</th>
                                                <th>Document</th>
                                                <th>Verification Status</th>
                                                <th>Verified By</th>
                                                <th>Verified At</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var doc in Model.HealthDocuments)
                                            {
                                                <tr>
                                                    <td>@doc.Type</td>
                                                    <td>
                                                        <a href="@doc.FilePath" target="_blank" class="btn btn-sm btn-link">
                                                            View Document
                                                        </a>
                                                    </td>
                                                    <td>
                                                        @if (doc.IsVerified)
                                                        {
                                                            <span class="badge bg-success">Verified</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning text-dark">Pending</span>
                                                        }
                                                    </td>
                                                    <td>@(doc.VerifiedByAdmin?.Email ?? "N/A")</td>
                                                    <td>@(doc.VerifiedAt?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                </div>


                <!-- ========== FIM MEDICAL HISTORY ========== -->

                @* Temperamento com Badges Opacas (Melhor para Dark Mode) *@
                <div class="temperament mb-5">
                    <h3 class="h4 text-primary-darkblue mb-3 fw-bold">
                        <i class="bi bi-emoji-smile me-2"></i>Temperament
                    </h3>
                    <div class="d-flex gap-3 flex-wrap">
                        <span class="badge rounded-pill border py-2 px-3 fw-bold"
                              class="badge-status-completed">
                            <i class="bi bi-people me-1"></i> Kid Friendly
                        </span>
                        <span class="badge rounded-pill border py-2 px-3 fw-bold"
                              class="badge-status-completed">
                            <i class="bi bi-house-heart me-1"></i> Calm at Home
                        </span>
                        <span class="badge rounded-pill border py-2 px-3 fw-bold"
                              class="badge-status-completed">
                            <i class="bi bi-chat-heart me-1"></i> Social
                        </span>
                    </div>
                </div>

                <!-- Botão para avaliar -->
                @if (User.Identity.IsAuthenticated && ViewBag.CanReview != null && ViewBag.CanReview == true)
                {
                    <div class="mt-4">
                        <a asp-controller="Review" asp-action="Create" asp-route-animalListingId="@Model.Id"
                               class="btn btn-outline-warning rounded-pill">
                            <i class="bi bi-star-fill me-2"></i> Review This Adoption
                        </a>
                    </div>
                }
            </div>

            <div class="col-lg-4">
                @if (ViewBag.IsOwner)
                {
                    <div class="card shadow-sm border-0 sticky-top"
                         style="top: 20px; border-radius: 20px; overflow: hidden; background-color: var(--petlink-card-bg); border: 1px solid var(--petlink-border) !important;">
                        <div class="card-body text-center p-5">
                            <i class="bi bi-star-fill text-warning mb-3" style="font-size: 3rem;"></i>
                            <h4 class="fw-bold text-primary-darkblue">Your listing</h4>
                            <p class="text-secondary-grey small mb-4">You are viewing your pet's public listing.</p>
                            <a asp-action="Edit" asp-route-id="@Model.Id"
                                   class="btn btn-primary rounded-pill w-100 fw-bold py-2 mb-2">
                                <i class="bi bi-pencil-square me-2"></i>Edit Listing
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card shadow-sm border-0 sticky-top"
                         style="top: 20px; border-radius: 20px; overflow: hidden; background-color: var(--petlink-card-bg); border: 1px solid var(--petlink-border) !important;">
                        <div class="card-header py-3 border-0"
                             style="background-color: var(--petlink-primary); color: white;">
                            <div class="d-flex align-items-center">
                                <div class="bg-white rounded-circle p-1 me-2 d-flex align-items-center justify-content-center"
                                     style="width: 35px; height: 35px;">
                                    <i class="bi bi-person-badge text-primary"></i>
                                </div>
                                <div>
                                    <h3 class="h6 mb-0 fw-bold">@(Model.Tutor?.Name ?? "Pet Tutor")</h3>
                                    <div style="font-size: 0.7rem; opacity: 0.8;">Chat about @Model.Name</div>
                                </div>
                            </div>
                        </div>

                        <div class="card-body" id="chatBox"
                             style="height: 400px; overflow-y: auto; background-color: var(--petlink-grey-bg);">
                            @if (ViewBag.ChatHistory != null &&
                                                                                                                                                                    ((IEnumerable<PetLink.Models.Message>)ViewBag.ChatHistory).Any())
                            {
                                var currentUserId = int.Parse(User.FindFirst("UserId")?.Value ?? "0");
                                foreach (var msg in (IEnumerable<PetLink.Models.Message>)ViewBag.ChatHistory)
                                {
                                    bool isMine = msg.SenderId == currentUserId;
                                    <div class="d-flex mb-3 @(isMine ? "justify-content-end" : "justify-content-start")">
                                        <div class="p-3 shadow-sm"
                                             style="max-width: 85%; font-size: 0.85rem; border-radius: 15px; 
                                            @(isMine ? "background-color: var(--petlink-highlight); color: white; border-bottom-right-radius: 4px;"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      : "background-color: var(--petlink-card-bg); color: var(--petlink-dark); border-bottom-left-radius: 4px; border: 1px solid var(--petlink-border);")">
                                            <p class="mb-1">@msg.Content</p>
                                            <div class="text-end" style="font-size: 0.6rem; opacity: 0.6;">
                                                @msg.Timestamp.ToString("HH:mm")
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="h-100 d-flex flex-column align-items-center justify-content-center text-center p-4">
                                    <i class="bi bi-chat-left-dots text-secondary-grey opacity-25 mb-2"
                                       style="font-size: 2.5rem;"></i>
                                    <p class="text-secondary-grey small">No messages yet. Say hi!</p>
                                </div>
                            }
                        </div>

                        <div class="card-footer border-0 p-3" style="background-color: var(--petlink-card-bg);">
                            <a asp-controller="Messages" asp-action="Index" asp-route-id="@Model.TutorId"
                                   class="btn btn-primary w-100 fw-bold rounded-pill py-2 d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-chat-dots-fill"></i> Message Tutor
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@* Secção de Outros Animais *@
<section class="featured-section py-5 mt-4 border-top"
         style="background-color: var(--petlink-grey-bg); border-color: var(--petlink-border) !important;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <span class="text-primary small fw-bold">RECENTLY ADDED</span>
                <h2 class="h3 text-primary-darkblue mb-0 fw-bold">Featured Animals</h2>
            </div>
            <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 fw-bold">View All</a>
        </div>

        <div class="row g-4">
            @foreach (var pet in ViewBag.OtherPets as IEnumerable<PetLink.Models.AnimalListing>)
            {
                <div class="col-md-6 col-lg-3">
                    <a asp-action="Details" asp-route-id="@pet.Id" class="text-decoration-none">
                        <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden pet-card"
                             style="background-color: var(--petlink-card-bg);">
                            <img src="@(string.IsNullOrEmpty(pet.ImageUrl) ? "/images/default-pet.jpg" : pet.ImageUrl)"
                                 class="img-fluid w-100" style="height: 200px; object-fit: cover;"
                                 onerror="this.src='/images/default-pet.jpg'" />

                            <div class="card-body">
                                <h3 class="h5 text-primary-darkblue fw-bold mb-2">@pet.Name</h3>
                                <div class="text-secondary-grey small">
                                    <p class="mb-1"><i class="bi bi-geo-alt me-1"></i> @pet.Location</p>
                                    <div class="d-flex gap-2 mt-2">
                                        @if (pet.IsVaccinated)
                                        {
                                            <i class="bi bi-shield-check text-success" title="Vaccinated"></i>
                                        }
                                        @if (pet.IsDewormed)
                                        {
                                            <i class="bi bi-capsule text-success" title="Dewormed"></i>
                                        }
                                        @if (pet.IsSterilized)
                                        {
                                            <i class="bi bi-heart-pulse text-success" title="Sterilized"></i>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<div class="modal fade" id="adoptModal" tabindex="-1" aria-labelledby="adoptModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-primary-darkblue" id="adoptModalLabel">Adopt @Model.Name</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <form asp-controller="Applications" asp-action="Create" method="post"
                  onsubmit="document.getElementById('confirmAdoptBtn').disabled = true; document.getElementById('confirmAdoptBtn').innerHTML = 'Sending...';">
                @Html.AntiForgeryToken()
                <input type="hidden" name="AnimalListingId" value="@Model.Id" />
                
                <div class="modal-body">
                    <p class="text-secondary-grey small mb-4">
                        You are about to send an adoption request to <strong>@(Model.Tutor?.Name ?? "the shelter")</strong>. Please introduce yourself and explain why you would be a great match for
                        @Model.Name!
                    </p>
                    
                    <div class="mb-3">
                        <label for="Message" class="form-label fw-bold text-primary-darkblue">Your Message</label>
                        <textarea class="form-control rounded-3" id="Message" name="Message" rows="4" required
                                  placeholder="Hi! I would love to adopt @Model.Name because..."></textarea>
                    </div>
                    
                    <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" value="true" id="acceptTerms" required>
                        <label class="form-check-label text-secondary-grey small" for="acceptTerms">
                            I accept the <a href="#" class="text-decoration-none">Terms and Conditions</a> of the
                            adoption process, and I confirm that I am able to provide a safe and loving home.
                        </label>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill fw-bold" id="confirmAdoptBtn"
                            disabled>Send Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/adopt.js" asp-append-version="true"></script>

@section Scripts {
    <script>
        $(document).ready(function () {
            var petId = @Model.Id;
            var favoriteBtn = $('#favoriteBtn');
            var favoriteIcon = $('#favoriteIcon');
            
            // Verificar estado inicial
            $.ajax({
                url: '@Url.Action("Check", "Favorites")',
                type: 'GET',
                data: { animalListingId: petId },
                success: function (isFavorited) {
                    if (isFavorited) {
                        favoriteIcon.removeClass('bi-heart').addClass('bi-heart-fill text-danger');
                        favoriteBtn.addClass('active');
                    }
                },
                error: function () {
                    console.log('Erro ao verificar favorito');
                }
            });
            
            // Clique no coração
            favoriteBtn.click(function (e) {
                e.preventDefault();
                e.stopPropagation();
                
                $.ajax({
                    url: '@Url.Action("Toggle", "Favorites")',
                    type: 'POST',
                    data: { animalListingId: petId },
                    success: function (response) {
                        if (response.success) {
                            if (response.isFavorited) {
                                favoriteIcon.removeClass('bi-heart').addClass('bi-heart-fill text-danger');
                                favoriteBtn.addClass('active');
                                showNotification('Added to favorites!');
                            } else {
                                favoriteIcon.removeClass('bi-heart-fill text-danger').addClass('bi-heart');
                                favoriteBtn.removeClass('active');
                                showNotification('Removed from favorites!');
                            }
                        } else {
                            showNotification(response.message, 'error');
                        }
                    },
                    error: function () {
                        showNotification('Error updating favorite. Please try again.', 'error');
                    }
                });
            });
            
            function showNotification(message) {
                // Remove notificações anteriores
                $('.toast-notification').remove();
                
                var toast = $(`<div class="toast-notification">${message}</div>`);
                $('body').append(toast);
                setTimeout(() => {
                    toast.fadeOut(300, function () {
                        $(this).remove();
                    });
                }, 2000);
            }

            $('#acceptTerms').change(function () {
                $('#confirmAdoptBtn').prop('disabled', !this.checked);
            });
        });
    </script>
}