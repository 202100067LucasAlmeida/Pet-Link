@model PetLink.Models.AnimalListing

@{
    ViewData["Title"] = "Edit Listing";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-primary-blue fw-bold mb-0">
                    <i class="bi bi-pencil-square me-2"></i> Edit Animal Listing
                </h2>
                @* Botão Back Dinâmico *@
                <a asp-action="@(User.IsInRole("Admin") ? "Manage" : "MyListings")"
                       class="btn btn-outline-secondary rounded-pill btn-sm fw-bold text-primary-darkblue"
                       style="border-color: var(--petlink-border) !important;">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>

            @* Card com fundo dinâmico *@
            <div class="card border-0 shadow-sm rounded-4" style="background-color: var(--petlink-card-bg);">
                <div class="card-body p-4 p-md-5">

                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-semibold small"></div>
                        
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />
                        <input type="hidden" asp-for="ImageUrl" />

                        @if (!User.IsInRole("Admin"))
                        {
                            <input type="hidden" asp-for="TutorId" />
                            <input type="hidden" asp-for="Status" />
                        }

                        <h5 class="fw-bold text-primary-darkblue mb-3 border-bottom pb-2"
                            style="border-color: var(--petlink-border) !important;">Basic Information
                        </h5>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label fw-semibold text-primary-darkblue">Animal
                                    Name
                                </label>
                                <input asp-for="Name" class="form-control py-2"
                                       style="background-color: var(--petlink-grey-bg); color: var(--petlink-dark); border: 1px solid var(--petlink-border);" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Species" class="form-label fw-semibold text-primary-darkblue">Species
                                </label>
                                <select asp-for="Species" class="form-select py-2"
                                        style="background-color: var(--petlink-grey-bg); color: var(--petlink-dark); border: 1px solid var(--petlink-border);"
                                        asp-items="Html.GetEnumSelectList<PetLink.Models.Enums.Species>()"></select>
                                <span asp-validation-for="Species" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="AgeMonths" class="form-label fw-semibold text-primary-darkblue">Age
                                    (months)
                                </label>
                                <input asp-for="AgeMonths" class="form-control py-2"
                                       style="background-color: var(--petlink-grey-bg); color: var(--petlink-dark); border: 1px solid var(--petlink-border);" />
                                <span asp-validation-for="AgeMonths" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Location" class="form-label fw-semibold text-primary-darkblue">Location
                                </label>
                                <input asp-for="Location" class="form-control py-2"
                                       style="background-color: var(--petlink-grey-bg); color: var(--petlink-dark); border: 1px solid var(--petlink-border);" />
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description"
                                   class="form-label fw-semibold text-primary-darkblue">Description
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="3"
                                      style="background-color: var(--petlink-grey-bg); color: var(--petlink-dark); border: 1px solid var(--petlink-border);"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <h5 class="fw-bold text-primary-darkblue mb-3 border-bottom pb-2 mt-4"
                            style="border-color: var(--petlink-border) !important;">Update Photos</h5>
                        <div class="row align-items-center mb-4 p-3 rounded-3 mx-0"
                             style="background-color: var(--petlink-grey-bg); border: 1px solid var(--petlink-border);">
                            <div class="col-md-3 text-center">
                                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/default-pet.jpg" : Model.ImageUrl)"
                                     class="img-thumbnail rounded-3 shadow-sm mb-2"
                                     style="max-height: 120px; width: 100%; object-fit: cover; background-color: var(--petlink-card-bg); border-color: var(--petlink-border);"
                                     onerror="this.src='/images/default-pet.jpg'" />
                                <span class="badge bg-secondary">Current</span>
                            </div>
                            <div class="col-md-9 mt-3 mt-md-0">
                                <label class="form-label fw-semibold small text-primary-darkblue">Replace Main
                                    Photo
                                </label>
                                <input type="file" name="mainPhoto" class="form-control form-control-sm"
                                       style="background-color: var(--petlink-card-bg); color: var(--petlink-dark); border: 1px solid var(--petlink-border);"
                                       accept="image/*" />
                                <p class="text-secondary-grey small mt-1 mb-0">Leave empty to keep current photo.</p>
                            </div>
                        </div>

                        <h5 class="fw-bold text-primary-darkblue mb-3 border-bottom pb-2 mt-4"
                            style="border-color: var(--petlink-border) !important;">Health Information</h5>
                        <div class="d-flex flex-wrap gap-4 mb-4 p-3 rounded-3"
                             style="background-color: var(--petlink-grey-bg); border: 1px solid var(--petlink-border);">
                            <div class="form-check form-switch fs-6">
                                <input class="form-check-input" type="checkbox" asp-for="IsVaccinated" />
                                <label class="form-check-label fw-semibold text-success"
                                       asp-for="IsVaccinated">Vaccinated</label>
                            </div>
                            <div class="form-check form-switch fs-6">
                                <input class="form-check-input" type="checkbox" asp-for="IsDewormed" />
                                <label class="form-check-label fw-semibold text-success"
                                       asp-for="IsDewormed">Dewormed</label>
                            </div>
                            <div class="form-check form-switch fs-6">
                                <input class="form-check-input" type="checkbox" asp-for="IsSterilized" />
                                <label class="form-check-label fw-semibold text-success"
                                       asp-for="IsSterilized">Sterilized</label>
                            </div>

                            <!-- TESTE DE VER A IMAGEM (copiei da foto main)-->
                            <div class="col-md-3 text-center">
                                <img src="@(string.IsNullOrEmpty(Model.VaccinationProofUrl) ? "no vaccination" : Model.VaccinationProofUrl)"
                                     class="img-thumbnail rounded-3 shadow-sm mb-2"
                                     style="max-height: 120px; width: 100%; object-fit: cover; background-color: var(--petlink-card-bg); border-color: var(--petlink-border);"
                                     onerror="this.src='/images/default-pet.jpg'" />
                            </div>

                        </div>

                        @if (User.IsInRole("Admin"))
                        {
                            <h5 class="fw-bold text-danger mb-3 border-bottom pb-2 mt-4">Admin Controls</h5>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Status" class="form-label fw-semibold text-primary-darkblue">Status
                                    </label>
                                    <select asp-for="Status" class="form-select py-2"
                                            style="background-color: var(--petlink-grey-bg); color: var(--petlink-dark); border: 1px solid var(--petlink-primary);"
                                            asp-items="Html.GetEnumSelectList<PetLink.Models.Enums.ListingStatus>()">
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="TutorId" class="form-label fw-semibold text-primary-darkblue">Transfer
                                        Tutor
                                    </label>
                                    <select asp-for="TutorId" class="form-select py-2"
                                            style="background-color: var(--petlink-grey-bg); color: var(--petlink-dark); border: 1px solid var(--petlink-primary);"
                                            asp-items="ViewBag.TutorId">
                                    </select>
                                </div>
                            </div>
                        }

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary fw-bold rounded-pill py-3 shadow">
                                <i class="bi bi-save me-2"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}