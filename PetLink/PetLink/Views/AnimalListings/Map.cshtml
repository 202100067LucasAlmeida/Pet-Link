@using PetLink.Models.Enums
@model IEnumerable<PetLink.Models.AnimalListing>

@{
    ViewData["Title"] = "Map Explorer";
    Layout = "_Layout"; 
}

<style>
    body { overflow: hidden; } 
    
    .sidebar-scroll {
        overflow-y: auto;
        flex-grow: 1;
        height: 0;
    }
    
    .sidebar-scroll::-webkit-scrollbar { width: 6px; }
    .sidebar-scroll::-webkit-scrollbar-thumb { 
        background-color: rgba(0, 0, 0, 0.15);
        border-radius: 10px; 
    }
</style>

<div class="container-fluid p-0" style="height: calc(100vh - 76px); background-color: var(--petlink-card-bg);">
    <div class="row g-0 h-100">
        
        <div class="col-lg-4 col-xl-3 d-flex flex-column shadow-sm" style="background-color: var(--petlink-card-bg); z-index: 10; border-right: 1px solid var(--petlink-border);">
            
            <div class="p-4 border-bottom" style="border-color: var(--petlink-border) !important;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h1 class="h4 text-primary-darkblue fw-bold mb-0">Map Explorer</h1>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill">List View</a>
                </div>

                <form asp-controller="AnimalListings" asp-action="Map" method="get">
                    
                    <!-- BARRA DE PESQUISA (Localização) -->
                    <div class="input-group mb-4 rounded-pill" style="background-color: var(--petlink-grey-bg); border: 1px solid var(--petlink-border);">
                        <span class="input-group-text bg-transparent border-0"><i class="bi bi-search text-secondary-grey"></i></span>
                        <input type="text" name="location" value="@ViewBag.CurrentLocation" class="form-control border-0 bg-transparent text-primary-darkblue" placeholder="Search locations...">
                    </div>

                    <!-- FILTRO DE ESPÉCIE (Botões Dinâmicos) -->
                    <div class="mb-4">
                        <label class="small fw-bold text-secondary-grey mb-2"><i class="bi bi-funnel me-1"></i> ANIMAL TYPE</label>
                        <div class="row g-2">
                            <!-- Opção "All Pets" é importante num filtro de rádio para poder limpar a seleção -->
                            <div class="col-12">
                                <input type="radio" class="btn-check" name="species" value="" id="allPets" 
                                    @(string.IsNullOrEmpty(ViewBag.CurrentSpecies?.ToString()) ? "checked" : "")>
                                <label class="btn btn-outline-secondary btn-sm w-100 rounded-pill fw-bold" for="allPets">All Pets</label>
                            </div>
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="species" value="@Species.Dog" id="dog" 
                                    @(ViewBag.CurrentSpecies?.ToString() == Species.Dog.ToString() ? "checked" : "")>
                                <label class="btn btn-outline-primary btn-sm w-100 rounded-pill fw-bold" for="dog">🐶 Dogs</label>
                            </div>
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="species" value="@Species.Cat" id="cat" 
                                    @(ViewBag.CurrentSpecies?.ToString() == Species.Cat.ToString() ? "checked" : "")>
                                <label class="btn btn-outline-primary btn-sm w-100 rounded-pill fw-bold" for="cat">🐱 Cats</label>
                            </div>
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="species" value="@Species.Bird" id="bird" 
                                    @(ViewBag.CurrentSpecies?.ToString() == Species.Bird.ToString() ? "checked" : "")>
                                <label class="btn btn-outline-primary btn-sm w-100 rounded-pill fw-bold" for="bird">🦜 Birds</label>
                            </div>
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="species" value="@Species.Other" id="other" 
                                    @(ViewBag.CurrentSpecies?.ToString() == Species.Other.ToString() ? "checked" : "")>
                                <label class="btn btn-outline-primary btn-sm w-100 rounded-pill fw-bold" for="other">🐾 Others</label>
                            </div>
                        </div>
                    </div>

                    <!-- FILTRO DE IDADE -->
                    <div class="mb-4">
                        <label class="small fw-bold text-secondary-grey mb-2"><i class="bi bi-clock me-1"></i> AGE</label>
                        <select name="age" class="form-select form-select-sm rounded-pill border-0 text-center fw-bold text-primary-darkblue shadow-sm" style="background-color: var(--petlink-grey-bg);">
                            <option value="">Any Age</option>
                            <option value="@Age.Puppy" selected="@(ViewBag.CurrentAge?.ToString() == Age.Puppy.ToString())">Baby</option>
                            <option value="@Age.Adult" selected="@(ViewBag.CurrentAge?.ToString() == Age.Adult.ToString())">Adult</option>
                        </select>
                    </div>

                    <!-- BOTÕES DE SUBMIT/CLEAR -->
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm rounded-pill w-100 fw-bold shadow-sm">Search Map</button>
                        
                        @if(ViewBag.CurrentSpecies != null || ViewBag.CurrentLocation != null || ViewBag.CurrentAge != null)
                        {
                            <a asp-action="Map" class="btn btn-outline-danger btn-sm rounded-circle shadow-sm" title="Clear Filters"><i class="bi bi-x-lg"></i></a>
                        }
                    </div>
                </form>
            </div>

            <div class="p-3">
                <p class="small fw-bold text-secondary-grey mb-3 px-2">@Model.Count() results found</p>
            </div>
            
            <div class="sidebar-scroll px-3 pb-4">
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <div class="card mb-3 border-0 shadow-sm" style="border-radius: 12px; background-color: var(--petlink-grey-bg);">
                            <div class="row g-0">
                                <div class="col-4">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/default-pet.jpg" : item.ImageUrl)" 
                                    class="w-100" 
                                    style="height: 120px; object-fit: cover; border-top-left-radius: 12px; border-bottom-left-radius: 12px;" 
                                    alt="@item.Name">
                                </div>
                                <div class="col-8">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <h5 class="card-title mb-0 fw-bold text-primary-darkblue" style="font-size: 1rem;">@item.Name</h5>
                                            <span class="badge bg-success rounded-pill" style="font-size: 0.6rem;">AVAILABLE</span>
                                        </div>
                                        <p class="card-text small text-secondary-grey mb-2"><i class="bi bi-geo-alt"></i> @item.Location</p>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-bold small text-primary">View Pet <i class="bi bi-arrow-right"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center mt-5 text-secondary-grey">
                        <i class="bi bi-emoji-frown fs-1 mb-2 opacity-50"></i>
                        <p>No pets found with these filters.</p>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-8 col-xl-9 position-relative h-100">
            <div id="fullMap" style="height: 100%; width: 100%; z-index: 1;"></div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        var petsArray = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(p => new {
            id = p.Id,
            name = p.Name,
            species = p.Species.ToString(),
            location = p.Location,
            ageMonths = p.AgeMonths,
            imageUrl = string.IsNullOrEmpty(p.ImageUrl) ? "/images/default-pet.jpg" : p.ImageUrl,
            lat = p.Tutor != null && !string.IsNullOrEmpty(p.Tutor.GetLatitude()) ? p.Tutor.GetLatitude() : null,
            lng = p.Tutor != null && !string.IsNullOrEmpty(p.Tutor.GetLongitude()) ? p.Tutor.GetLongitude() : null
        })));

        // ========== DISTANCE CALCULATION FUNCTION ==========
        // Haversine formula - calculates real distance between two coordinates in kilometers
        function calculateDistance(lat1, lon1, lat2, lon2) {
            const R = 6371; // Earth's radius in kilometers
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLon = (lon2 - lon1) * Math.PI / 180;
            const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                      Math.sin(dLon/2) * Math.sin(dLon/2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
            return R * c; // Distance in kilometers
        }

        // Configuração do radius do mapa
        var radiusInKm = 25;
        
        var radiusInMeters = radiusInKm * 1000; // vonversão para metros
        
        var userLocation = null;
        var radiusCircle = null;
        var allMarkers = []; //localização dos pets (precisamos mexer nisso tmbm)
        

        function filterPetsByDistance(userLat, userLng, maxDistanceKm) {
            var visiblePets = [];
            var hiddenCount = 0;
            
            allMarkers.forEach(function(markerData) {
                var pet = markerData.pet;
                var petLat = parseFloat(pet.lat);
                var petLng = parseFloat(pet.lng);
                
                var distance = calculateDistance(userLat, userLng, petLat, petLng);
                
                if (distance <= maxDistanceKm) {
                    markerData.marker.addTo(map);
                    visiblePets.push({pet: pet, distance: distance});
                } else {
                    map.removeLayer(markerData.marker);
                    hiddenCount++;
                }
            });
            
            // Sort visible pets by distance (closest first)
            visiblePets.sort((a, b) => a.distance - b.distance);
            
            // Update popup content with distance info
            visiblePets.forEach(function(item) {
                var pet = item.pet;
                var distance = item.distance.toFixed(1);
                
                // Find the marker and update its popup
                var markerData = allMarkers.find(m => m.pet.id === pet.id);
                if (markerData) {
                    var newPopupContent = `
                        <div style="text-align: center; min-width: 170px;">
                            <img src="${pet.imageUrl}" style="width: 100%; height: 80px; object-fit: cover; border-radius: 8px; margin-bottom: 5px;">
                            <h6 style="margin: 0; font-weight: bold;">${pet.name}</h6>
                            <p style="margin: 0; font-size: 11px; color: gray;">${pet.species} • ${pet.location}</p>
                            <p style="margin: 5px 0; font-size: 10px; color: var(--petlink-map-accent);">
                                <i class="bi bi-geo-alt"></i> ${distance} km away
                            </p>
                            <a href="/AnimalListings/Details/${pet.id}" class="btn btn-sm btn-primary w-100 mt-1" style="font-size: 11px; border-radius: 20px;">View</a>
                        </div>`;
                    markerData.marker.bindPopup(newPopupContent);
                }
            });
            
            // Show summary
            console.log(`Showing ${visiblePets.length} pets within ${maxDistanceKm}km (${hiddenCount} hidden)`);
            return visiblePets;
        }

        var petsByLocation = {};

        var map = L.map('fullMap', { zoomControl: false }).setView([38.7223, -9.1393], 13);

        L.control.zoom({ position: 'bottomright' }).addTo(map);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap'
        }).addTo(map);

        var petIcon = L.icon({
            iconUrl: 'https://cdn-icons-png.flaticon.com/512/1076/1076928.png', 
            iconSize: [30, 30],
            iconAnchor: [15, 30],
            popupAnchor: [0, -30]
        });

         // Geocodifica um texto de localização via Nominatim (apenas usado como fallback)
        async function geocodeLocation(locationText) {
            try {
                const url = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(locationText)}&format=json&limit=1&countrycodes=pt`;
                const res = await fetch(url, {
                    headers: { 'Accept-Language': 'pt' }
                });
                const data = await res.json();
                if (data && data.length > 0) {
                    return { lat: parseFloat(data[0].lat), lng: parseFloat(data[0].lon) };
                }
            } catch (e) {
                console.warn('Geocoding failed for:', locationText, e);
            }
            return null;
        }


        function createMarkerForLocation(lat, lng, petsHere) {
            var marker = L.marker([lat, lng], { icon: petIcon });
            var popupContent = `<div style="text-align: center; min-width: 170px;">`;
            petsHere.forEach(function(pet) {
                popupContent += `
                    <div style="margin-bottom: 10px; text-align: left;">
                        <img src="${pet.imageUrl}" style="width: 100%; height: 80px; object-fit: cover; border-radius: 8px; margin-bottom: 5px;">
                        <h6 style="margin: 0; font-weight: bold;">${pet.name}</h6>
                        <p style="margin: 0; font-size: 11px; color: gray;">${pet.species} • ${pet.location}</p>
                        <a href="/AnimalListings/Details/${pet.id}" class="btn btn-sm btn-primary w-100 mt-1" style="font-size: 11px; border-radius: 20px;">View</a>
                    </div>`;
            });
            popupContent += `</div>`;
            marker.bindPopup(popupContent);
            petsHere.forEach(function(pet) {
                allMarkers.push({ marker: marker, pet: pet });
            });
        }


        async function initPetMarkers() {
            const geocodeCache = {};

            for (const pet of petsArray) {
                let lat = (pet.lat !== null && pet.lat !== undefined && pet.lat !== "") ? parseFloat(pet.lat) : null;
                let lng = (pet.lng !== null && pet.lng !== undefined && pet.lng !== "") ? parseFloat(pet.lng) : null;

                // Fallback: geocodificar a localização escrita no anúncio
                if (lat === null || lng === null || isNaN(lat) || isNaN(lng)) {
                    if (pet.location) {
                        if (!geocodeCache[pet.location]) {
                            // Nominatim: máx 1 pedido/segundo
                            await new Promise(resolve => setTimeout(resolve, 1100));
                            geocodeCache[pet.location] = await geocodeLocation(pet.location);
                        }
                        const coords = geocodeCache[pet.location];
                        if (coords) { lat = coords.lat; lng = coords.lng; }
                    }
                }

                // Sem coordenadas de todo: ignorar este animal
                if (lat === null || lng === null || isNaN(lat) || isNaN(lng)) continue;

                pet.lat = lat;
                pet.lng = lng;

                var key = lat + "_" + lng;
                if (!petsByLocation[key]) { petsByLocation[key] = []; }
                petsByLocation[key].push(pet);
            }

            // Criar marcadores após geocodificação completa
            Object.keys(petsByLocation).forEach(function(gpsKey) {
                var petsHere = petsByLocation[gpsKey];
                var parts = gpsKey.split('_');
                var lat = parseFloat(parts[0]);
                var lng = parseFloat(parts[1]);
                if (!isNaN(lat) && !isNaN(lng)) {
                    createMarkerForLocation(lat, lng, petsHere);
                }
            });
        }

        initPetMarkers();

        // juntar a geolocalização com o radius do range
        if (navigator.geolocation) {
            var loadingControl = L.control({ position: 'topright' });
            loadingControl.onAdd = function() {
                var div = L.DomUtil.create('div', 'info legend');
                div.innerHTML = '<div style="background: white; padding: 8px 15px; border-radius: 20px; box-shadow: 0 0 10px rgba(0,0,0,0.1);"><i class="bi bi-hourglass-split"></i> Getting your location...</div>';
                return div;
            };
            loadingControl.addTo(map);
            
            navigator.geolocation.getCurrentPosition(
                function (position) {
                    var userLat = position.coords.latitude;
                    var userLng = position.coords.longitude;
                    userLocation = { lat: userLat, lng: userLng };
                    
                    map.removeControl(loadingControl);
                    
                    var userMarker = L.marker([userLat, userLng], {
                        icon: L.divIcon({
                            className: 'user-location-marker',
                            html: '<div style="background: var(--petlink-map-accent); width: 16px; height: 16px; border-radius: 50%; border: 3px solid white; box-shadow: 0 0 0 2px var(--petlink-map-accent);"></div>',
                            iconSize: [22, 22],
                            iconAnchor: [11, 11]
                        })
                    }).addTo(map).bindPopup("<b>You are here!</b><br>Showing pets within " + radiusInKm + " km");
                    
                    // círculo do radius com distâancia real
                    radiusCircle = L.circle([userLat, userLng], {
                        radius: radiusInMeters,
                        color: "var(--petlink-map-accent)",
                        fillColor: "var(--petlink-map-accent)",
                        weight: 2,
                        opacity: 0.6,
                        fillOpacity: 0.1
                    }).addTo(map);
                    
                    
                    var visiblePets = filterPetsByDistance(userLat, userLng, radiusInKm);
                    
                    // criar grupos pros pontinhos no mapa
                    var visibleMarkers = [userMarker];
                    allMarkers.forEach(function(markerData) {
                        if (map.hasLayer(markerData.marker)) {
                            visibleMarkers.push(markerData.marker);
                        }
                    });
                    
                    if (visibleMarkers.length > 0) {
                        var bounds = L.featureGroup(visibleMarkers).getBounds();
                        map.fitBounds(bounds.pad(0.1), { maxZoom: 13 });
                    } else {
                        map.setView([userLat, userLng], 12);

                        var noPetsControl = L.control({ position: 'bottomleft' });
                        noPetsControl.onAdd = function() {
                            var div = L.DomUtil.create('div', 'info legend');
                            div.innerHTML = '<div style="background: white; padding: 10px 20px; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.1);"><i class="bi bi-info-circle"></i> No pets found within ' + radiusInKm + ' km of your location</div>';
                            return div;
                        };

                        noPetsControl.addTo(map);
                        setTimeout(() => map.removeControl(noPetsControl), 5000);
                    }
                    
                    // filtro do range em si
                    var radiusControl = L.control({ position: 'topright' });
                    radiusControl.onAdd = function() {
                        var div = L.DomUtil.create('div', 'info legend');
                        div.innerHTML = `
                            <div style="background: white; padding: 10px 15px; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.1); min-width: 180px;">
                                <label style="font-size: 12px; font-weight: bold;">Filter radius: <span id="radiusValue">${radiusInKm}</span> km</label>
                                <input type="range" id="radiusSlider" min="1" max="80" step="1" value="${radiusInKm}" style="width: 100%; margin-top: 5px;">
                                <div style="font-size: 10px; color: gray; margin-top: 5px;">
                                    <i class="bi bi-info-circle"></i> Showing pets within radius
                                </div>
                            </div>
                        `;
                        return div;
                    };
                    radiusControl.addTo(map);
                    
                    //slider
                    setTimeout(function() {
                        var slider = document.getElementById('radiusSlider');
                        var radiusValue = document.getElementById('radiusValue');
                        if (slider) {
                            slider.addEventListener('input', function(e) {
                                var newRadiusKm = parseFloat(e.target.value);
                                radiusValue.innerText = newRadiusKm;
                                
                                if (radiusCircle) {
                                    map.removeLayer(radiusCircle);
                                }
                                radiusCircle = L.circle([userLat, userLng], {
                                    radius: newRadiusKm * 1000,
                                    color: "var(--petlink-map-accent)",
                                    fillColor: "var(--petlink-map-accent)",
                                    weight: 2,
                                    opacity: 0.6,
                                    fillOpacity: 0.1
                                }).addTo(map);
                                
                                filterPetsByDistance(userLat, userLng, newRadiusKm);
                            });
                        }
                    }, 100);
                    
                },
                async function (error) {
                    console.warn("Location access unavailable: " + error.message);
                    map.removeControl(loadingControl);

                    // Tentar geocodificar a cidade da barra de pesquisa, senão usar centro de Portugal
                    var searchCity = "@(ViewBag.CurrentLocation ?? "")".trim();
                    var fallbackLat = 39.6945;
                    var fallbackLng = -8.1302;

                    if (searchCity !== "") {
                        var coords = await geocodeLocation(searchCity);
                        if (coords) {
                            fallbackLat = coords.lat;
                            fallbackLng = coords.lng;
                        }
                    }

                    userLocation = { lat: fallbackLat, lng: fallbackLng };

                    // Marcador da localização estimada
                    L.marker([fallbackLat, fallbackLng], {
                        icon: L.divIcon({
                            className: 'user-location-marker',
                            html: '<div style="background: #aaa; width: 16px; height: 16px; border-radius: 50%; border: 3px solid white; box-shadow: 0 0 0 2px #aaa;"></div>',
                            iconSize: [22, 22],
                            iconAnchor: [11, 11]
                        })
                    }).addTo(map).bindPopup(searchCity !== "" ? "<b>📍 " + searchCity + "</b><br>Estimated location" : "<b>📍 Portugal</b><br>Enable location for better results");

                    // Círculo do radius à volta da localização estimada
                    radiusCircle = L.circle([fallbackLat, fallbackLng], {
                        radius: radiusInKm * 1000,
                        color: "#aaa",
                        fillColor: "#aaa",
                        weight: 2,
                        opacity: 0.5,
                        fillOpacity: 0.08
                    }).addTo(map);

                    // Aplicar filtro de distância com a localização estimada
                    filterPetsByDistance(fallbackLat, fallbackLng, radiusInKm);

                    // Slider de radius
                    var radiusControl = L.control({ position: 'topright' });
                    radiusControl.onAdd = function() {
                        var div = L.DomUtil.create('div', 'info legend');
                        div.innerHTML = `
                            <div style="background: white; padding: 10px 15px; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.1); min-width: 180px;">
                                <label style="font-size: 12px; font-weight: bold;">Filter radius: <span id="radiusValue">${radiusInKm}</span> km</label>
                                <input type="range" id="radiusSlider" min="1" max="80" step="1" value="${radiusInKm}" style="width: 100%; margin-top: 5px;">
                                <div style="font-size: 10px; color: gray; margin-top: 5px;">
                                    <i class="bi bi-exclamation-circle"></i> Location estimated${searchCity !== "" ? " (" + searchCity + ")" : " (Portugal)"}
                                </div>
                            </div>
                        `;
                        return div;
                    };
                    radiusControl.addTo(map);

                    setTimeout(function() {
                        var slider = document.getElementById('radiusSlider');
                        var radiusValueEl = document.getElementById('radiusValue');
                        if (slider) {
                            slider.addEventListener('input', function(e) {
                                var newRadiusKm = parseFloat(e.target.value);
                                radiusValueEl.innerText = newRadiusKm;
                                if (radiusCircle) map.removeLayer(radiusCircle);
                                radiusCircle = L.circle([fallbackLat, fallbackLng], {
                                    radius: newRadiusKm * 1000,
                                    color: "#aaa",
                                    fillColor: "#aaa",
                                    weight: 2,
                                    opacity: 0.5,
                                    fillOpacity: 0.08
                                }).addTo(map);
                                filterPetsByDistance(fallbackLat, fallbackLng, newRadiusKm);
                            });
                        }
                    }, 100);

                    map.setView([fallbackLat, fallbackLng], 10);
                },
                {
                    enableHighAccuracy: true,
                    timeout: 10000,
                    maximumAge: 0
                }
            );
        }

    </script>
}