@model IEnumerable<PetLink.Models.AnimalListing>

@{
    ViewData["Title"] = "Manage Listings";
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-3 mb-4">
            @await Html.PartialAsync("~/Views/Shared/UserSideBar.cshtml")
        </div>

        <div class="col-lg-9">
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-primary-blue fw-bold mb-0">
                    <i class="bi bi-postcard-fill me-2"></i> Manage Listings
                </h2>
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                    <i class="bi bi-plus-lg me-2"></i> New Listing
                </a>
            </div>

            @* Card com fundo dinâmico *@
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden"
                 style="background-color: var(--petlink-card-bg);">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="color: var(--petlink-dark);">
                        <thead style="background-color: var(--petlink-grey-bg); color: var(--petlink-dark);">
                            <tr style="border-bottom: 1px solid var(--petlink-border);">
                                <th class="ps-4 py-3 small text-uppercase opacity-75">Pet Name</th>
                                <th class="py-3 small text-uppercase opacity-75">Species</th>
                                <th class="py-3 small text-uppercase opacity-75">Health</th>
                                <th class="py-3 small text-uppercase opacity-75">Status</th>
                                <th class="py-3 small text-uppercase opacity-75">Added On</th>
                                <th class="py-3 small text-uppercase opacity-75">Tutor / Shelter</th>
                                <th class="text-end pe-4 py-3 small text-uppercase opacity-75">Actions</th>
                            </tr>
                        </thead>
                        
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr onclick="window.location.href='@Url.Action("Details", new { id = item.Id })';"
                                    style="cursor: pointer; border-bottom: 1px solid var(--petlink-border);">
                                    
                                    <td class="ps-4 fw-bold">
                                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/default-pet.jpg" : item.ImageUrl)"
                                             alt="Pet" class="rounded-circle me-2 shadow-sm"
                                             style="width: 35px; height: 35px; object-fit: cover; border: 1px solid var(--petlink-border);"
                                             onerror="this.src='/images/default-pet.jpg'" />
                                        @item.Name
                                    </td>
                                    
                                    <td>
                                        @* Badge de espécie com fundo dinâmico *@
                                        <span class="badge rounded-pill px-3 fw-bold"
                                              style="background-color: var(--petlink-light-bg); color: var(--petlink-primary); border: 1px solid var(--petlink-border);">
                                            @item.Species
                                        </span>
                                    </td>
                                    
                                    <td>
                                        <div class="d-flex gap-1">
                                            @if (item.IsVaccinated)
                                            {
                                                <i class="bi bi-capsule text-success"
                                                   title="Vaccinated"></i>
                                            }
                                            @if (item.IsDewormed)
                                            {
                                                <i class="bi bi-bug-fill text-success"
                                                   title="Dewormed"></i>
                                            }
                                            @if (item.IsSterilized)
                                            {
                                                <i class="bi bi-scissors text-success"
                                                   title="Sterilized"></i>
                                            }
                                            @if (!item.IsVaccinated && !item.IsDewormed && !item.IsSterilized)
                                            {
                                                <span class="opacity-50 small" style="font-size: 0.7rem;">None</span>
                                            }
                                        </div>
                                    </td>
                                    
                                    <td>
                                        @if (item.Status.ToString() == "Published")
                                        {
                                            <span class="badge rounded-pill px-3 border fw-bold"
                                                  style="background-color: rgba(40, 167, 69, 0.1); color: #28a745; border-color: rgba(40, 167, 69, 0.2) !important;">
                                                <i class="bi bi-check-circle me-1"></i> @item.Status
                                            </span>
                                        }
                                        else if (item.Status.ToString() == "Pendent")
                                        {
                                            <span class="badge rounded-pill px-3 border fw-bold"
                                                  style="background-color: rgba(255, 193, 7, 0.1); color: #ffc107; border-color: rgba(255, 193, 7, 0.2) !important;">
                                                <i class="bi bi-hourglass-split me-1"></i> @item.Status
                                            </span>
                                        }
                                    </td>
                                    
                                    <td class="small opacity-75">
                                        @item.CreatedAt.ToString("dd MMM yyyy")
                                    </td>

                                    <td class="small opacity-75">
                                        @(item.Tutor != null ? (string.IsNullOrEmpty(item.Tutor.Name) ? item.Tutor.Email :
                                    item.Tutor.Name) : "Unknown")
                                    </td>
                                    
                                    <td class="text-end pe-4">
                                        <div class="btn-group shadow-sm rounded-pill overflow-hidden"
                                             style="border: 1px solid var(--petlink-border);">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm py-1 px-3"
                                                   style="background-color: var(--petlink-card-bg); color: var(--petlink-primary);"
                                                   onclick="event.stopPropagation();">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm py-1 px-3"
                                                   style="background-color: var(--petlink-card-bg); color: #dc3545;"
                                                   onclick="event.stopPropagation();">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (!Model.Any())
            {
                <div class="alert mt-4 rounded-4 border-0 shadow-sm" role="alert"
                     style="background-color: var(--petlink-light-bg); color: var(--petlink-primary);">
                    <i class="bi bi-info-circle me-2"></i> No animal listings found in the database.
                </div>
            }
        </div>
    </div>
</div>