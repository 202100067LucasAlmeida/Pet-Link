@model IEnumerable<PetLink.Models.AnimalListing>

@{
    ViewData["Title"] = "Manage Listings";
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-3 mb-4">
            @await Html.PartialAsync("~/Views/Shared/UserSideBar.cshtml")
        </div>

        <div class="col-lg-9">
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-primary-blue fw-bold mb-0">
                    <i class="bi bi-card-checklist me-2"></i> Manage Listings
                </h2>
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                    <i class="bi bi-plus-lg me-2"></i> New Listing
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-4">Pet Name</th>
                                <th>Species</th>
                                <th>Health Info</th>
                                <th>Status</th>
                                <th>Added On</th>
                                <th>Tutor / Shelter</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr onclick="window.location.href='@Url.Action("Details", new { id = item.Id })';"
                                    style="cursor: pointer;">
                                    
                                    <td class="ps-4 fw-bold text-dark">
                                        @* Lógica de imagem atualizada: usa MainImageUrl e fallback para default-pet *@
                                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/default-pet.jpg" : item.ImageUrl)"
                                             alt="Pet" class="rounded-circle me-2 object-fit-cover shadow-sm"
                                             style="width: 35px; height: 35px;"
                                             onerror="this.src='/images/default-pet.jpg'" />
                                        @item.Name
                                    </td>
                                    
                                    <td>
                                        <span class="badge bg-light text-dark border rounded-pill fw-semibold px-3">
                                            @item.Species
                                        </span>
                                    </td>
                                    
                                    <td>
                                        @if (item.IsVaccinated)
                                        {
                                            <i class="bi bi-capsule text-success me-1" title="Vaccinated"></i>
                                        }
                                        @if (item.IsDewormed)
                                        {
                                            <i class="bi bi-bug-fill text-success me-1" title="Dewormed"></i>
                                        }
                                        @if (item.IsSterilized)
                                        {
                                            <i class="bi bi-scissors text-success" title="Sterilized"></i>
                                        }
                                        @if (!item.IsVaccinated && !item.IsDewormed && !item.IsSterilized)
                                        {
                                            <span class="text-muted small" style="font-size: 0.7rem;">No records</span>
                                        }
                                    </td>
                                    
                                    <td>
                                        @* Verificação de Status corrigida para bater com o Enum (Published / Pendent) *@
                                        @if (item.Status.ToString() == "Published")
                                        {
                                            <span
                                                class="badge bg-success bg-opacity-10 text-success rounded-pill fw-bold px-3 border border-success border-opacity-25">
                                                <i class="bi bi-check-circle me-1"></i> @item.Status
                                            </span>
                                        }
                                        else if (item.Status.ToString() == "Pendent")
                                        {
                                            <span
                                                class="badge bg-warning bg-opacity-10 text-warning rounded-pill fw-bold px-3 border border-warning border-opacity-25">
                                                <i class="bi bi-hourglass-split me-1"></i> @item.Status
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill fw-normal px-3">@item.Status</span>
                                        }
                                    </td>
                                    
                                    <td class="text-muted small">
                                        @item.CreatedAt.ToString("dd MMM yyyy")
                                    </td>

                                    <td class="text-muted small">
                                        @* Mostra o nome do Tutor se disponível, caso contrário o email *@
                                        @(item.Tutor != null ? (string.IsNullOrEmpty(item.Tutor.Name) ? item.Tutor.Email :
                                    item.Tutor.Name) : "Unknown")
                                    </td>
                                    
                                    <td class="text-end pe-4">
                                        <div class="btn-group shadow-sm rounded-pill" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-outline-primary py-1 px-3" title="Edit"
                                                   onclick="event.stopPropagation();">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            
                                            <a asp-action="Delete" asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-outline-danger py-1 px-3" title="Delete"
                                                   onclick="event.stopPropagation();">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info mt-4 rounded-4 border-0 shadow-sm" role="alert">
                    <i class="bi bi-info-circle me-2"></i> No animal listings found in the database.
                </div>
            }
        </div>
    </div>
</div>