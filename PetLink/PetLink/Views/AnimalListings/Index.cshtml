@model IEnumerable<PetLink.Models.AnimalListing>

@{
    ViewData["Title"] = "Adopt a Pet";
}

<div class="container my-5">
    @* Cabeçalho e Botão de Criar Novo *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary-blue fw-bold">
            <i class="bi bi-house-heart-fill me-2"></i> Animal Listings
        </h2>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
            <i class="bi bi-plus-lg me-2"></i> Create New
        </a>
    </div>

    @* Card que envolve a tabela *@
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4">Name</th>
                        <th>Species</th>
                        <th>Location</th>
                        <th>Age (Mo.)</th>
                        <th>Health Info</th>
                        <th>Status</th>
                        <th>Date Added</th>
                        <th>Tutor</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            @* Nome *@
                            <td class="ps-4 fw-bold text-dark">
                                @item.Name
                            </td>
                            
                            @* Espécie com Badge *@
                            <td>
                                <span class="badge bg-info text-dark rounded-pill fw-normal px-3">
                                    @item.Species
                                </span>
                            </td>
                            
                            @* Localização *@
                            <td class="text-muted small">
                                <i class="bi bi-geo-alt me-1"></i>@item.Location
                            </td>
                            
                            @* Idade *@
                            <td>
                                @item.AgeMonths <span class="text-muted small">mo.</span>
                            </td>
                            
                            @* Informação de Saúde (Agrupada com ícones em vez de texto) *@
                            <td>
                                @if(item.IsVaccinated) { <i class="bi bi-capsule text-success me-1" title="Vaccinated"></i> }
                                @if(item.IsDewormed)   { <i class="bi bi-bug-fill text-success me-1" title="Dewormed"></i> }
                                @if(item.IsSterilized) { <i class="bi bi-scissors text-success" title="Sterilized"></i> }
                            </td>
                            
                            @* Estado do Anúncio *@
                            <td>
                                @if(item.Status.ToString() == "Publicado")
                                {
                                    <span class="badge bg-success rounded-pill fw-normal">@item.Status</span>
                                }
                                else if (item.Status.ToString() == "Pendente")
                                {
                                    <span class="badge bg-warning text-dark rounded-pill fw-normal">@item.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill fw-normal">@item.Status</span>
                                }
                            </td>
                            
                            @* Data (Formatada para ser curta) *@
                            <td class="text-muted small">
                                @item.CreatedAt.ToString("dd MMM yyyy")
                            </td>

                            @* Email do Tutor *@
                            <td class="text-muted small">
                                @(item.Tutor != null ? item.Tutor.Email : "N/A")
                            </td>
                            
                            @* Botões de Ação Redondos *@
                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm rounded-pill" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary py-1 px-2" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info py-1 px-2" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger py-1 px-2" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* Estado Vazio (Caso não haja animais) *@
    @if (!Model.Any())
    {
        <div class="alert alert-info mt-4 rounded-4" role="alert">
            <i class="bi bi-info-circle me-2"></i> There are currently no animals listed for adoption.
        </div>
    }
</div>