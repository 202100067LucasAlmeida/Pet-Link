@using PetLink.Models.Enums
@model IEnumerable<PetLink.Models.AnimalListing>
@using HashidsNet
@inject IHashids Hashids

@{
    ViewData["Title"] = "Find Your New Best Friend";

    @* var currentUserIdStr = User.FindFirst("UserId")?.Value;
    bool isOwner = currentUserIdStr != null && currentUserIdStr == Model.TutorId.ToString(); *@

    // Helper function to get display name for species
    string GetSpeciesDisplayName(Species species)
    {
        return species switch
        {
            Species.Dog => "Dogs",
            Species.Cat => "Cats",
            Species.Bird => "Birds",
            Species.Other => "Others",
            _ => species.ToString()
        };
    }

    // Helper function to get display name for age
    string GetAgeDisplayName(Age age)
    {
        return age switch
        {
            Age.Puppy => "Puppy (0-1 yr)",
            Age.Adult => "Adult (1-7 yrs)",
            Age.Senior => "Senior (7+ yrs)",
            _ => age.ToString()
        };
    }
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-3 mb-4 mb-lg-0">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold text-primary-darkblue mb-0">Filters</h4>
                <a asp-controller="AnimalListings" asp-action="Index"
                   class="text-decoration-none small fw-semibold text-muted">Reset All</a>
            </div>

            <div class="card filter-card rounded-4 shadow-sm p-4">
                <form method="get" asp-action="Search" asp-controller="AnimalListings" id="filterForm">
                    <!--ANIMAL TYPE-->
                    <div class="mb-4">
                        <div class="filter-section-title"><i class="bi bi-bag me-2"></i> ANIMAL TYPE</div>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="radio" name="species" value="@Species.Dog" id="dog"
                                @(ViewBag.CurrentSpecies != null && ViewBag.CurrentSpecies.ToString() ==
                                                                    Species.Dog.ToString() ? "checked" : "") hidden>
                                <label for="dog" class="btn animal-type-btn w-100 rounded-3">
                                    <i class="bi bi-list-task me-1"></i>Dogs
                                </label>
                            </div>
                            <div class="col-6">
                                <input type="radio" name="species" value="@Species.Cat" id="cat"
                                @(ViewBag.CurrentSpecies != null && ViewBag.CurrentSpecies.ToString() ==
                                                                    Species.Cat.ToString() ? "checked" : "") hidden>
                                <label for="cat" class="btn animal-type-btn w-100 rounded-3">
                                    <i class="bi bi-list-task me-1"></i>Cats
                                </label>
                            </div>
                            <div class="col-6">
                                <input type="radio" name="species" value="@Species.Bird" id="bird"
                                @(ViewBag.CurrentSpecies != null && ViewBag.CurrentSpecies.ToString() ==
                                                                    Species.Bird.ToString() ? "checked" : "") hidden>
                                <label for="bird" class="btn animal-type-btn w-100 rounded-3">
                                    <i class="bi bi-list-task me-1"></i>Birds
                                </label>
                            </div>
                            <div class="col-6">
                                <input type="radio" name="species" value="@Species.Other" id="other"
                                @(ViewBag.CurrentSpecies != null && ViewBag.CurrentSpecies.ToString() ==
                                                                    Species.Other.ToString() ? "checked" : "") hidden>
                                <label for="other" class="btn animal-type-btn w-100 rounded-3">
                                    <i class="bi bi-list-task me-1"></i>Others
                                </label>
                            </div>
                        </div>
                    </div>

                    <!--BREED-->
                    <div class="mb-4">
                        <div class="filter-section-title"><i class="bi bi-tag me-2"></i> BREED</div>
                        <p style="color: red; font-size:x-small;">'BREED' filter is not available at this moment</p>
                        <select class="form-select rounded-3 py-2 text-muted fw-semibold fs-6">
                            <option>All Breeds</option>
                        </select>
                    </div>

                    <!--AGE-->
                    <div class="mb-4">
                        <div class="filter-section-title"><i class="bi bi-clock me-2"></i> AGE RANGE</div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="age" value="@Age.Puppy" id="agePuppy"
                            @(ViewBag.CurrentAge != null && ViewBag.CurrentAge.ToString() == Age.Puppy.ToString() ?
                                                                           "checked" : "")>
                            <label class="form-check-label text-muted small fw-semibold" for="agePuppy">Puppy (0-1
                                yr)
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="age" value="@Age.Adult" id="ageAdult"
                            @(ViewBag.CurrentAge != null && ViewBag.CurrentAge.ToString() == Age.Adult.ToString() ?
                                                                     "checked" : "")>
                            <label class="form-check-label text-muted small fw-semibold" for="ageAdult">Adult (1-7
                                yrs)
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="age" value="@Age.Senior" id="ageSenior"
                            @(ViewBag.CurrentAge != null && ViewBag.CurrentAge.ToString() == Age.Senior.ToString() ?
                                                                       "checked" : "")>
                            <label class="form-check-label text-muted small fw-semibold" for="ageSenior">Senior (7+
                                yrs)
                            </label>
                        </div>
                    </div>

                    <!--LOCATION-->
                    <div class="mb-4">
                        <div class="filter-section-title"><i class="bi bi-geo-alt me-2"></i> LOCATION</div>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted border-end-0"><i
                                class="bi bi-geo-alt"></i>
                            </span>
                            <input type="text" name="location" class="form-control border-start-0 ps-0"
                                   placeholder="Zip code or city" value="@ViewBag.CurrentLocation">
                        </div>
                    </div>

                    <!--RANGE-->
                    <div class="mb-5">
                        <div class="filter-section-title"><i class="bi bi-sliders me-2"></i> RANGE</div>
                        <input type="range" name="range" class="form-range" min="0" max="500" id="rangeInput"
                               value="@(ViewBag.CurrentRange ?? "0")">
                        <div class="d-flex justify-content-between text-muted small mt-1">
                            <span>0km</span>
                            <span class="current-range-filter" id="rangeValue">@(ViewBag.CurrentRange ?? "0") km</span>
                            <span>500km</span>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2 rounded-3">Apply Filters</button>
                </form>
            </div>
        </div>

        <!--BADGES/TAGS ATIVAS-->
        <div class="col-lg-9">
            <div class="mb-4">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb small mb-2">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Search Pets</li>
                    </ol>
                </nav>

                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-3">
                    <div>
                        <h1 class="display-6 fw-bold mb-1 text-primary-darkblue">Find Your New Best Friend</h1>
                        <p class="text-muted mb-0">Showing @Model.Count() adoptable pets near your location</p>
                    </div>
                    
                    <form method="get" asp-action="Search" class="mt-3 mt-md-0 d-flex align-items-center">
                        <input type="hidden" name="species" value="@Context.Request.Query["species"]" />
                        <input type="hidden" name="age" value="@Context.Request.Query["age"]" />
                        <input type="hidden" name="location" value="@Context.Request.Query["location"]" />

                        <span class="text-muted small me-2">Sort by:</span>

                        <select name="sort"
                                class="form-select form-select-sm rounded-3 border-0 shadow-sm fw-semibold text-dark"
                                style="width: 150px;" onchange="this.form.submit()">

                            <option value="newest" selected="@(Context.Request.Query["sort"] == "newest")">New Arrivals
                            </option>
                            <option value="oldest" selected="@(Context.Request.Query["sort"] == "oldest")">Oldest
                            </option>
                        </select>
                    </form>
                </div>

                <!-- Active Filters Display -->
                @if (ViewBag.ActiveFilters != null && ViewBag.ActiveFilters.Count > 0)
                {
                    <div class="d-flex gap-2 flex-wrap mb-4">
                        @foreach (var filter in ViewBag.ActiveFilters)
                        {
                            string filterDisplayName = filter.Key switch
                            {
                                "Species" => GetSpeciesDisplayName((Species)filter.Value),
                                "Age" => GetAgeDisplayName((Age)filter.Value),
                                "Location" => filter.Value.ToString(),
                                "Range" => $"Within {filter.Value} km",
                                _ => filter.Value.ToString()
                            };

                            <span
                                class="badge rounded-pill bg-primary bg-opacity-10 text-primary py-2 px-3 fw-semibold border border-primary border-opacity-25">
                                @filterDisplayName
                                <i class="bi bi-x ms-1 cursor-pointer" data-filter-key="@filter.Key"
                                   data-filter-value="@filter.Value" onclick="removeFilter(this)"></i>
                            </span>
                        }
                    </div>
                }
                else
                {
                    <div class="d-flex gap-2 flex-wrap mb-4">
                        <span class="text-muted small">No active filters</span>
                    </div>
                }

                <div class="row g-4 mb-5">
                    @foreach (var item in Model)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div
                                class="card pet-card border-0 shadow-sm rounded-4 overflow-hidden h-100 d-flex flex-column">
                                <div class="pet-card-img-wrapper position-relative">
                                    @{
                                        var imageName = item.Name.ToLower() + ".jpg";
                                        var imagePath = "/images/" + imageName;
                                        var imageFullPath = System.IO.Path.Combine(Directory.GetCurrentDirectory(), "wwwroot",
  "images", imageName);
                                        var imageExists = System.IO.File.Exists(imageFullPath);
                                    }

                                    <a asp-action="Details" asp-route-id="@Hashids.Encode(item.Id)">
                                        @if (imageExists)
                                        {
                                            <img src="@imagePath" alt="@item.Name's photo" class="w-100"
                                                 style="height: 200px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center w-100"
                                                 style="height: 200px;">
                                                <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                                            </div>
                                        }
                                    </a>

                                    @if (User.IsInRole("User") || User.IsInRole("PetSitter"))
                                    {
                                        <button class="btn-heart favorite-toggle position-absolute top-0 end-0 m-2"
                                                data-pet-id="@item.Id">
                                            <i class="bi bi-heart"></i>
                                        </button>
                                    }

                                    @if (item.Status.ToString() == "Publicado")
                                    {
                                        <span class="badge-adoptable position-absolute bottom-0 start-0 m-3">ADOPTABLE</span>
                                    }
                                </div>

                                <div class="card-body p-3 d-flex flex-column flex-grow-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                                        <h4 class="h5 fw-bold mb-0 text-primary-darkblue">@item.Name</h4>
                                    </a>
                                    <p class="text-muted small mb-1">
                                        <i class="bi bi-geo-alt"></i> @item.Location
                                    </p>
                                    <p class="text-muted small mb-3">@item.Species • @item.AgeMonths mo.</p>

                                    <div class="d-flex flex-wrap gap-2 mt-auto">
                                        @if (item.IsVaccinated)
                                        {
                                            <span class="pet-tag pet-tag-green">VACCINATED</span>
                                        }
                                        @if (item.IsSterilized)
                                        {
                                            <span class="pet-tag pet-tag-green">STERILIZED</span>
                                        }
                                        @if (!item.IsVaccinated && !item.IsSterilized)
                                        {
                                            <span class="pet-tag">NEEDS VET</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (!Model.Any())
                    {
                        <div class="col-12 text-center py-5">
                            <i class="bi bi-search fs-1 text-muted mb-3 d-block"></i>
                            <h5 class="fw-bold">No pets found matching your criteria.</h5>
                            <p class="text-muted">Try adjusting your filters or search location.</p>
                        </div>
                    }
                </div>

                @if (Model.Any())
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            <li class="page-item disabled">
                                <a class="page-link border-0 shadow-sm rounded-3 me-2 text-muted" href="#"><i
                                    class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            <li class="page-item active">
                                <a class="page-link border-0 shadow-sm rounded-3 me-2"
                                       style="background-color: var(--petlink-dark);" href="#">1
                                </a>
                            </li>
                            <li class="page-item">
                                <a class="page-link border-0 shadow-sm rounded-3 me-2 text-dark" href="#">2
                                </a>
                            </li>
                            <li class="page-item">
                                <a class="page-link border-0 shadow-sm rounded-3 me-2 text-dark" href="#">3
                                </a>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-link border-0 bg-transparent text-muted">...
                                </span>
                            </li>
                            <li class="page-item">
                                <a class="page-link border-0 shadow-sm rounded-3 me-2 text-dark" href="#">12
                                </a>
                            </li>
                            <li class="page-item">
                                <a class="page-link border-0 shadow-sm rounded-3 text-dark" href="#"><i
                                    class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>

<script src="~/js/animalListings.js" asp-append-version="true"></script>


@section Scripts {
    <script>
        $(document).ready(function () {
            console.log("Index carregado - a inicializar favoritos");

            // Verifica estado inicial de cada coração
            $('.btn-heart').each(function () {
                var button = $(this);
                var petId = button.data('pet-id');
                var icon = button.find('i');

                $.ajax({
                    url: '@Url.Action("Check", "Favorites")',
                    type: 'GET',
                    data: { animalListingId: petId },
                    success: function (isFavorited) {
                        if (isFavorited) {
                            icon.removeClass('bi-heart').addClass('bi-heart-fill text-danger');
                            button.addClass('active');
                        }
                    }
                });
            });

            // Handler para cliques nos corações
            $(document).on('click', '.btn-heart', function (e) {
                e.preventDefault();
                e.stopPropagation();

                var button = $(this);
                var petId = button.data('pet-id');
                var icon = button.find('i');

                console.log("Coração clicado! Pet ID:", petId);

                $.ajax({
                    url: '@Url.Action("Toggle", "Favorites")',
                    type: 'POST',
                    data: { animalListingId: petId },
                    success: function (response) {
                        console.log("Resposta:", response);
                        if (response.success) {
                            if (response.isFavorited) {
                                icon.removeClass('bi-heart').addClass('bi-heart-fill text-danger');
                                button.addClass('active');
                                showNotification('Added to favorites!');
                            } else {
                                icon.removeClass('bi-heart-fill text-danger').addClass('bi-heart');
                                button.removeClass('active');
                                showNotification('Removed from favorites!');
                            }
                        }
                    },
                    error: function (xhr, status, error) {
                        console.log("Erro:", error);
                        showNotification('Error updating favorite', 'error');
                    }
                });
            });

            function showNotification(message, type = 'success') {
                // Remove notificações anteriores
                $('.toast-notification').remove();

                var toast = $(`<div class="toast-notification">${message}</div>`);
                $('body').append(toast);
                setTimeout(() => toast.fadeOut(300, function () { $(this).remove(); }), 2000);
            }
        });
    </script>

}