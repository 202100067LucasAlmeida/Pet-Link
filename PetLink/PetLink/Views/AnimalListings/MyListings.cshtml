@model IEnumerable<PetLink.Models.AnimalListing>

@{
    ViewData["Title"] = "My Listings";
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-3 mb-4">
            @await Html.PartialAsync("~/Views/Shared/UserSideBar.cshtml")
        </div>

        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-primary-blue fw-bold mb-0">
                    <i class="bi bi-grid-fill me-2"></i> My Animal Listings
                </h2>
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                    <i class="bi bi-plus-lg me-2"></i> Post New Pet
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-4">Pet</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr onclick="window.location.href='@Url.Action("Details", new { id = item.Id })';" style="cursor: pointer;">
                                    <td class="ps-4 fw-bold text-dark">
                                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/default-pet.jpg" : item.ImageUrl)" 
                                             class="rounded-circle me-2 object-fit-cover shadow-sm" style="width: 35px; height: 35px;">
                                        @item.Name
                                    </td>
                                    <td>
                                        @if (item.Status.ToString() == "Published") {
                                            <span class="badge bg-success rounded-pill px-3">Published</span>
                                        } else {
                                            <span class="badge bg-warning text-dark rounded-pill px-3">Pending</span>
                                        }
                                    </td>
                                    <td class="text-muted small">@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group shadow-sm rounded-pill">
                                            <a asp-action="Edit" asp-route-id="@item.Id" 
                                               class="btn btn-sm btn-outline-primary py-1 px-3" onclick="event.stopPropagation();">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" 
                                               class="btn btn-sm btn-outline-danger py-1 px-3" onclick="event.stopPropagation();">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (!Model.Any()) {
                <div class="text-center py-5">
                    <i class="bi bi-patch-question fs-1 text-muted"></i>
                    <p class="mt-3 text-muted">You haven't posted any animals yet.</p>
                </div>
            }
        </div>
    </div>
</div>