@model PetLink.Models.AnimalListing

@{
    ViewData["Title"] = "Create Listing";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-primary-blue fw-bold mb-0">
                    <i class="bi bi-plus-circle-fill me-2"></i> Create Animal Listing
                </h2>
                <a asp-action="MyListings" class="btn btn-outline-secondary rounded-pill btn-sm fw-bold">
                    <i class="bi bi-arrow-left me-1"></i> Back to My Listings
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    @* IMPORTANTE: Adicionado enctype para permitir upload de ficheiros *@
                    <form asp-action="Create" method="post" enctype="multipart/form-data" id="createListingForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-semibold small"></div>

                        <!-- Warning Banner that appears when validation fails -->
                        <div id="validationWarning" class="alert alert-warning alert-dismissible fade show" role="alert" style="display: none;">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>Please complete all required fields:</strong>
                            <ul id="warningList" class="mb-0 mt-2">
                                <li id="warnAge">Age is required</li>
                                <li id="warnPhoto">Main photo is required</li>
                                <li id="warnHealth">At least one health information must be selected</li>
                            </ul>
                        </div>

                        <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">Basic Information</h5>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label fw-semibold">
                                    Animal Name
                                </label>
                                <input asp-for="Name" class="form-control py-2" placeholder="Ex: Max" required />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Species" class="form-label fw-semibold">
                                    Species
                                </label>
                                <select asp-for="Species" class="form-select py-2" required
                                        asp-items="Html.GetEnumSelectList<PetLink.Models.Enums.Species>()">
                                    <option value="">Select a species</option>
                                </select>
                                <span asp-validation-for="Species" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="AgeMonths" class="form-label fw-semibold">
                                    Age (in months) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <input asp-for="AgeMonths" class="form-control py-2"
                                           placeholder="Ex: 12" type="number" min="0" step="1" required />
                                    <span class="input-group-text">months</span>
                                </div>
                                <span asp-validation-for="AgeMonths" class="text-danger small"></span>
                                <div id="ageError" class="invalid-feedback">Please enter a valid age (0 or greater)</div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Location" class="form-label fw-semibold">
                                    Location 
                                </label>
                                <input asp-for="Location" class="form-control py-2" placeholder="Ex: Lisbon" required />
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold">
                                Description
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="3" required
                                      placeholder="Tell us about the pet..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        @* SECÇÃO DE FOTOS *@
                        <h5 class="fw-bold text-dark mb-3 border-bottom pb-2 mt-4">
                            Photos <span class="text-danger">*</span>
                        </h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">
                                    Main Photo (Card Display)<span class="text-danger">*</span>
                                </label>
                                <div class="border rounded-3 p-3 text-center bg-light" id="mainPhotoArea">
                                    <i class="bi bi-image fs-1 text-secondary"></i>
                                    <div class="mt-2">
                                        <input type="file" name="mainPhoto" class="d-none" accept="image/*" id="mainPhoto" />
                                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="document.getElementById('mainPhoto').click()">
                                            <i class="bi bi-upload me-1"></i> Choose Photo
                                        </button>
                                    </div>
                                    <div id="mainPhotoPreview" class="mt-2" style="display: none;">
                                        <img id="mainPhotoImg" src="#" alt="Preview" class="img-thumbnail" style="max-height: 100px;">
                                        <button type="button" class="btn btn-link btn-sm text-danger" onclick="clearMainPhoto()">
                                            <i class="bi bi-x-circle"></i> Remove
                                        </button>
                                    </div>
                                    <div id="mainPhotoPlaceholder" class="text-muted small mt-2">
                                        No photo selected
                                    </div>
                                </div>
                                <div id="photoError" class="text-danger small mt-1" style="display: none;">
                                    <i class="bi bi-exclamation-circle"></i> Main photo is required
                                </div>
                                <small class="text-muted">This image will be shown in the search results.</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Additional Photos (Gallery)</label>
                                <input type="file" name="galleryPhotos" class="form-control" accept="image/*" multiple />
                                <small class="text-muted">Select multiple images for the pet's gallery.</small>
                            </div>
                        </div>

                        <h5 class="fw-bold text-dark mb-3 border-bottom pb-2 mt-4">
                            Health Information <span class="text-danger">*</span>
                        </h5>
                        <div class="bg-light p-3 rounded-3 mb-3">
                            <div class="d-flex flex-wrap gap-4">
                                <div class="form-check form-switch fs-6">
                                    <input class="form-check-input health-check" type="checkbox" asp-for="IsVaccinated" id="vaccinatedCheck" />
                                    <label class="form-check-label fw-semibold text-success" asp-for="IsVaccinated">
                                        <i class="bi bi-shield-check"></i> Vaccinated
                                    </label>
                                </div>

                                <div class="form-check form-switch fs-6">
                                    <input class="form-check-input health-check" type="checkbox" asp-for="IsDewormed" id="dewormedCheck" />
                                    <label class="form-check-label fw-semibold text-success" asp-for="IsDewormed">
                                        <i class="bi bi-capsule"></i> Dewormed
                                    </label>
                                </div>

                                <div class="form-check form-switch fs-6">
                                    <input class="form-check-input health-check" type="checkbox" asp-for="IsSterilized" id="sterilizedCheck" />
                                    <label class="form-check-label fw-semibold text-success" asp-for="IsSterilized">
                                        <i class="bi bi-scissors"></i> Sterilized
                                    </label>
                                </div>
                            </div>
                            <div id="healthError" class="alert alert-danger mt-3 mb-0" style="display: none;">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <strong>Required:</strong> Please select at least one of the three (Vaccinated, Dewormed, or Sterilized).
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary fw-bold rounded-pill py-3 shadow-sm" id="submitBtn">
                                <i class="bi bi-cloud-upload me-2"></i> Submit Listing
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/createListing.js" asp-append-version="true"></script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}