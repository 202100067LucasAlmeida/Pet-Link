@model IEnumerable<PetLink.Models.Application>

@{
    ViewData["Title"] = "Manage Applications";
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-3 mb-4">
            @await Html.PartialAsync("~/Views/Shared/UserSideBar.cshtml")
        </div>

        <div class="col-lg-9">
            <h2 class="text-primary-blue mb-4">Adoption Applications</h2>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th>Applicant</th>
                                    <th>Pet</th>
                                    <th>Submitted</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var app in Model)
                                {
                                    <tr class="align-middle">
                                        <td>
                                            <strong>@app.User?.Name</strong><br />
                                            <small class="text-muted">@app.User?.Email</small>
                                        </td>
                                        <td>
                                            <a asp-controller="AnimalListings" asp-action="Details"
                                                   asp-route-id="@app.AnimalListingId" target="_blank"
                                                   class="text-decoration-none fw-bold">
                                                @app.AnimalListing?.Name
                                            </a>
                                        </td>
                                        <td>@app.SubmittedAt.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            @if (app.Status == PetLink.Models.Enums.ApplicationStatus.Pending)
                                            {
                                                <span class="badge bg-warning text-dark rounded-pill px-3 py-2">Pending</span>
                                            }
                                            else if (app.Status == PetLink.Models.Enums.ApplicationStatus.Approved)
                                            {
                                                <span class="badge bg-info rounded-pill px-3 py-2">Approved</span>
                                            }
                                            else if (app.Status == PetLink.Models.Enums.ApplicationStatus.Completed)
                                            {
                                                <span class="badge bg-success rounded-pill px-3 py-2">Completed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger rounded-pill px-3 py-2">Rejected</span>
                                            }
                                        </td>
                                        <td>
                                            @* Botão para ler a mensagem do adotante *@
                                            <button type="button" class="btn btn-sm btn-outline-secondary me-1"
                                                    data-bs-toggle="modal" data-bs-target="#messageModal-@app.Id">
                                                <i class="bi bi-chat-text"></i> Message
                                            </button>

                                            @if (app.Status == PetLink.Models.Enums.ApplicationStatus.Pending)
                                            {
                                                <form asp-action="Approve" method="post" style="display: inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@app.Id" />
                                                    <button type="submit" class="btn btn-sm btn-success"><i
                                                        class="bi bi-check-lg"></i></button>
                                                    </form>
                                                    <form asp-action="Reject" method="post" style="display: inline;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@app.Id" />
                                                        <button type="submit" class="btn btn-sm btn-danger"><i
                                                            class="bi bi-x-lg"></i></button>
                                                        </form>
                                                    }
                else if (app.Status == PetLink.Models.Enums.ApplicationStatus.Approved)
                                                    {
                                                        <form asp-action="Complete" method="post" style="display: inline;">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@app.Id" />
                                                            <button type="submit" class="btn btn-sm btn-primary">Complete
                                                                Adoption</button>
                                                            </form>
                                                        }
                                                    </td>
                                                </tr>

                                                <div class="modal fade" id="messageModal-@app.Id" tabindex="-1" aria-hidden="true">
                                                    <div class="modal-dialog">
                                                        <div class="modal-content rounded-4 border-0">
                                                            <div class="modal-header border-0 pb-0">
                                                                <h5 class="modal-title text-primary-blue fw-bold">Message from
                                                                    @app.User?.Name</h5>
                                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                                            aria-label="Close"></button>
                                                                </div>
                                                                <div class="modal-body p-4 text-secondary-grey">
                                                                    @if (string.IsNullOrEmpty(app.Message))
                                                                    {
                                                                        <em>No message provided.</em>
                                                                    }
                                                                    else
                                                                    {
                                                                        <p class="mb-0">"@app.Message"</p>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>