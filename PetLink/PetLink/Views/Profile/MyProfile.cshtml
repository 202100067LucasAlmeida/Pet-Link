@using PetLink.Models.Enums
@model PetLink.Models.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-3 mb-4">
            @await Html.PartialAsync("~/Views/Shared/UserSideBar.cshtml")
        </div>

        <div class="col-lg-9">
            @if (userRole == "Admin")
            {
                <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden">
                    <div class="card-body p-4 p-md-5 bg-white">
                        <div class="d-flex align-items-center mb-4">
                            <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                                <i class="bi bi-shield-lock text-primary fs-3"></i>
                            </div>
                            <div>
                                <h3 class="text-primary-darkblue fw-bold mb-1">Admin Control Center</h3>
                                <p class="text-muted mb-0">System management and moderation overview.</p>
                            </div>
                        </div>
                        
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="p-4 bg-light rounded-4 text-center border hover-shadow transition-all">
                                    <i class="bi bi-people-fill text-primary fs-1 mb-2 d-block"></i>
                                    <h5 class="fw-bold mb-1">Users</h5>
                                    <p class="text-muted small">Manage accounts</p>
                                    <a asp-controller="Users" asp-action="Index" class="btn btn-sm btn-primary rounded-pill w-100 mt-2">Go to Users</a>
                                </div>
                            </div>
                            
                            <div class="col-md-4">
                                <div class="p-4 bg-light rounded-4 text-center border hover-shadow transition-all">
                                    <i class="bi bi-card-list text-primary fs-1 mb-2 d-block"></i>
                                    <h5 class="fw-bold mb-1">Listings</h5>
                                    <p class="text-muted small">Moderate ads</p>
                                    <a asp-controller="AnimalListings" asp-action="Manage" class="btn btn-sm btn-primary rounded-pill w-100 mt-2">Go to Listings</a>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="p-4 bg-light rounded-4 text-center border hover-shadow transition-all">
                                    <i class="bi bi-shield-check text-primary fs-1 mb-2 d-block"></i>
                                    <h5 class="fw-bold mb-1">Verify</h5>
                                    <p class="text-muted small">PetSitters status</p>
                                    <a href="#" class="btn btn-sm btn-outline-primary rounded-pill w-100 mt-2">Check All</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                @* Uso de fallback para fotos de perfil *@
                                <img src="@(string.IsNullOrEmpty(Model.User.ProfilePicture) ? "/images/default-avatar.jpg" : Model.User.ProfilePicture)" 
                                     alt="@Model.User.Name" 
                                     class="rounded-circle shadow-sm border border-2 border-white" 
                                     style="width: 90px; height: 90px; object-fit: cover;"
                                     onerror="this.src='/images/default-avatar.jpg'">
                            </div>
                            <div class="flex-grow-1 ms-4">
                                <h1 class="h2 fw-bold text-primary-darkblue mb-1">Hey, @Model.User.Name.Split(' ')[0]!</h1>
                                <p class="text-muted mb-0">Helping you find and care for your perfect companions.</p>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                    <h4 class="fw-bold text-primary-darkblue mb-0">
                        <i class="bi bi-file-earmark-text text-primary me-2"></i>My Applications
                    </h4>
                </div>
                <div class="card-body p-4">
                    @if (Model.ActiveApplications == null || !Model.ActiveApplications.Any())
                    {
                        <div class="text-center py-4 bg-light rounded-4">
                            <i class="bi bi-send-dash fs-1 text-muted opacity-50"></i>
                            <p class="text-muted mt-2">No active adoption requests yet.</p>
                            <a asp-controller="AnimalListings" asp-action="Index" class="btn btn-sm btn-primary rounded-pill px-4">
                                Browse Pets
                            </a>
                        </div>
                    }
                    else
                    {
                        @foreach (var app in Model.ActiveApplications)
                        {
                            <div class="p-3 mb-3 bg-light rounded-4 border-0 hover-shadow transition-all">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-white p-2 rounded-3 me-3 shadow-sm text-center" style="width: 50px;">
                                            <i class="bi bi-paw-fill text-primary"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-primary-darkblue mb-1">@app.AnimalListing?.Name</h6>
                                            <small class="text-muted d-block">Submitted: @app.SubmittedAt.ToString("dd MMM yyyy")</small>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (app.Status == ApplicationStatus.Pending)
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-dark rounded-pill px-3 border border-warning border-opacity-25">In Review</span>
                                        }
                                        else if (app.Status == ApplicationStatus.Approved)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 border border-success border-opacity-25">Approved</span>
                                        }
                                        <a asp-controller="AnimalListings" asp-action="Details" asp-route-id="@app.AnimalListingId" 
                                           class="btn btn-sm btn-white bg-white shadow-sm rounded-pill border">Details</a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                        <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                            <h4 class="fw-bold text-primary-darkblue mb-0">
                                <i class="bi bi-heart-fill text-danger me-2"></i>Saved Pets
                            </h4>
                        </div>
                        <div class="card-body p-4 pt-2">
                            @if (Model.SavedPets == null || !Model.SavedPets.Any())
                            {
                                <div class="text-center py-5 bg-light rounded-4">
                                    <i class="bi bi-heart fs-1 text-muted opacity-25"></i>
                                    <p class="text-muted mt-2">Your favorites list is empty.</p>
                                    <a asp-controller="AnimalListings" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill">Find Pets</a>
                                </div>
                            }
                            else
                            {
                                <div class="position-relative">
                                    <div class="overflow-hidden" id="savedPetsCarousel">
                                        <div class="d-flex" style="gap: 1rem; transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);" id="carouselTrack">
                                            @foreach (var pet in Model.SavedPets)
                                            {
                                                <div class="carousel-card" style="flex: 0 0 calc(50% - 0.5rem); min-width: calc(50% - 0.5rem);">
                                                    <div class="card border border-light shadow-none rounded-4 h-100 hover-shadow transition-all">
                                                        <div class="position-relative" style="height: 120px; overflow: hidden; border-radius: 12px;">
                                                            @* Lógica de imagem atualizada para a subpasta /animals/ *@
                                                            <img src="@(string.IsNullOrEmpty(pet.ImageUrl) ? "/images/default-pet.jpg" : pet.ImageUrl)" 
                                                                 alt="@pet.Name" 
                                                                 style="width: 100%; height: 100%; object-fit: cover;"
                                                                 onerror="this.src='/images/default-pet.jpg'">
                                                            <span class="badge bg-dark bg-opacity-75 position-absolute bottom-0 start-0 m-2 rounded-pill small">
                                                                @pet.Species.ToString()
                                                            </span>
                                                        </div>
                                                        <div class="card-body p-2 pt-3">
                                                            <h6 class="fw-bold text-primary-darkblue mb-0">@pet.Name</h6>
                                                            <p class="text-muted extra-small mb-2"><i class="bi bi-geo-alt me-1"></i>@pet.Location</p>
                                                            <a asp-controller="AnimalListings" asp-action="Details" asp-route-id="@pet.Id" 
                                                               class="btn btn-primary btn-sm rounded-pill w-100 py-1" style="font-size: 0.75rem;">View</a>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    
                                    @if (Model.SavedPets.Count() > 2)
                                    {
                                        <button class="btn btn-white bg-white shadow-sm rounded-circle position-absolute start-0 top-50 translate-middle-y ms-n2 border" 
                                                id="scrollLeftBtn" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; z-index: 5;">
                                            <i class="bi bi-chevron-left small"></i>
                                        </button>
                                        <button class="btn btn-white bg-white shadow-sm rounded-circle position-absolute end-0 top-50 translate-middle-y me-n2 border" 
                                                id="scrollRightBtn" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; z-index: 5;">
                                            <i class="bi bi-chevron-right small"></i>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mb-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                        <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                            <h4 class="fw-bold text-primary-darkblue mb-0">
                                <i class="bi bi-chat-left-text text-primary me-2"></i>Messages
                            </h4>
                            <a href="/Messages" class="btn btn-sm btn-link text-primary text-decoration-none p-0 fw-bold">View All</a>
                        </div>
                        <div class="card-body p-4">
                            @if (Model.RecentConversations == null || !Model.RecentConversations.Any())
                            {
                                <div class="text-center py-4 bg-light rounded-4 h-100 d-flex flex-column justify-content-center">
                                    <i class="bi bi-chat-dots fs-1 text-muted opacity-25"></i>
                                    <p class="text-muted mt-2">No conversations started.</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var msg in Model.RecentConversations.Take(3))
                                {
                                    var otherPerson = msg.SenderId == Model.User.Id ? msg.Receiver : msg.Sender;
                                    var isUnread = msg.ReceiverId == Model.User.Id && !msg.IsRead;
                                    
                                    <a asp-controller="Messages" asp-action="Index" asp-route-id="@otherPerson?.Id" 
                                       class="text-decoration-none">
                                        <div class="p-3 mb-2 rounded-4 transition-all @(isUnread ? "bg-primary bg-opacity-10 border border-primary border-opacity-10" : "bg-light border border-transparent") hover-shadow">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="d-flex align-items-center overflow-hidden">
                                                    <img src="@(string.IsNullOrEmpty(otherPerson?.ProfilePicture) ? "/images/default-avatar.jpg" : otherPerson.ProfilePicture)" 
                                                         class="rounded-circle me-3 border border-white" style="width: 40px; height: 40px; object-fit: cover;">
                                                    <div class="overflow-hidden">
                                                        <h6 class="fw-bold text-primary-darkblue mb-0 text-truncate">@otherPerson?.Name</h6>
                                                        <p class="text-muted extra-small mb-0 text-truncate">
                                                            @(msg.SenderId == Model.User.Id ? "You: " : "")@msg.Content
                                                        </p>
                                                    </div>
                                                </div>
                                                <div class="ms-2 text-end">
                                                    <small class="text-muted extra-small d-block">@msg.CreatedAt.ToString("HH:mm")</small>
                                                    @if (isUnread) { <span class="badge bg-primary rounded-pill p-1 ms-1" style="width: 8px; height: 8px; display: inline-block;"> </span> }
                                                </div>
                                            </div>
                                        </div>
                                    </a>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 text-center p-3 h-100">
                        <h2 class="fw-bold text-primary-darkblue mb-0">@Model.TotalApplications</h2>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.65rem;">Applications</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 text-center p-3 h-100">
                        <h2 class="fw-bold text-primary-darkblue mb-0">@Model.SavedPets.Count()</h2>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.65rem;">Favorites</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 text-center p-3 h-100">
                        <h2 class="fw-bold text-primary-darkblue mb-0">@Model.RecentConversations.Count()</h2>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.65rem;">Chats</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .extra-small { font-size: 0.75rem; }
    .extra-small { font-size: 0.75rem; }
    .transition-all { transition: all 0.3s ease; }
    .hover-shadow:hover { transform: translateY(-3px); box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08) !important; }
    .ms-n2 { margin-left: -1rem; }
    .me-n2 { margin-right: -1rem; }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            const track = document.getElementById('carouselTrack');
            const scrollLeftBtn = document.getElementById('scrollLeftBtn');
            const scrollRightBtn = document.getElementById('scrollRightBtn');
            
            if (track && scrollLeftBtn && scrollRightBtn) {
                let currentPage = 0;
                const cards = document.querySelectorAll('.carousel-card');
                const totalCards = cards.length;
                const cardsPerView = 2;
                const totalPages = Math.ceil(totalCards / cardsPerView);
                
                function updateCarousel() {
                    const cardWidth = cards[0]?.offsetWidth || 0;
                    const gap = 16; 
                    const offset = currentPage * (cardWidth + gap) * cardsPerView;
                    track.style.transform = `translateX(-${offset}px)`;
                    
                    scrollLeftBtn.style.display = currentPage === 0 ? "none" : "flex";
                    scrollRightBtn.style.display = currentPage >= totalPages - 1 ? "none" : "flex";
                }
                
                scrollLeftBtn.addEventListener('click', () => { if (currentPage > 0) { currentPage--; updateCarousel(); } });
                scrollRightBtn.addEventListener('click', () => { if (currentPage < totalPages - 1) { currentPage++; updateCarousel(); } });
                
                window.addEventListener('resize', updateCarousel);
                setTimeout(updateCarousel, 100);
            }
        });
    </script>
}