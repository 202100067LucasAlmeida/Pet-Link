@using PetLink.Models.Enums
@model PetLink.Models.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-3 mb-4">
            @await Html.PartialAsync("~/Views/Shared/UserSideBar.cshtml")
        </div>

        <div class="col-lg-9">
            @if (userRole == "Admin")
            {
                <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden" style="background-color: var(--petlink-card-bg);">
                    <div class="card-body p-4 p-md-5">
                        <div class="d-flex align-items-center mb-4">
                            <div class="p-3 rounded-circle me-3" style="background-color: var(--petlink-light-bg);">
                                <i class="bi bi-shield-lock text-primary fs-3"></i>
                            </div>
                            <div>
                                <h3 class="text-primary-darkblue fw-bold mb-1">Admin Control Center</h3>
                                <p class="text-muted mb-0">System management and moderation overview.</p>
                            </div>
                        </div>

                        <div class="row g-3">
                            @* Cartões de Admin com fundo dinâmico *@
                            @{
                                string[] adminTools = { "Users", "Listings", "Verify" };
                            }
                            <div class="col-md-4">
                                <div class="p-4 rounded-4 text-center border hover-shadow transition-all" style="background-color: var(--petlink-grey-bg); border-color: var(--petlink-border) !important;">
                                    <i class="bi bi-people-fill text-primary fs-1 mb-2 d-block"></i>
                                    <h5 class="fw-bold mb-1 text-primary-darkblue">Users</h5>
                                    <a asp-controller="Users" asp-action="Index" class="btn btn-sm btn-primary rounded-pill w-100 mt-2">Go to Users</a>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="p-4 rounded-4 text-center border hover-shadow transition-all" style="background-color: var(--petlink-grey-bg); border-color: var(--petlink-border) !important;">
                                    <i class="bi bi-card-list text-primary fs-1 mb-2 d-block"></i>
                                    <h5 class="fw-bold mb-1 text-primary-darkblue">Listings</h5>
                                    <a asp-controller="AnimalListings" asp-action="Manage" class="btn btn-sm btn-primary rounded-pill w-100 mt-2">Go to Listings</a>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="p-4 rounded-4 text-center border hover-shadow transition-all" style="background-color: var(--petlink-grey-bg); border-color: var(--petlink-border) !important;">
                                    <i class="bi bi-shield-check text-primary fs-1 mb-2 d-block"></i>
                                    <h5 class="fw-bold mb-1 text-primary-darkblue">Verify</h5>
                                    <a href="#" class="btn btn-sm btn-outline-primary rounded-pill w-100 mt-2">Check All</a>
                                </div>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-4">
                            <h1 class="display-5 fw-bold text-primary-darkblue mb-2">Welcome back, @Model.User.Name!</h1>
                            <p class="text-muted mb-1">Manage your pet adoptions and view your saved companions.</p>

                            <!-- Rating do utilizador - apenas para Users e PetSitters -->
                            @if (ViewBag.CanReceiveReviews == true)
                            {
                                <div class="mt-2">
                                    @if (ViewBag.TotalReviews > 0)
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rating-display">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    @if (i <= ViewBag.AverageRating)
                                                    {
                                                        <i class="bi bi-star-fill text-warning"></i>
                                                    }
                                                    else if (i <= ViewBag.AverageRating + 0.5)
                                                    {
                                                        <i class="bi bi-star-half text-warning"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-star text-warning"></i>
                                                    }
                                                }
                                            </div>
                                            <span class="fw-bold">@ViewBag.AverageRating.ToString("0.0")</span>
                                            <span class="text-muted">(@ViewBag.TotalReviews reviews)</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rating-display">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="bi bi-star text-muted"></i>
                                                }
                                            </div>
                                            <span class="text-muted">No reviews yet</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden" style="background-color: var(--petlink-card-bg);">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <img src="@(string.IsNullOrEmpty(Model.User.ProfilePicture) ? "/images/default-avatar.jpg" : Model.User.ProfilePicture)"
                                     alt="@Model.User.Name"
                                     class="rounded-circle shadow-sm border border-2"
                                     style="width: 90px; height: 90px; object-fit: cover; border-color: var(--petlink-primary) !important;"
                                     onerror="this.src='/images/default-avatar.jpg'">
                            </div>
                            <div class="flex-grow-1 ms-4">
                                <h1 class="h2 fw-bold text-primary-darkblue mb-1">Hey, @Model.User.Name.Split(' ')[0]!</h1>
                                <p class="text-muted mb-0">Helping you find and care for your perfect companions.</p>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* NOTIFICAÇÕES RECENTES*@
            <div class="card border-0 shadow-sm rounded-4 mb-4" style="background-color: var(--petlink-card-bg);">

                <!--ADMIN-->
                @if (userRole == "Admin")
                {
                    <!--HEADER 1-->
                    <div class="card-header border-0 pt-4 px-4 pb-0" style="background-color: transparent;">
                        <h6 class="fw-bold text-primary-darkblue mb-0">
                            <i class="bi bi-clock-history text-primary-darkblue me-2"></i>Pending Approvals
                        </h6>
                    </div>

                    <!--NOTIFICATIONS 1-->
                    <div class="card-body p-4">
                        @{
                            var pendingListings = Model.PendingListingsForAdmin ?? new List<AnimalListing>();
                        }
                        @if (!pendingListings.Any())
                        {
                            <div class="text-center py-y rounded-4" style="background-color: var(--petlink-grey-bg);">
                                <i class="bi bi-check-circle-fill text-success fs-4"></i>
                                <p class="text-muted small mb-0 mt-2">No pending listings to review</p>
                            </div>
                        }
                        else
                        {
                            <div class="list-group">
                                @foreach (var listing in pendingListings)
                                {
                                    <div class="p-3 mb-2 rounded-4 border" style="background-color: var(--petlink-grey-bg);">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h6 class="fw-bold text-primary-darkblue mb-1">@listing.Name</h6>
                                                <small class="text-muted">Submitted by: @listing.Tutor?.Name</small><br />
                                                <small class="text-muted">Created: @listing.CreatedAt.ToString("dd MMM yyyy")</small>
                                            </div>
                                            <a asp-controller="AnimalListings" asp-action="Edit" asp-route-id="@listing.Id"
                                               class="btn btn-sm btn-primary rounded-pill">
                                                <i class="bi bi-eye me-1"></i>Review
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>


                    <!--HEADER 2-->
                    <div class="card-header border-0 pt-4 px-4 pb-0" style="background-color: transparent;">
                        <h6 class="fw-bold text-primary-darkblue mb-0">
                            <i class="bi bi-person-check text-primary-darkblue me-2"></i>Pending User Verifications
                        </h6>
                    </div>

                    <!--NOTIFICATIONS 2-->
                    <div class="card-body p-4">
                        @{
                            var unverifiedUsers = Model.UnverifiedUsersForAdmin ?? new List<User>();
                        }
                        @if (!unverifiedUsers.Any())
                        {
                            <div class="text-center py-y rounded-4" style="background-color: var(--petlink-grey-bg);">
                                <i class="bi bi-check-circle-fill text-success fs-4"></i>
                                <p class="text-muted small mb-0 mt-2">All users are verified</p>
                            </div>
                        }
                        else
                        {
                            <div class="list-group">
                                @foreach (var unverifiedUser in unverifiedUsers)
                                {
                                    <div class="p-3 mb-2 rounded-4 border" style="background-color: var(--petlink-grey-bg);">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="d-flex align-items-center gap-2 mb-1">
                                                    <h6 class="fw-bold text-primary-darkblue mb-0">@unverifiedUser.Name</h6>
                                                    <span class="badge rounded-pill px-2 py-1" style="font-size: 0.65rem; background-color: rgba(255, 193, 7, 0.1); color: #ffc107;">
                                                        @unverifiedUser.Role
                                                    </span>
                                                </div>
                                                <small class="text-muted d-block">Email: @unverifiedUser.Email</small>
                                                <small class="text-muted d-block">Phone: @unverifiedUser.Phone</small>
                                                <small class="text-muted">Registered: @unverifiedUser.CreatedAt.ToString("dd MMM yyyy")</small>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <a asp-controller="Users" asp-action="Edit" asp-route-id="@unverifiedUser.Id"
                                                   class="btn btn-sm btn-primary rounded-pill">
                                                    <i class="bi bi-check2-circle me-1"></i>Verify
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                }

                <!--NORMAL USER-->
                @if (userRole != "Admin")
                {
                    <!--HEADER-->
                    <div class="card-header border-0 pt-4 px-4 pb-0" style="background-color: transparent;">
                        <h6 class="fw-bold text-primary-darkblue mb-0">
                            <i class="bi bi-bell text-primary-darkblue me-2"></i>Recent Notifications
                        </h6>
                    </div>

                    <!--NOTIFICATIONS-->
                    <div class="card-body p-4">
                        @{
                            var unreadNotifications = Model.RecentNotifications?.Where(n => !n.IsRead).ToList();
                        }
                        @if (unreadNotifications == null || !unreadNotifications.Any())
                        {
                            <div class="text-center py-4 rounded-4" style="background-color: var(--petlink-grey-bg);">
                                <i class="bi bi-bell-slash fs-1 text-muted opacity-50"></i>
                                <p class="text-muted mt-2 mb-0">You don't have any recent updates on your listings.</p>
                            </div>
                        }
                        else
                        {
                            <div class="markAllRead mb-2">
                                <form asp-controller="Profile" asp-action="MarkAllNotificationAsRead" method="post" style="display: inline;">
                                    <input type="hidden" name="userId" value="@Model.User.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill" style="font-size: 0.75rem; padding: 0.25rem 0.75rem;">
                                        <i class="bi bi-check2 me-1"></i>Mark all as read
                                    </button>
                                </form>
                            </div>

                            @foreach (var notification in unreadNotifications)
                            {
                                <div class="notification-item mb-3 p-3 rounded-4 transition-all hover-shadow border
                                                        @(notification.IsRead ? "" : "border-primary")" style="background-color: var(--petlink-grey-bg);
                                                        @(notification.IsRead ? "border-color: var(--petlink-border) !important;" : "border-color: var(--petlink-primary) !important;")"
                                     data-notification-id="@notification.Id">

                                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                                        <div class="flex-grow-1">
                                            <div class="d-flex align-items-center gap-2 mb-2">
                                                <i class="bi bi-info-circle-fill text-primary"></i>
                                                <h6 class="fw-bold text-primary-darkblue mb-0">@notification.Title</h6>
                                                @if (!notification.IsRead)
                                                {
                                                    <span class="badge bg-primary rounded-pill ms-2" style="font-size: 0.65rem;">!</span>
                                                }
                                            </div>
                                            <p class="text-muted small mb-2">@notification.Message</p>
                                            <small class="text-muted" style="font-size: 0.7rem;">
                                                <i class="bi bi-clock me-1"></i>@notification.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                                            </small>
                                        </div>
                                        <div class="d-flex gap-2">
                                            @if (!notification.IsRead)
                                            {
                                                <form asp-controller="Profile" asp-action="MarkNotificationAsRead" method="post" style="display: inline;">
                                                    <input type="hidden" name="notificationId" value="@notification.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill" style="font-size: 0.75rem; padding: 0.25rem 0.75rem;">
                                                        <i class="bi bi-check2 me-1"></i>Mark as read
                                                    </button>
                                                </form>
                                            }
                                            @if (notification.AnimalListingId.HasValue)
                                            {
                                                <a asp-controller="AnimalListings" asp-action="Details" asp-route-id="@notification.AnimalListingId"
                                                   class="btn btn-sm btn-primary rounded-pill"
                                                   style="font-size: 0.75rem; padding: 0.25rem 0.75rem;">
                                                    <i class="bi bi-eye me-1"></i>View Pet
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
            </div>

            @* SECÇÃO DE CANDIDATURAS *@
            <div class="card border-0 shadow-sm rounded-4 mb-4" style="background-color: var(--petlink-card-bg);">
                <div class="card-header border-0 pt-4 px-4 pb-0" style="background-color: transparent;">
                    <h4 class="fw-bold text-primary-darkblue mb-0">
                        <i class="bi bi-file-earmark-text text-primary me-2"></i>My Applications
                    </h4>
                </div>
                <div class="card-body p-4">
                    @if (Model.ActiveApplications == null || !Model.ActiveApplications.Any())
                    {
                        <div class="text-center py-4 rounded-4" style="background-color: var(--petlink-grey-bg);">
                            <i class="bi bi-send-dash fs-1 text-muted opacity-50"></i>
                            <p class="text-muted mt-2">No active adoption requests yet.</p>
                            <a asp-controller="AnimalListings" asp-action="Index" class="btn btn-sm btn-primary rounded-pill px-4">Browse Pets</a>
                        </div>
                    }
                    else
                    {
                        @foreach (var app in Model.ActiveApplications)
                        {
                            <div class="p-3 mb-3 rounded-4 border-0 hover-shadow transition-all" style="background-color: var(--petlink-grey-bg);">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                                    <div class="d-flex align-items-center">
                                        <div class="p-2 rounded-3 me-3 shadow-sm text-center" style="width: 50px; background-color: var(--petlink-card-bg);">
                                            <i class="bi bi-paw-fill text-primary"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-primary-darkblue mb-1">@app.AnimalListing?.Name</h6>
                                            <small class="text-muted d-block">Submitted: @app.SubmittedAt.ToString("dd MMM yyyy")</small>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-3">
                                        @* Badges dinâmicas *@
                                        @if (app.Status == ApplicationStatus.Pending)
                                        {
                                            <span class="badge rounded-pill px-3 border fw-bold" style="background-color: rgba(255, 193, 7, 0.1); color: #ffc107; border-color: rgba(255, 193, 7, 0.3) !important;">In Review</span>
                                        }
                                        else if (app.Status == ApplicationStatus.Approved)
                                        {
                                            <span class="badge rounded-pill px-3 border fw-bold" style="background-color: rgba(40, 167, 69, 0.1); color: #28a745; border-color: rgba(40, 167, 69, 0.3) !important;">Approved</span>
                                        }
                                        <a asp-controller="AnimalListings" asp-action="Details" asp-route-id="@app.AnimalListingId"
                                           class="btn btn-sm rounded-pill border fw-bold" style="background-color: var(--petlink-card-bg); color: var(--petlink-dark); border-color: var(--petlink-border) !important;">Details</a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="row">
                <!-- Saved Pets Section -->
                <div class="col-md-6 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bold text-primary-darkblue mb-0">
                            <i class="bi bi-heart-fill text-danger me-2"></i>Saved Pets
                        </h4>
                    </div>

                    @if (Model.SavedPets == null || !Model.SavedPets.Any())
                    {
                        <div class="text-center py-5 bg-primary-light rounded-3">
                            <i class="bi bi-heart fs-1 text-muted"></i>
                            <p class="text-muted mt-2">No saved pets yet</p>
                            <a asp-controller="AnimalListings" asp-action="Index" class="btn btn-sm btn-primary rounded-pill">
                                Browse Pets
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="position-relative">
                            <div class="overflow-hidden" id="savedPetsCarousel">
                                <div class="d-flex" style="gap: 1rem; transition: transform 0.3s ease;" id="carouselTrack">
                                    @foreach (var pet in Model.SavedPets)
                                    {
                                        <div class="carousel-card" style="flex: 0 0 calc(50% - 0.5rem); min-width: calc(50% - 0.5rem);">
                                            <div class="card border-0 shadow-sm rounded-4 h-100">
                                                <div class="position-relative" style="height: 140px; overflow: hidden; border-radius: 12px 12px 0 0;">
                                                    @{
                                                        var imagePath = $"/images/{pet.Name.ToLower()}.jpg";
                                                        var fullPath = System.IO.Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "images", $"{pet.Name.ToLower()}.jpg");
                                                        var imageExists = System.IO.File.Exists(fullPath);
                                                    }
                                                    @if (imageExists)
                                                    {
                                                        <img src="@imagePath" alt="@pet.Name"
                                                             style="width: 100%; height: 100%; object-fit: cover; object-position: center;">
                                                    }
                                                    else
                                                    {
                                                        <div class="bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center w-100 h-100">
                                                            <i class="bi bi-image text-muted fs-1"></i>
                                                        </div>
                                                    }
                                                    <span class="badge bg-primary position-absolute bottom-0 start-0 m-2 rounded-pill" style="font-size: 0.7rem;">
                                                        @pet.Species.ToString().ToUpper()
                                                    </span>
                                                </div>
                                                <div class="card-body p-3">
                                                    <h6 class="fw-bold text-primary-darkblue mb-1" style="font-size: 1rem;">@pet.Name</h6>
                                                    <p class="text-muted small mb-2" style="font-size: 0.75rem;">
                                                        <i class="bi bi-geo-alt me-1"></i>@pet.Location, Portugal
                                                    </p>
                                                    <div class="d-flex flex-wrap gap-1 mb-3">
                                                        @* @if (pet.Breed != 0)
                                                        {
                                                            <span class="badge bg-light text-dark" style="font-size: 0.7rem;">@pet.Breed</span>
                                                        }*@
                                                        <span class="badge bg-light text-dark" style="font-size: 0.7rem;">@pet.AgeMonths mo.</span>
                                                    </div>
                                                    <a asp-controller="AnimalListings" asp-action="Details" asp-route-id="@pet.Id"
                                                       class="btn btn-outline-primary rounded-pill w-100" style="font-size: 0.8rem;">
                                                        View Details
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Botões de navegação -->
                            @if (Model.SavedPets.Count() > 2)
                            {
                                <button class="btn btn-light rounded-circle shadow-sm position-absolute start-0 top-50 translate-middle-y ms-2"
                                        id="scrollLeftBtn" style="z-index: 10; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; background: white; border: 1px solid #dee2e6;">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                                <button class="btn btn-light rounded-circle shadow-sm position-absolute end-0 top-50 translate-middle-y me-2"
                                        id="scrollRightBtn" style="z-index: 10; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; background: white; border: 1px solid #dee2e6;">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            }
                        </div>

                        <!-- Indicador de quantos animais faltam -->
                        if (Model.SavedPets.Count() > 2)
                        {
                            <div class="text-center mt-3">
                                <small class="text-muted" id="carouselIndicator">1 - 2 of @Model.SavedPets.Count()</small>
                            </div>
                        }
                    }
                </div>
                @* FAVOURITES CAROUSEL *@
                <div class="col-md-6 mb-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden" style="background-color: var(--petlink-card-bg);">
                        <div class="card-header border-0 pt-4 px-4 pb-2" style="background-color: transparent;">
                            <h4 class="fw-bold text-primary-darkblue mb-0">
                                <i class="bi bi-heart-fill text-danger me-2"></i>Saved Pets
                            </h4>
                        </div>
                        <div class="card-body p-4 pt-2">
                            @if (Model.SavedPets == null || !Model.SavedPets.Any())
                            {
                                <div class="text-center py-5 rounded-4" style="background-color: var(--petlink-grey-bg);">
                                    <i class="bi bi-heart fs-1 text-muted opacity-25"></i>
                                    <p class="text-muted mt-2">Your favorites list is empty.</p>
                                </div>
                            }
                            else
                            {
                                <div class="position-relative">
                                    <div class="overflow-hidden" id="savedPetsCarousel">
                                        <div class="d-flex" style="gap: 1rem; transition: transform 0.4s ease;" id="carouselTrack">
                                            @foreach (var pet in Model.SavedPets)
                                            {
                                                <div class="carousel-card" style="flex: 0 0 calc(50% - 0.5rem); min-width: calc(50% - 0.5rem);">
                                                    <div class="card shadow-none rounded-4 h-100 hover-shadow transition-all" style="background-color: var(--petlink-grey-bg); border: 1px solid var(--petlink-border) !important;">
                                                        <div class="position-relative" style="height: 120px; overflow: hidden; border-radius: 12px 12px 0 0;">
                                                            <img src="@(string.IsNullOrEmpty(pet.ImageUrl) ? "/images/default-pet.jpg" : pet.ImageUrl)"
                                                                 style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/default-pet.jpg'">
                                                        </div>
                                                        <div class="card-body p-2 pt-3 text-center">
                                                            <h6 class="fw-bold text-primary-darkblue mb-1">@pet.Name</h6>
                                                            <a asp-controller="AnimalListings" asp-action="Details" asp-route-id="@pet.Id"
                                                               class="btn btn-primary btn-sm rounded-pill w-100 py-1" style="font-size: 0.75rem;">View</a>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    @* Botões de navegação adaptados *@
                                    @if (Model.SavedPets.Count() > 2)
                                    {
                                        <button class="btn shadow-sm rounded-circle position-absolute start-0 top-50 translate-middle-y border"
                                                id="scrollLeftBtn" style="width: 32px; height: 32px; z-index: 5; background-color: var(--petlink-card-bg); color: var(--petlink-dark); border-color: var(--petlink-border) !important;">
                                            <i class="bi bi-chevron-left small"></i>
                                        </button>
                                        <button class="btn shadow-sm rounded-circle position-absolute end-0 top-50 translate-middle-y border"
                                                id="scrollRightBtn" style="width: 32px; height: 32px; z-index: 5; background-color: var(--petlink-card-bg); color: var(--petlink-dark); border-color: var(--petlink-border) !important;">
                                            <i class="bi bi-chevron-right small"></i>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @* MESSAGES *@
                <div class="col-md-6 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bold text-primary-darkblue mb-0">
                            <i class="bi bi-chat-dots me-2"></i>Recent Messages
                        </h4>
                        <a asp-controller="Messages" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill">
                            View All <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>

                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body">
                            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden" style="background-color: var(--petlink-card-bg);">
                                <div class="card-header border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center" style="background-color: transparent;">
                                    <h4 class="fw-bold text-primary-darkblue mb-0">
                                        <i class="bi bi-chat-left-text text-primary me-2"></i>Messages
                                    </h4>
                                    <a href="/Messages" class="btn btn-sm text-primary p-0 fw-bold">View All</a>
                                </div>
                                <div class="card-body p-4">
                                    @if (Model.RecentConversations == null || !Model.RecentConversations.Any())
                                    {
                                        <div class="text-center py-4 rounded-4 h-100 d-flex flex-column justify-content-center" style="background-color: var(--petlink-grey-bg);">
                                            <i class="bi bi-chat-dots fs-1 text-muted opacity-25"></i>
                                            <p class="text-muted mt-2">No conversations started.</p>
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var msg in Model.RecentConversations.Take(3))
                                        {
                                            var otherPerson = msg.SenderId == Model.User.Id ? msg.Receiver : msg.Sender;
                                            var isUnread = msg.ReceiverId == Model.User.Id && !msg.IsRead;

                                            <a asp-controller="Messages" asp-action="Index" asp-route-id="@otherPerson?.Id" class="text-decoration-none">
                                                <div class="p-3 mb-2 rounded-4 transition-all hover-shadow border"
                                                     style="background-color: @(isUnread ? "rgba(8, 124, 217, 0.1)" : "var(--petlink-grey-bg)"); border-color: @(isUnread ? "var(--petlink-primary)" : "transparent") !important;">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <div class="d-flex align-items-center overflow-hidden">
                                                            <img src="@(string.IsNullOrEmpty(otherPerson?.ProfilePicture) ? "/images/default-avatar.jpg" : otherPerson.ProfilePicture)"
                                                                 class="rounded-circle me-3" style="width: 40px; height: 40px; object-fit: cover;">
                                                            <div class="overflow-hidden">
                                                                <h6 class="fw-bold text-primary-darkblue mb-0 text-truncate">@otherPerson?.Name</h6>
                                                                <p class="text-muted extra-small mb-0 text-truncate">@msg.Content</p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </a>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* QUICK STATS DINÂMICOS *@
                <div class="row g-3">
                    @{
                        string[] stats = { Model.TotalApplications.ToString(), Model.SavedPets.Count().ToString(), Model.RecentConversations.Count().ToString() };
                        string[] labels = { "Applications", "Favorites", "Chats" };
                    }

                    @for (int i = 0; i < 3; i++)
                    {
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm rounded-4 text-center p-3 h-100" style="background-color: var(--petlink-card-bg);">
                                <h2 class="fw-bold text-primary-darkblue mb-0">@stats[i]</h2>
                                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.65rem;">@labels[i]</small>
                            </div>
                        </div>
                    }
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center">
                                    <div class="bg-warning bg-opacity-10 rounded-circle p-3 me-3">
                                        <i class="bi bi-envelope text-warning fs-3"></i>
                                    </div>
                                    <div>
                                        <h2 class="fw-bold mb-0">@Model.UnreadMessages</h2>
                                        <p class="text-muted mb-0">Unread Messages</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Carrossel para Saved Pets
            const track = document.getElementById('carouselTrack');
            const scrollLeftBtn = document.getElementById('scrollLeftBtn');
            const scrollRightBtn = document.getElementById('scrollRightBtn');
            const indicator = document.getElementById('carouselIndicator');

            if (track && scrollLeftBtn && scrollRightBtn) {
                let currentPage = 0;
                const cards = document.querySelectorAll('.carousel-card');
                const cardsPerView = 2;
                const totalCards = cards.length;
                const totalPages = Math.ceil(totalCards / cardsPerView);

                function updateCarousel() {
                    const cardWidth = cards[0]?.offsetWidth || 0;
                    const gap = 16;
                    const offset = currentPage * (cardWidth + gap) * cardsPerView;
                    track.style.transform = `translateX(-${offset}px)`;

                    // Atualizar indicador
                    if (indicator) {
                        const start = currentPage * cardsPerView + 1;
                        const end = Math.min((currentPage + 1) * cardsPerView, totalCards);
                        indicator.textContent = `${start} - ${end} of ${totalCards}`;
                    }

                    // Desabilitar/enabled botões
                    scrollLeftBtn.disabled = currentPage === 0;
                    scrollRightBtn.disabled = currentPage === totalPages - 1;
                    scrollLeftBtn.style.opacity = currentPage === 0 ? "0.5" : "1";
                    scrollRightBtn.style.opacity = currentPage === totalPages - 1 ? "0.5" : "1";
                }

                scrollLeftBtn.addEventListener('click', () => {
                    if (currentPage > 0) {
                        currentPage--;
                        updateCarousel();
                    }
                });

                scrollRightBtn.addEventListener('click', () => {
                    if (currentPage < totalPages - 1) {
                        currentPage++;
                        updateCarousel();
                    }
                });

                // Atualizar ao redimensionar
                window.addEventListener('resize', () => {
                    updateCarousel();
                });

                // Inicializar
                setTimeout(updateCarousel, 100);
            }

        });
    </script>
}