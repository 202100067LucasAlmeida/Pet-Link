@using PetLink.Models.Enums
@model PetLink.Models.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}

<div class="container py-4">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-lg-3 mb-4">
            @await Html.PartialAsync("~/Views/Shared/UserSideBar.cshtml")
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
            <!-- Welcome Header -->
            @if (userRole == "Admin")
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4">
                        <h3 class="text-primary-darkblue mb-1">Admin Dashboard</h3>
                        <p class="text-muted">Welcome to the PetLink control center.</p>
                        
                        <div class="row g-3 mt-3">
                            <!-- Cartão 1: Users -->
                            <div class="col-md-4">
                                <div class="p-4 bg-light rounded-4 text-center border">
                                    <i class="bi bi-people-fill text-primary fs-1 mb-2"></i>
                                    <h2 class="fw-bold mb-0">Manage</h2>
                                    <p class="text-muted small">Users</p>
                                    <a asp-controller="Users" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill w-100 mt-2">Go to Users</a>
                                </div>
                            </div>
                            
                            <!-- Cartão 2: Listings -->
                            <div class="col-md-4">
                                <div class="p-4 bg-light rounded-4 text-center border">
                                    <i class="bi bi-card-list text-primary fs-1 mb-2"></i>
                                    <h2 class="fw-bold mb-0">Approve</h2>
                                    <p class="text-muted small">Listings</p>
                                    <a asp-controller="AnimalListings" asp-action="Manage" class="btn btn-sm btn-outline-primary rounded-pill w-100 mt-2">Go to Listings</a>
                                </div>
                            </div>

                            <!-- Cartão 3: Reports / Petsitters -->
                            <div class="col-md-4">
                                <div class="p-4 bg-light rounded-4 text-center border">
                                    <i class="bi bi-shield-check text-primary fs-1 mb-2"></i>
                                    <h2 class="fw-bold mb-0">Verify</h2>
                                    <p class="text-muted small">PetSitters</p>
                                    <a href="#" class="btn btn-sm btn-outline-primary rounded-pill w-100 mt-2">Go to Approvals</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                @if (!string.IsNullOrEmpty(Model.User.ProfilePicture))
                                {
                                    <img src="@Model.User.ProfilePicture" alt="@Model.User.Name" 
                                        class="rounded-circle" style="width: 80px; height: 80px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" 
                                        style="width: 80px; height: 80px;">
                                        <i class="bi bi-person-circle text-primary fs-1"></i>
                                    </div>
                                }
                            </div>
                            <div class="flex-grow-1 ms-4">
                                <h1 class="display-5 fw-bold text-primary-darkblue mb-2">Welcome back, @Model.User.Name!</h1>
                                <p class="text-muted mb-1">Manage your pet adoptions and view your saved companions.</p>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Active Applications Section -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <h4 class="fw-bold text-primary-darkblue mb-0">
                        <i class="bi bi-file-text me-2"></i>Active Applications
                    </h4>
                </div>
                <div class="card-body">
                    @if (Model.ActiveApplications == null || !Model.ActiveApplications.Any())
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-inbox fs-1 text-muted"></i>
                            <p class="text-muted mt-2">No active applications</p>
                            <a asp-controller="AnimalListings" asp-action="Index" class="btn btn-sm btn-primary rounded-pill">
                                Browse Pets
                            </a>
                        </div>
                    }
                    else
                    {
                        @foreach (var app in Model.ActiveApplications)
                        {
                            <div class="border-bottom pb-3 mb-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h5 class="fw-bold text-primary-darkblue mb-1">@app.AnimalListing?.Name</h5>
                                        <p class="text-muted small mb-2">
                                            Submitted on @app.SubmittedAt.ToString("MMM dd, yyyy") • @(app.AnimalListing?.Tutor?.Name ?? "Unknown Shelter")
                                        </p>
                                        <div class="d-flex align-items-center">
                                            @if (app.Status == ApplicationStatus.Pending)
                                            {
                                                <span class="badge bg-warning text-dark me-2">In Progress</span>
                                                <span class="small text-muted">Step @app.CurrentStep of @app.TotalSteps</span>
                                            }
                                            else if (app.Status == ApplicationStatus.Approved)
                                            {
                                                <span class="badge bg-success me-2">Approved</span>
                                                <span class="small text-muted">Ready for pickup</span>
                                            }
                                        </div>
                                    </div>
                                    <a asp-controller="AnimalListings" asp-action="Details" asp-route-id="@app.AnimalListingId" 
                                       class="btn btn-sm btn-outline-primary rounded-pill">
                                        View Details
                                    </a>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

        
            <div class="row">
                <!-- Saved Pets Section -->
<div class="col-md-6 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold text-primary-darkblue mb-0">
            <i class="bi bi-heart-fill text-danger me-2"></i>Saved Pets
        </h4>
    </div>
    
    @if (Model.SavedPets == null || !Model.SavedPets.Any())
    {
        <div class="text-center py-5 bg-primary-light rounded-3">
            <i class="bi bi-heart fs-1 text-muted"></i>
            <p class="text-muted mt-2">No saved pets yet</p>
            <a asp-controller="AnimalListings" asp-action="Index" class="btn btn-sm btn-primary rounded-pill">
                Browse Pets
            </a>
        </div>
    }
    else
    {
        <div class="position-relative">
            <div class="overflow-hidden" id="savedPetsCarousel">
                <div class="d-flex" style="gap: 1rem; transition: transform 0.3s ease;" id="carouselTrack">
                    @foreach (var pet in Model.SavedPets)
                    {
                        <div class="carousel-card" style="flex: 0 0 calc(50% - 0.5rem); min-width: calc(50% - 0.5rem);">
                            <div class="card border-0 shadow-sm rounded-4 h-100">
                                <div class="position-relative" style="height: 140px; overflow: hidden; border-radius: 12px 12px 0 0;">
                                    @{
                                        var imagePath = $"/images/{pet.Name.ToLower()}.jpg";
                                        var fullPath = System.IO.Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "images", $"{pet.Name.ToLower()}.jpg");
                                        var imageExists = System.IO.File.Exists(fullPath);
                                    }
                                    @if (imageExists)
                                    {
                                        <img src="@imagePath" alt="@pet.Name" 
                                             style="width: 100%; height: 100%; object-fit: cover; object-position: center;">
                                    }
                                    else
                                    {
                                        <div class="bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center w-100 h-100">
                                            <i class="bi bi-image text-muted fs-1"></i>
                                        </div>
                                    }
                                    <span class="badge bg-primary position-absolute bottom-0 start-0 m-2 rounded-pill" style="font-size: 0.7rem;">
                                        @pet.Species.ToString().ToUpper()
                                    </span>
                                </div>
                                <div class="card-body p-3">
                                    <h6 class="fw-bold text-primary-darkblue mb-1" style="font-size: 1rem;">@pet.Name</h6>
                                    <p class="text-muted small mb-2" style="font-size: 0.75rem;">
                                        <i class="bi bi-geo-alt me-1"></i>@pet.Location, Portugal
                                    </p>
                                    <div class="d-flex flex-wrap gap-1 mb-3">
                                        @*
                                        @if (pet.Breed != 0)
                                        {
                                            <span class="badge bg-light text-dark" style="font-size: 0.7rem;">@pet.Breed</span>
                                        }*@
                                        <span class="badge bg-light text-dark" style="font-size: 0.7rem;">@pet.AgeMonths mo.</span>
                                    </div>
                                    <a asp-controller="AnimalListings" asp-action="Details" asp-route-id="@pet.Id" 
                                       class="btn btn-outline-primary rounded-pill w-100" style="font-size: 0.8rem;">
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            
            <!-- Botões de navegação -->
            @if (Model.SavedPets.Count() > 2)
            {
                <button class="btn btn-light rounded-circle shadow-sm position-absolute start-0 top-50 translate-middle-y ms-2" 
                        id="scrollLeftBtn" style="z-index: 10; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; background: white; border: 1px solid #dee2e6;">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <button class="btn btn-light rounded-circle shadow-sm position-absolute end-0 top-50 translate-middle-y me-2" 
                        id="scrollRightBtn" style="z-index: 10; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; background: white; border: 1px solid #dee2e6;">
                    <i class="bi bi-chevron-right"></i>
                </button>
            }
        </div>
        
        <!-- Indicador de quantos animais faltam -->
        if (Model.SavedPets.Count() > 2)
        {
            <div class="text-center mt-3">
                <small class="text-muted" id="carouselIndicator">1 - 2 of @Model.SavedPets.Count()</small>
            </div>
        }
    }
</div>

<!-- Recent Messages Section -->
<div class="col-md-6 mb-4">
    <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-header bg-white border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
            <h4 class="fw-bold text-primary-darkblue mb-0">
                <i class="bi bi-chat-dots me-2"></i>Recent Messages
            </h4>
            <a href="/Messages" class="btn btn-sm btn-primary rounded-pill">
                View All <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="card-body">
            @if (Model.RecentConversations == null || !Model.RecentConversations.Any())
            {
                <div class="text-center py-4">
                    <i class="bi bi-chat-dots fs-1 text-muted"></i>
                    <p class="text-muted mt-2">No messages yet</p>
                </div>
            }
            else
            {
                @foreach (var msg in Model.RecentConversations.Take(3))
                {
                    var otherPerson = msg.SenderId == Model.User.Id ? msg.Receiver : msg.Sender;
                    var isUnread = msg.ReceiverId == Model.User.Id && !msg.IsRead;
                    
                    <a asp-controller="Messages" asp-action="Index" asp-route-id="@otherPerson?.Id" 
                       class="text-decoration-none">
                        <div class="border-bottom pb-3 mb-3 @(isUnread ? "bg-light p-2 rounded-3" : "") 
                                    hover-message transition-all">
                            <div class="d-flex justify-content-between">
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(otherPerson?.ProfilePicture))
                                    {
                                        <img src="@otherPerson.ProfilePicture" alt="@otherPerson.Name" 
                                             class="rounded-circle me-2" style="width: 36px; height: 36px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="bg-secondary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-2" 
                                             style="width: 36px; height: 36px;">
                                            <i class="bi bi-person-circle text-secondary fs-5"></i>
                                        </div>
                                    }
                                    <div>
                                        <h6 class="fw-bold mb-0" style="font-size: 0.85rem;">@otherPerson?.Name</h6>
                                        <small class="text-muted" style="font-size: 0.7rem;">
                                            @{
                                                var timeAgo = DateTime.Now - msg.CreatedAt;
                                                if (timeAgo.TotalMinutes < 60)
                                                {
                                                    <span>@((int)timeAgo.TotalMinutes)m ago</span>
                                                }
                                                else if (timeAgo.TotalHours < 24)
                                                {
                                                    <span>@((int)timeAgo.TotalHours)h ago</span>
                                                }
                                                else if (timeAgo.TotalDays < 7)
                                                {
                                                    <span>@((int)timeAgo.TotalDays)d ago</span>
                                                }
                                                else
                                                {
                                                    <span>@msg.CreatedAt.ToString("MMM dd")</span>
                                                }
                                            }
                                        </small>
                                    </div>
                                </div>
                                @if (isUnread)
                                {
                                    <span class="badge bg-primary rounded-pill" style="font-size: 0.65rem;">New</span>
                                }
                            </div>
                            <p class="text-muted small mb-0 mt-2" style="font-size: 0.7rem;">
                                @{
                                    var preview = msg.Content.Length > 50 ? msg.Content.Substring(0, 50) + "..." : msg.Content;
                                    var sender = msg.SenderId == Model.User.Id ? "You: " : "";
                                }
                                <span class="@(isUnread ? "fw-bold" : "")">@sender@preview</span>
                            </p>
                        </div>
                    </a>
                }
            }
        </div>
    </div>
</div>

            <!-- Statistics Cards -->
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3">
                                    <i class="bi bi-file-text text-primary fs-3"></i>
                                </div>
                                <div>
                                    <h2 class="fw-bold mb-0">@Model.TotalApplications</h2>
                                    <p class="text-muted mb-0">Total Applications</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Carrossel para Saved Pets
            const track = document.getElementById('carouselTrack');
            const scrollLeftBtn = document.getElementById('scrollLeftBtn');
            const scrollRightBtn = document.getElementById('scrollRightBtn');
            const indicator = document.getElementById('carouselIndicator');
            
            if (track && scrollLeftBtn && scrollRightBtn) {
                let currentPage = 0;
                const cards = document.querySelectorAll('.carousel-card');
                const cardsPerView = 2;
                const totalCards = cards.length;
                const totalPages = Math.ceil(totalCards / cardsPerView);
                
                function updateCarousel() {
                    const cardWidth = cards[0]?.offsetWidth || 0;
                    const gap = 16; 
                    const offset = currentPage * (cardWidth + gap) * cardsPerView;
                    track.style.transform = `translateX(-${offset}px)`;
                    
                    // Atualizar indicador
                    if (indicator) {
                        const start = currentPage * cardsPerView + 1;
                        const end = Math.min((currentPage + 1) * cardsPerView, totalCards);
                        indicator.textContent = `${start} - ${end} of ${totalCards}`;
                    }
                    
                    // Desabilitar/enabled botões
                    scrollLeftBtn.disabled = currentPage === 0;
                    scrollRightBtn.disabled = currentPage === totalPages - 1;
                    scrollLeftBtn.style.opacity = currentPage === 0 ? "0.5" : "1";
                    scrollRightBtn.style.opacity = currentPage === totalPages - 1 ? "0.5" : "1";
                }
                
                scrollLeftBtn.addEventListener('click', () => {
                    if (currentPage > 0) {
                        currentPage--;
                        updateCarousel();
                    }
                });
                
                scrollRightBtn.addEventListener('click', () => {
                    if (currentPage < totalPages - 1) {
                        currentPage++;
                        updateCarousel();
                    }
                });
                
                // Atualizar ao redimensionar
                window.addEventListener('resize', () => {
                    updateCarousel();
                });
                
                // Inicializar
                setTimeout(updateCarousel, 100);
            }
            
        });
    </script>
}

