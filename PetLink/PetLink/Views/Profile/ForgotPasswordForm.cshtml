@model PetLink.Models.User
@{
    ViewData["Title"] = "Forgot Password Form";
}

<div class="container mt-4 d-flex flex-column justify-content-center align-items-center">
    <div class="text-center mb-3">
        <h1 class="display-6 text-primary-blue fw-bold">
            <i class="text-primary me-2">
                <img src="~/images/logo.png" alt="PetLink Logo" height="40"
                     class="d-inline-block align-text-top me-2">
            </i>PETLINK
        </h1>
        <p class="text-muted">Forgot my password.</p>
    </div>

    <div class="p-3">
        <div class="card shadow-sm" style="border: 2px solid var(--petlink-primary); border-radius: 50px; width: 400px;">
            <div class="card-body p-2 p-md-5">

                <!--  Email Form -->
                <div id="step1" class="step">
                    <h3 class="mb-2 text-primary-blue fw-bold">Reset password</h3>
                    <p class="text-muted small mb-4">Enter your email address and we'll send you a verification code.</p>

                    <form id="emailForm">
                        <div class="mb-3">
                            <div class="input-group mt-2">
                                <input type="email" name="email" class="form-control py-2" id="resetEmail" placeholder="Enter your email" required>
                            </div>
                            <div class="invalid-feedback" id="emailError"></div>
                        </div>
                        <button type="submit" id="sendCodeBtn" class="btn btn-primary w-100 py-2 mb-4 fw-bold rounded-pill">Send verification code</button>
                    </form>
                </div>

                <!-- Code Verification Form -->
                <div id="step2" class="step" style="display:none;">
                    <h3 class="mb-2 text-primary-blue fw-bold">Verify code</h3>
                    <p class="text-muted small mb-4">We sent a verification code to <span id="userEmailDisplay"></span>. Please enter it below.</p>

                    <form id="codeForm">
                        <div class="mb-3">
                            <div class="input-group mt-2">
                                <input type="number" name="code" class="form-control py-2" id="verificationCode" placeholder="Enter 6-digit code" required>
                            </div>
                            <div class="invalid-feedback" id="codeError"></div>
                        </div>
                        <button type="submit" id="verifyCodeBtn" class="btn btn-primary w-100 py-2 mb-3 fw-bold rounded-pill">Verify code</button>
                        <button type="button" id="backToEmailBtn" class="btn btn-outline-secondary w-100 py-2 fw-bold rounded-pill">Back to email</button>
                    </form>
                </div>

                <!-- Reset Password Form -->
                <div id="step3" class="step" style="display:none;">
                    <h3 class="mb-2 text-primary-blue fw-bold">Create new password</h3>
                    <p class="text-muted small mb-4">Enter your new password below.</p>

                    <form id="resetPasswordForm">
                        <div class="mb-3">
                            <div class="input-group mt-2">
                                <input type="password" name="newPassword" class="form-control py-2" id="newPassword" placeholder="New password" required>
                            </div>
                            <div class="invalid-feedback" id="newPasswordError"></div>
                            <small class="text-muted" id="passwordRequirements"></small>
                        </div>

                        <div class="mt-2">
                            <small class="password-requirement d-block" id="lengthReq">
                                <i class="bi bi-circle" id="lengthIcon"></i>
                                <span id="lengthText">Minimum 6 characters</span>
                            </small>
                            <small class="password-requirement d-block" id="lowercaseReq">
                                <i class="bi bi-circle" id="lowercaseIcon"></i>
                                <span id="lowercaseText">One lowercase letter</span>
                            </small>
                            <small class="password-requirement d-block" id="uppercaseReq">
                                <i class="bi bi-circle" id="uppercaseIcon"></i>
                                <span id="uppercaseText">One uppercase letter</span>
                            </small>
                            <small class="password-requirement d-block" id="numberReq">
                                <i class="bi bi-circle" id="numberIcon"></i>
                                <span id="numberText">One number</span>
                            </small>
                            <small class="password-requirement d-block" id="symbolReq">
                                <i class="bi bi-circle" id="symbolIcon"></i>
                                <span id="symbolText">One symbol</span>
                            </small>
                        </div>

                        <div class="mb-3">
                            <div class="input-group mt-2">
                                <input type="password" name="confirmPassword" class="form-control py-2" id="confirmPassword" placeholder="Confirm new password" required>
                            </div>
                            <div class="invalid-feedback" id="confirmPasswordError"></div>
                        </div>

                        <button type="submit" id="resetPasswordBtn" class="btn btn-primary w-100 py-2 mb-3 fw-bold rounded-pill">Reset password</button>
                        <button type="button" id="backToCodeBtn" class="btn btn-outline-secondary w-100 py-2 fw-bold rounded-pill">Back to code</button>
                    </form>
                </div>

                <!-- Success Message -->
                <div id="successMessage" class="text-center" style="display:none;">
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle"></i> Password reset successfully!
                    </div>
                    <a href="@Url.Action("LoginForm", "Profile")" class="btn btn-primary rounded-pill">Go to Login</a>
                </div>

            </div>
        </div>
    </div>
</div>