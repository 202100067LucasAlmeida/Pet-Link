@model PetLink.Models.User
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container mt-4 d-flex flex-column justify-content-center align-items-center">
    <div class="text-center mb-3">
        <h1 class="display-6 text-primary-blue fw-bold">
            <i class="text-primary me-2">
                <img src="~/images/logo.png" alt="PetLink Logo" height="40"
                     class="d-inline-block align-text-top me-2" />
            </i>PETLINK
        </h1>
        <p class="text-muted">Forgot my password.</p>
    </div>

    <div class="p-3">
        @* Card com fundo e bordas dinâmicas *@
        <div class="card shadow-sm"
             style="background-color: var(--petlink-card-bg); border: 2px solid var(--petlink-primary); border-radius: 50px; width: 400px;">
            <div class="card-body p-4 p-md-5">

                <div id="step1" class="step">
                    <h3 class="mb-2 text-primary-blue fw-bold">Reset password</h3>
                    <p class="text-muted small mb-4">
                        Enter your email and we’ll send you a reset link.
                    </p>

                    <form id="emailForm">
                        <div class="mb-3">
                            <input type="email"
                                   name="email"
                                   class="form-control py-2"
                                   id="resetEmail"
                                   placeholder="Enter your email"
                                   required>

                            <div class="invalid-feedback" id="emailError"></div>
                        </div>

                        <button type="submit"
                                id="sendCodeBtn"
                                class="btn btn-primary w-100 py-2 mb-2 fw-bold rounded-pill">
                            Send Email
                        </button>
                    </form>
                </div>

                <div id="step2" class="step" style="display:none;">
                    <h3 class="mb-2 text-primary-blue fw-bold">Check your email</h3>

                    <p class="text-muted small mb-4">
                        If the email exists, we sent a reset link.
                    </p>

                    <button type="button"
                            class="btn btn-outline-secondary w-100 py-2 fw-bold rounded-pill"
                            onclick="goToStep3()">
                        I already have the link
                    </button>
                </div>

                <div id="step3" class="step" style="display:none;">
                    <h3 class="mb-2 text-primary-blue fw-bold">New password</h3>
                    <p class="text-muted small mb-4">
                        Enter your new password below.
                    </p>

                    <form id="resetPasswordForm" method="post" action="/Profile/ResetPassword">

                        <input type="hidden" name="token" id="resetToken" />

                        <div class="mb-3">
                            <input type="password"
                                   name="newPassword"
                                   class="form-control py-2"
                                   id="newPassword"
                                   placeholder="New password"
                                   required>

                            <div class="invalid-feedback" id="newPasswordError"></div>
                        </div>

                        @* Requisitos Dinâmicos *@
                        <div class="mt-2 mb-3">
                            <small class="password-requirement d-block" id="lengthReq"
                                   style="color: var(--petlink-dark); opacity: 0.7;">
                                <i class="bi bi-circle" id="lengthIcon"></i> <span id="lengthText">Minimum 6
                                characters</span>
                            </small>
                            <small class="password-requirement d-block" id="lowercaseReq"
                                   style="color: var(--petlink-dark); opacity: 0.7;">
                                <i class="bi bi-circle" id="lowercaseIcon"></i> <span id="lowercaseText">One lowercase
                                letter</span>
                            </small>
                            <small class="password-requirement d-block" id="uppercaseReq"
                                   style="color: var(--petlink-dark); opacity: 0.7;">
                                <i class="bi bi-circle" id="uppercaseIcon"></i> <span id="uppercaseText">One uppercase
                                letter</span>
                            </small>
                            <small class="password-requirement d-block" id="numberReq"
                                   style="color: var(--petlink-dark); opacity: 0.7;">
                                <i class="bi bi-circle" id="numberIcon"></i> <span id="numberText">One number</span>
                            </small>
                            <small class="password-requirement d-block" id="symbolReq"
                                   style="color: var(--petlink-dark); opacity: 0.7;">
                                <i class="bi bi-circle" id="symbolIcon"></i> <span id="symbolText">One symbol</span>
                            </small>
                        </div>

                        <div class="mb-3">
                            <input type="password" name="confirmPassword" class="form-control py-2" id="confirmPassword"
                                   style="background-color: var(--petlink-grey-bg); color: var(--petlink-dark); border: 1px solid var(--petlink-border);"
                                   placeholder="Confirm new password" required>
                            <div class="invalid-feedback" id="confirmPasswordError"></div>
                        </div>

                        <button type="submit" id="resetPasswordBtn"
                                class="btn btn-primary w-100 py-2 mb-3 fw-bold rounded-pill">Reset password</button>
                        <button type="button" id="backToCodeBtn"
                                class="btn btn-outline-secondary w-100 py-2 fw-bold rounded-pill text-primary-darkblue">Back</button>
                    </form>
                </div>

                <div id="successMessage" class="text-center" style="display:none;">
                    <div class="alert alert-success rounded-4 border-0 mb-4">
                        <i class="bi bi-check-circle-fill fs-2 d-block mb-2"></i>
                        <span class="fw-bold">Password reset successfully!</span>
                    </div>
                    <a href="@Url.Action("LoginForm", "Profile")"
                       class="btn btn-primary w-100 rounded-pill py-2 fw-bold">Go to Login</a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("emailForm").addEventListener("submit", async function(e) {
            e.preventDefault();

            const email = document.getElementById("resetEmail").value;

            await fetch("/Profile/ForgotPassword", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ email })
            });

            document.getElementById("step1").style.display = "none";
            document.getElementById("step2").style.display = "block";
        });

        window.onload = function () {
            const urlParams = new URLSearchParams(window.location.search);
            const token = urlParams.get("token");

            if (token) {
                document.getElementById("step1").style.display = "none";
                document.getElementById("step2").style.display = "none";
                document.getElementById("step3").style.display = "block";

                document.getElementById("resetToken").value = token;
            }
        };
    </script>
}