@{
    ViewData["Title"] = "Log In";
}

<div class="row justify-content-center">

    @* Intro com a marca *@
    <div class="text-center m-4 mt-5">
        <h1 class="display-6 text-primary-blue fw-bold">
            <i class=" text-primary me-2"><img src="~/images/logo.png" alt="PetLink Logo" height="40"
                                               class="d-inline-block align-text-top me-2">
            </i>PETLINK
        </h1>
        <p class="text-muted">Welcome back! We missed you. :)</p>
    </div>

    <div class="col-md-8 col-lg-5 m-4">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">

                @* Título do formulário *@
                <h3 class="mb-2 text-primary-blue fw-bold">Log In</h3>
                <p class="text-muted small mb-4">Enter your credentials to access your account.</p>

                @* Mensagem de erro caso o login falhe *@
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger text-center rounded-3 small fw-semibold">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                    </div>
                }

                @* POST para o ProfileController e action LoginForm *@
                <form asp-controller="Profile" asp-action="LoginForm" method="post">
                    <div class="mb-3">
                        <label for="email" class="form-label fw-semibold">Email Address</label>
                        <input type="email" name="email" class="form-control py-2" id="email"
                               placeholder="jane@example.com" required>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label for="password" class="form-label fw-semibold mb-0">Password</label>

                            @* Link prático para recuperar password *@
                            <a href="#" class="small text-decoration-none text-primary-lightblue">Forgot Password?</a>
                        </div>

                        <input type="password" name="password" class="form-control py-2 mt-2" id="password"
                               placeholder="**********" required>
                    </div>

                    <div class="mb-4 form-check">
                        <input type="checkbox" name="rememberMe" value="true" class="form-check-input" id="rememberMe">
                        <label class="form-check-label small" for="rememberMe">Remember me</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 mb-4 fw-bold rounded-pill">Log In</button>

                    @* Separador visual "OR" *@
                    <div class="text-center mb-4 position-relative">
                        <hr class="text-muted">
                        <span
                            class="bg-white px-2 position-absolute top-50 start-50 translate-middle small text-muted">OR
                            CONTINUE WITH
                        </span>
                    </div>

                    @* Botões de Social Login *@
                    <div class="d-flex gap-3 justify-content-center mb-4">
                        <button type="button" class="btn btn-outline-secondary w-50 rounded-pill py-2">
                            <i class="bi bi-google"></i> Google
                        </button>

                        <button type="button" class="btn btn-outline-secondary w-50 rounded-pill py-2">
                            <i class="bi bi-github"></i> GitHub
                        </button>
                    </div>

                    <div class="text-center">
                        <p class="mb-0 small">
                            Don't have an account? <a asp-controller="Profile" asp-action="SignUpForm"
                                                      class="text-primary fw-semibold text-decoration-none">Sign up for free</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>

        @* Ícones de confiança no fundo (com icons do Bootstrap) *@
        <div class="d-flex justify-content-center gap-4 mt-4 small text-muted fw-semibold">
            <span><i class="bi bi-shield-lock"></i> SECURE</span>
            <span><i class="bi bi-check-circle"></i> VERIFIED</span>
            <span><i class="bi bi-incognito"></i> PRIVACY</span>
        </div>
    </div>
</div>