@{
    ViewData["Title"] = "Help Center";
}

<div class="container py-4" style="font-family: var(--font-display);">
    <div class="row">
        @* Sidebar Comum *@
        <div class="col-lg-3 mb-4">
            @await Html.PartialAsync("~/Views/Shared/UserSideBar.cshtml")
        </div>

        @* Conteúdo Principal *@
        <div class="col-lg-9" style="padding-top: 50px;">
            @* Header & Search *@
            <div class="text-center mb-5">
                <h1 class="display-5 fw-bold text-primary-darkblue mb-3" style="font-family: var(--font-primary);">
                    How can we help you and your companion?
                
            </div>

            @* Top Topics Cards *@
            <div class="row g-4 mb-5">
                <div class="col-md-8">
                        <a asp-controller="Home" asp-action="HowItWorks" class="text-decoration-none">
                            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 position-relative overflow-hidden hover-lift" 
                                style="background-color: var(--petlink-card-bg);">
                                <i class="bi bi-arrow-up-right position-absolute top-0 end-0 m-4 text-secondary-grey opacity-50"></i>
                                <div class="p-2 bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 50px; height: 50px;">
                                    <i class="bi bi-paw-fill text-primary fs-4"></i>
                                </div>
                                <h3 class="h4 fw-bold text-primary-darkblue mb-3">Adoption Process</h3>
                                <p class="text-secondary-grey small">From meeting your new best friend to the final paperwork. Learn about our curated matching system and home visit guidelines.</p>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a asp-controller="Home" asp-action="Policies" class="text-decoration-none">
                            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-white hover-lift" 
                                style="background-color: var(--petlink-dark);">
                                <div class="p-2 bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 50px; height: 50px; background-color: var(--petlink-highlight);">
                                    <i class="bi bi-shield-check text-white fs-4"></i>
                                </div>
                                <h3 class="h4 fw-bold mb-3" style="color: var(--petlink-grey-bg);">Trust & Safety</h3>
                                <p class="small opacity-75" style="color: var(--petlink-grey-bg);">Our sanctuary guidelines, verification protocols, and community standards for a safe environment.</p>
                            </div>
                        </a>
                    </div>
                </div>
                
                @* Secondary Topic Cards *@
                <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 text-center" style="background-color: var(--petlink-card-bg);">
                    <i class="bi bi-house-heart text-primary fs-3 mb-3"></i>
                    <h5 class="fw-bold text-primary-darkblue">Sitter Tips</h5>
                    <p class="extra-small text-secondary-grey">Always confirm the pet's routine, feeding schedule, and any medical needs before the stay. Keep the owner updated with photos and messages.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 text-center" style="background-color: var(--petlink-card-bg);">
                    <i class="bi bi-person-gear text-primary fs-3 mb-3"></i>
                    <h5 class="fw-bold text-primary-darkblue">Account Issues</h5>
                    <p class="extra-small text-secondary-grey">To update your email or password, go to Account Settings. If you've lost access, use the "Forgot Password" option on the login page.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 text-center" style="background-color: var(--petlink-card-bg);">
                    <i class="bi bi-bug text-danger fs-3 mb-3"></i>
                    <h5 class="fw-bold text-primary-darkblue">Troubleshooting</h5>
                    <p class="extra-small text-secondary-grey">If the page isn't loading correctly, try clearing your browser cache or reloading. For persistent issues, contact our support team.</p>
                </div>
            </div>

            @* Popular Questions *@
            <div class="mb-5">
                <h2 class="h4 fw-bold text-primary-darkblue text-center mb-4">Popular Questions</h2>
                <div class="accordion d-grid gap-3" id="faqAccordion">
                    
                    <div class="accordion-item border-0 shadow-sm rounded-4 overflow-hidden" style="background-color: var(--petlink-card-bg);">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-primary-darkblue rounded-4" 
                                    type="button" data-bs-toggle="collapse" data-bs-target="#faq1"
                                    style="background-color: var(--petlink-card-bg);">
                                01. What is the typical adoption timeline?
                            </button>
                        </h2>
                        <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-secondary-grey">
                                The adoption process typically takes between 3 to 14 days. After submitting your request, the shelter reviews your application within 2–5 business days. If approved, you'll be contacted to arrange a meet-and-greet before finalising the adoption.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border-0 shadow-sm rounded-4 overflow-hidden" style="background-color: var(--petlink-card-bg);">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-primary-darkblue rounded-4" 
                                    type="button" data-bs-toggle="collapse" data-bs-target="#faq2"
                                    style="background-color: var(--petlink-card-bg);">
                                02. How do I verify my home for petsitting?
                            </button>
                        </h2>
                        <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-secondary-grey">
                                To become a verified petsitter on PetLink, go to your Account Settings and complete your petsitter profile. Our team will review your application and may request photos of your space. Verification usually takes 2–3 business days.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border-0 shadow-sm rounded-4 overflow-hidden" style="background-color: var(--petlink-card-bg);">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-primary-darkblue rounded-4" 
                                    type="button" data-bs-toggle="collapse" data-bs-target="#faq3"
                                    style="background-color: var(--petlink-card-bg);">
                                03. Can I change my listed location after joining?
                            </button>
                        </h2>
                        <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-secondary-grey">
                                Yes! You can update your location at any time by going to Account Settings and editing your profile. Changes are reflected immediately across the platform.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border-0 shadow-sm rounded-4 overflow-hidden" style="background-color: var(--petlink-card-bg);">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-primary-darkblue rounded-4" 
                                    type="button" data-bs-toggle="collapse" data-bs-target="#faq4"
                                    style="background-color: var(--petlink-card-bg);">
                                04. PetLink Trust: Is my data shared with agencies?
                            </button>
                        </h2>
                        <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-secondary-grey">
                                No. PetLink does not sell or share your personal data with third-party agencies. Your information is only used to facilitate the adoption and petsitting process within our platform. For more details, please read our <a asp-controller="Home" asp-action="Policies" class="text-primary-darkblue">Policies & Protections</a> page.
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            @* Final Support CTA *@
            <div class="card border-0 rounded-5 p-5 text-white overflow-hidden position-relative" 
                 style="background-color: var(--petlink-dark);">
                <div class="row align-items-center position-relative" style="z-index: 2;">
                    <div class="col-lg-6">
                        <h2 class="display-6 fw-bold mb-3" style="font-family: var(--font-primary); color: var(--petlink-grey-bg);">Still need a paw?</h2>
                        <p class="opacity-75 mb-4" style="color: var(--petlink-grey-bg);">Our support team of pet lovers is available 24/7 to assist you with complex cases or technical issues.</p>
                        <div class="d-flex flex-column flex-sm-row gap-3">
                            <a href="mailto:support@petlink.com" 
                            class="btn btn-primary rounded-pill px-4 py-2 fw-bold d-flex align-items-center justify-content-center gap-2" 
                            style="background-color: var(--petlink-highlight);">
                                <i class="bi bi-chat-dots-fill"></i> Contact Support
                            </a>
                            
                        </div>
                    </div>
                    <div class="col-lg-6 text-center mt-4 mt-lg-0">
                        <img src="~/images/logo.png" alt="Support" class="img-fluid" style="max-height: 250px;">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-lift { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .hover-lift:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; }
    .extra-small { font-size: 0.75rem; }
    
    html.dark-mode .bg-light { background-color: var(--petlink-grey-bg) !important; }
</style>