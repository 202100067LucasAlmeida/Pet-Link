@model PetLink.Models.User
@{
    ViewData["Title"] = "Account Settings";
}

<div class="container py-4">
    <div class="row">

        <div class="col-lg-3 mb-4">
            @await Html.PartialAsync("~/Views/Shared/UserSideBar.cshtml")
        </div>

        <div class="col-lg-9">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h3 class="mb-3 text-primary-darkblue">Account Settings</h3>
                    <p class="text-muted small mb-4">Manage your account preferences, security, and payment information.
                    </p>

                    <ul class="nav nav-pills mb-4 pb-2 border-bottom h-sidebar">
                        <li class="nav-item">
                            <a class="nav-link active" asp-controller="Profile" asp-action="AccountSettings">Profile
                                Information</a>
                            </li>
                            <li class="nav-item"><a class="nav-link" href="#">Notifications</a></li>
                            <li class="nav-item"><a class="nav-link" href="#">Security</a></li>
                            <li class="nav-item"><a class="nav-link" href="#">Payment Methods</a></li>
                        </ul>

                        @* Envolvemos tudo num FORM para enviar para o backend de uma só vez *@
                        <form asp-controller="Profile" asp-action="UpdateAccount" method="post"
                              enctype="multipart/form-data">
                            <input type="hidden" asp-for="Id" />
                        
                            <div class="mb-5 details-sec">
                                <h4 class="mb-4 text-primary-darkblue">Personal Details</h4>

                                <div class="row mb-3 align-items-center">
                                    <div class="col-sm-3">
                                        <span class="text-muted">Full Name:</span>
                                    </div>
                                    <div class="col-sm-9">
                                        <input type="text" asp-for="Name" class="form-control" placeholder="Your full name"
                                               required>
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-3">
                                            <span class="text-muted">Phone Number:</span>
                                        </div>
                                        <div class="col-sm-9">
                                            <input type="tel" asp-for="Phone" class="form-control"
                                                   placeholder="Your phone number">
                                            </div>
                                        </div>

                                        <div class="row mb-3 align-items-center">
                                            <div class="col-sm-3">
                                                <span class="text-muted">Email Address:</span>
                                            </div>
                                            <div class="col-sm-9">
                                                <input type="email" asp-for="Email" class="form-control" readonly
                                                       style="background-color: #f8f9fa;">
                                                    <small class="text-muted" style="font-size: 0.7rem;">Email cannot be changed
                                                        here.</small>
                                                    </div>
                                                </div>

                                                <div class="row mb-3 align-items-center">
                                                    <div class="col-sm-3">
                                                        <span class="text-muted">Location:</span>
                                                    </div>
                                                    <div class="col-sm-9">
                                                        <input type="text" asp-for="Location" class="form-control"
                                                               placeholder="Your city or region">
                                                        </div>
                                                    </div>
                                                </div>

                                                <hr class="my-4">

                                                <div class="mb-5">
                                                    <h4 class="mb-4 text-primary-darkblue">Profile Picture</h4>

                                                    <div class="d-flex align-items-start gap-4">
                                                        <div class="position-relative">
                                                            @* Mostra a foto da BD ou o icon padrão *@
                                                            @if (!string.IsNullOrEmpty(Model?.ProfilePicture))
                                                            {
                                                                <img id="profilePreview" src="@Model.ProfilePicture"
                                                                     class="rounded-circle shadow-sm"
                                                                     style="width: 100px; height: 100px; object-fit: cover;" />
                                                            }
                                                            else
                                                            {
                                                                <div id="defaultAvatarIcon"
                                                                     class="bg-light rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                                                                     style="width: 100px; height: 100px;">
                                                                    <i class="bi bi-person-circle fs-1 text-secondary"></i>
                                                                </div>
                                                                <img id="profilePreview" src="" class="rounded-circle shadow-sm d-none"
                                                                     style="width: 100px; height: 100px; object-fit: cover;" />
                                                            }
                                                        </div>

                                                        <div class="flex-grow-1">
                                                            <div class="mb-3">
                                                                @* Campo de ficheiro escondido *@
                                                                <input type="file" id="profilePictureInput" name="profilePicture"
                                                                       accept="image/jpeg, image/png, image/gif" class="d-none"
                                                                       onchange="previewImage(event)">
                                        
                                                                @* Botão bonito que clica no campo escondido *@
                                                                <button type="button" class="btn btn-primary btn-sm me-2"
                                                                        onclick="document.getElementById('profilePictureInput').click()">
                                                                    <i class="bi bi-upload me-1"></i>Upload New Photo
                                                                </button>
                                        
                                                                <button type="button" class="btn btn-outline-danger btn-sm"
                                                                        onclick="removePreview()">
                                                                    <i class="bi bi-trash me-1"></i>Remove
                                                                </button>
                                                            </div>
                                                            <p class="text-muted small mb-0">
                                                                <i class="bi bi-info-circle me-1"></i>
                                                                JPG, GIF or PNG. Max size of 2MB
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>

                                                <hr class="my-4">

                                                <div class="mb-4 about-me-sec">
                                                    <h4 class="mb-4 text-primary-darkblue">About Me</h4>

                                                    <div class="mb-4">
                                                        <label class="form-label fw-medium">Bio</label>
                                                        @* Aqui sim usamos Textarea *@
                                                        <textarea asp-for="Bio" class="form-control" rows="4"
                                                                  placeholder="Tell us a bit about yourself..."></textarea>
                                                        <div class="form-text">
                                                            Brief description for your profile. This helps shelters know more about you.
                                                        </div>
                                                    </div>

                                                    <div class="d-flex gap-2">
                                                        <button type="submit" class="btn btn-primary px-4 fw-bold">
                                                            <i class="bi bi-check-lg me-1"></i>Save Changes
                                                        </button>
                                                        <a asp-action="AccountSettings" class="btn btn-outline-secondary px-4">
                                                            Cancel
                                                        </a>
                                                    </div>
                                                </div>
                                            </form>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @section Scripts {
                            <script>
                                // Função para mostrar a imagem assim que o utilizador escolhe o ficheiro
                                function previewImage(event) {
                                    var reader = new FileReader();
                                    reader.onload = function () {
                                        var output = document.getElementById('profilePreview');
                                        var icon = document.getElementById('defaultAvatarIcon');
                
                                        output.src = reader.result;
                                        output.classList.remove('d-none');
                
                                        if (icon) {
                                            icon.classList.add('d-none');
                                        }
                                    }
                                    if (event.target.files[0]) {
                                        reader.readAsDataURL(event.target.files[0]);
                                    }
                                }

                                // Função para limpar a imagem selecionada
                                function removePreview() {
                                    document.getElementById('profilePictureInput').value = "";
                                    document.getElementById('profilePreview').src = "@(!string.IsNullOrEmpty(Model?.ProfilePicture) ? Model.ProfilePicture : "")";
            
                                    @if (string.IsNullOrEmpty(Model?.ProfilePicture))
                                        {
                                            <text>
                                                    document.getElementById('profilePreview').classList.add('d-none');
                                                    document.getElementById('defaultAvatarIcon').classList.remove('d-none');
                                            </text>
                                    }
                                                            }
                            </script>
                        }