@model PetLink.Models.User
@{
    ViewData["Title"] = "Account Settings";
}

<div class="container py-4">
    <div class="row">

        <div class="col-lg-3 mb-4">
            @await Html.PartialAsync("~/Views/Shared/UserSideBar.cshtml")
        </div>

        <div class="col-lg-9">
            @* Card com fundo dinâmico *@
            <div class="card border-0 shadow-sm" style="background-color: var(--petlink-card-bg);">
                <div class="card-body p-4">
                    <h3 class="mb-3 text-primary-darkblue">Account Settings</h3>
                    <p class="text-secondary-grey small mb-4">Manage your account preferences, security, and payment
                        information.
                    </p>

                    @* Tabs de Navegação Dinâmicas *@
                    <ul class="nav nav-pills mb-4 pb-2 border-bottom"
                        style="border-color: var(--petlink-border) !important;">
                        <li class="nav-item">
                            <a class="nav-link active" asp-controller="Profile" asp-action="AccountSettings">Profile
                                Information
                            </a>
                        </li>
                        <li class="nav-item"><a class="nav-link text-primary-darkblue" href="#">Notifications</a></li>
                        <li class="nav-item"><a class="nav-link text-primary-darkblue" href="#">Security</a></li>
                        <li class="nav-item"><a class="nav-link text-primary-darkblue" href="#">Payment Methods</a></li>
                    </ul>

                    <div class="col-sm-9">
                        <button onclick="getAccurateLocation()" class="btn btn-sm btn-outline-primary rounded-pill mt-2">
                            <i class="bi bi-geo-alt me-1"></i>Update my location
                        </button>
                        <p class="text-muted small">If the first try isn't correct, try again, and make sure the location is accurate.</p>
                        <p id="ipDetails"></p>
                    </div>

                    <form asp-controller="Profile" asp-action="UpdateAccount" method="post"
                          enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" id="removePhotoFlag" name="removePhoto" value="false" />

                        <div class="mb-5 details-sec">
                            <h4 class="mb-4 text-primary-darkblue">Personal Details</h4>

                            @* Input Nome *@
                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-3">
                                    <span class="text-secondary-grey">Full Name:</span>
                                </div>
                                <div class="col-sm-9">
                                    <input type="text" asp-for="Name" class="form-control"
                                           style="background-color: var(--petlink-grey-bg); color: var(--petlink-dark); border: 1px solid var(--petlink-border);"
                                           placeholder="Your full name" required />
                                </div>
                            </div>

                            @* Input Telefone *@
                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-3">
                                    <span class="text-secondary-grey">Phone Number:</span>
                                </div>
                                <div class="col-sm-9">
                                    <input type="tel" asp-for="Phone" class="form-control"
                                           style="background-color: var(--petlink-grey-bg); color: var(--petlink-dark); border: 1px solid var(--petlink-border);"
                                           placeholder="Your phone number" />
                                </div>
                            </div>

                            @* Input Email (Readonly) *@
                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-3">
                                    <span class="text-secondary-grey">Email Address:</span>
                                </div>
                                <div class="col-sm-9">
                                    <input type="email" asp-for="Email" class="form-control" readonly
                                           style="background-color: var(--petlink-light-bg); color: var(--petlink-dark); border: 1px solid var(--petlink-border); opacity: 0.8;" />
                                    <small class="text-secondary-grey" style="font-size: 0.7rem;">Email cannot be
                                        changed here.
                                    </small>
                                </div>
                            </div>

                            @* Input Localização *@
                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-3">
                                    <span class="text-secondary-grey">Location:</span>
                                </div>

                                <div class="col-sm-9">
                                    <input type="text" asp-for="City" class="form-control"
                                           style="background-color: var(--petlink-grey-bg); color: var(--petlink-dark); border: 1px solid var(--petlink-border);"
                                           placeholder="@(Model?.City)" />
                                    <input type="text" id="latField" name="Lat" value="@(Model?.GetLatitude())"/>
                                    <input type="text" id="lonField" name="Lon" value="@(Model?.GetLongitude())"/>
                                </div>

                                <p class="text-muted small">To update your location, just click on "Update my location" and verify the data retrieved.</p>
                            </div>
                        </div>

                        <hr class="my-4" style="border-color: var(--petlink-border); opacity: 0.2;">

                        @* Profile Picture Section *@
                        <div class="mb-5">
                            <h4 class="mb-4 text-primary-darkblue">Profile Picture</h4>

                            <div class="d-flex align-items-start gap-4">
                                <div class="position-relative">
                                    @* Avatar Placeholder Dinâmico *@
                                    <div id="defaultAvatarIcon"
                                         class="@(!string.IsNullOrEmpty(Model?.ProfilePicture) && Model.ProfilePicture != "/images/default-avatar.jpg" ? "d-none" : "") rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                                         style="width: 100px; height: 100px; background-color: var(--petlink-grey-bg);">
                                        <i class="bi bi-person-circle fs-1" style="color: var(--petlink-primary);"></i>
                                    </div>
            
                                    <img id="profilePreview"
                                         src="@(string.IsNullOrEmpty(Model?.ProfilePicture) ? "" : Model.ProfilePicture)"
                                         class="@(string.IsNullOrEmpty(Model?.ProfilePicture) || Model.ProfilePicture == "/images/default-avatar.jpg" ? "d-none" : "") rounded-circle shadow-sm"
                                         style="width: 100px; height: 100px; object-fit: cover; border: 2px solid var(--petlink-primary);"
                                         onerror="this.style.display='none'" />
                                </div>

                                <div class="flex-grow-1">
                                    <div class="mb-3">
                                        <input type="file" id="profilePictureInput" name="profilePicture"
                                               accept="image/jpeg, image/png, image/gif" class="d-none"
                                               onchange="previewImage(event)">
        
                                        <button type="button" class="btn btn-primary btn-sm me-2 rounded-pill px-3"
                                                onclick="document.getElementById('profilePictureInput').click()">
                                            <i class="bi bi-upload me-1"></i>Upload Photo
                                        </button>
        
                                        <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                                onclick="handleRemovePhoto()">
                                            <i class="bi bi-trash me-1"></i>Remove
                                        </button>
                                    </div>
                                    <p class="text-secondary-grey small mb-0">
                                        <i class="bi bi-info-circle me-1"></i>
                                        JPG, GIF or PNG. Max 2MB.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" style="border-color: var(--petlink-border); opacity: 0.2;">

                        @* Bio Section *@
                        <div class="mb-4 about-me-sec">
                            <h4 class="mb-4 text-primary-darkblue">About Me</h4>

                            <div class="mb-4">
                                <label class="form-label fw-medium text-primary-darkblue">Bio</label>
                                <textarea asp-for="Bio" class="form-control" rows="4"
                                          style="background-color: var(--petlink-grey-bg); color: var(--petlink-dark); border: 1px solid var(--petlink-border);"
                                          placeholder="Tell us a bit about yourself..."></textarea>
                                <div class="form-text text-secondary-grey">
                                    Brief description for your profile. This helps shelters know more about you.
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                                    <i class="bi bi-check-lg me-1"></i>Save Changes
                                </button>
                                <a asp-action="AccountSettings"
                                   class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script src="~/js/location.js" asp-append-version="true"></script>

    <script>
        function previewImage(event) {
            var reader = new FileReader();
            reader.onload = function () {
                var output = document.getElementById('profilePreview');
                var icon = document.getElementById('defaultAvatarIcon');
                var removeFlag = document.getElementById('removePhotoFlag');

                output.src = reader.result;
                output.classList.remove('d-none');
                output.style.display = 'block';
                icon.classList.add('d-none');
                removeFlag.value = "false";
            }
            if (event.target.files[0]) {
                reader.readAsDataURL(event.target.files[0]);
            }
        }

        function handleRemovePhoto() {
            document.getElementById('profilePictureInput').value = "";
            var output = document.getElementById('profilePreview');
            var icon = document.getElementById('defaultAvatarIcon');
            output.src = "";
            output.classList.add('d-none');
            icon.classList.remove('d-none');
            document.getElementById('removePhotoFlag').value = "true";
        }
    </script>
}