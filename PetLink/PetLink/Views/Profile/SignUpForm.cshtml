﻿@{
    ViewData["Title"] = "Sign Up";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.css" />

<div class="row justify-content-center">

    <div class="text-center m-4 mt-5">
        <h1 class="display-6 text-primary-blue fw-bold">
            <i class="text-primary me-2">
                <img src="~/images/logo.png" alt="PetLink Logo" height="40"
                     class="d-inline-block align-text-top me-2">
            </i>PETLINK
        </h1>
        <p class="text-muted">Connecting pets with loving homes</p>
    </div>

    <div class="col-md-8 col-lg-6 m-4 mt-0">
        <div class="card shadow-sm rounded-4" style="border: 2px solid var(--petlink-primary); border-radius: 50px;">
            <div class="card-body p-4 p-md-5">

                @* Título do formulário *@
                <h3 class="h4 mb-2 text-dark fw-bold">Create your account</h3>
                <p class="text-muted small mb-4">Join our community of pet lovers and professionals.</p>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success text-center rounded-3 small fw-semibold mb-4">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    </div>
                }

                <div id="successContainer" class="alert alert-success text-center rounded-3 small fw-semibold mb-4" style="display: none;">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <span id="successMessage"></span>
                    <br>
                    <a asp-controller="Profile" asp-action="LoginForm" class="btn btn-sm btn-success mt-2 rounded-pill fw-bold px-4">Go to Login</a>
                </div>

                <div id="errorContainer" class="alert alert-danger text-center rounded-3 small fw-semibold mb-4" style="display: none;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <span id="errorMessage"></span>
                </div>

                <div id="fieldErrors" class="mb-3"></div>

                @* Formulário aponta para Profile / SignUpForm *@
                <form id="signupForm" asp-controller="Profile" asp-action="SignUpForm" method="post" novalidate>
                    <div class="mb-3">
                        <label for="fullName" class="form-label fw-semibold">Full Name</label>
                        <input type="text" name="fullName" class="form-control py-2" id="fullName"
                               placeholder="Jane Doe" value="@ViewBag.FullName" required>
                        <div class="invalid-feedback" id="fullNameError"></div>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label fw-semibold">Email Address</label>
                        <div class="position-relative">
                            <input type="email" name="email" class="form-control py-2" id="email"
                                placeholder="jane@example.com" value="@ViewBag.Email" required>
                            <div id="emailLoading" class="spinner-border spinner-border-sm text-primary position-absolute" role="status" style="right: 15px; top: 12px; display: none;">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                        <div class="invalid-feedback" id="emailError"></div>
                        <div class="valid-feedback fw-semibold" id="emailSuccess" style="display: none;">
                            <i class="bi bi-check-circle-fill"></i> Email is available!
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="phone" class="form-label fw-semibold">Phone Number</label>
                        <div class="w-100">
                            <input type="tel" name="phone" class="form-control py-2 w-100" id="phone"
                                   placeholder="912 345 678" value="@ViewBag.Phone" required style="width: 100%;">
                        </div>
                        <div class="invalid-feedback" id="phoneError"></div>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label fw-semibold">Password</label>
                        <div class="input-group">
                            <input type="password" name="password" class="form-control py-2 border-end-0" id="password" placeholder="**********" required>
                            <button class="btn btn-outline-secondary border border-start-0 bg-white" type="button" id="togglePassword">
                                <i class="bi bi-eye text-muted" id="togglePasswordIcon"></i>
                            </button>
                        </div>
                        <div class="invalid-feedback" id="passwordError"></div>

                        <div class="mt-2">
                            <small class="password-requirement d-block" id="lengthReq">
                                <i class="bi bi-circle" id="lengthIcon"></i>
                                <span id="lengthText">Minimum 6 characters</span>
                            </small>
                            <small class="password-requirement d-block" id="lowercaseReq">
                                <i class="bi bi-circle" id="lowercaseIcon"></i>
                                <span id="lowercaseText">One lowercase letter</span>
                            </small>
                            <small class="password-requirement d-block" id="uppercaseReq">
                                <i class="bi bi-circle" id="uppercaseIcon"></i>
                                <span id="uppercaseText">One uppercase letter</span>
                            </small>
                            <small class="password-requirement d-block" id="numberReq">
                                <i class="bi bi-circle" id="numberIcon"></i>
                                <span id="numberText">One number</span>
                            </small>
                            <small class="password-requirement d-block" id="symbolReq">
                                <i class="bi bi-circle" id="symbolIcon"></i>
                                <span id="symbolText">One symbol</span>
                            </small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label fw-semibold">Confirm Password</label>
                        <div class="input-group">
                            <input type="password" name="confirmPassword" class="form-control py-2 border-end-0" id="confirmPassword" placeholder="**********" required>
                            <button class="btn btn-outline-secondary border border-start-0 bg-white" type="button" id="toggleConfirmPassword">
                                <i class="bi bi-eye text-muted" id="toggleConfirmPasswordIcon"></i>
                            </button>
                        </div>
                        <div class="invalid-feedback" id="confirmPasswordError"></div>
                    </div>

                    <div class="mb-4 mt-4">
                        <label class="form-label fw-semibold">I am a:</label>
                        <div class="d-flex flex-wrap gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="userType" value="User" id="petOwner"
                                       @(ViewBag.UserType == "User" ? "checked" : "checked")>
                                <label class="form-check-label" for="petOwner">Pet Owner</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="userType" value="PetSitter" id="petSitter"
                                       @(ViewBag.UserType == "PetSitter" ? "checked" : "")>
                                <label class="form-check-label" for="petSitter">Pet Sitter</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="userType" value="Shelter" id="association"
                                       @(ViewBag.UserType == "Shelter" ? "checked" : "")>
                                <label class="form-check-label" for="association">Shelter / Association</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="terms" required>
                            <label class="form-check-label small" for="terms">
                                I agree to the <a href="#" class="text-primary text-decoration-none">Terms & Conditions</a>
                                and <a href="#" class="text-primary text-decoration-none">Privacy Policy</a>.
                            </label>
                            <div class="invalid-feedback" id="termsError"></div>
                        </div>
                    </div>

                    <button type="submit" id="submitBtn" class="btn btn-primary w-100 py-2 mb-4 fw-bold rounded-pill">
                        Create Account
                    </button>

                    <div class="text-center mb-4 position-relative">
                        <hr class="text-muted">
                        <span class="bg-white px-2 position-absolute top-50 start-50 translate-middle small text-muted">
                            OR CONTINUE WITH
                        </span>
                    </div>

                    <div class="d-flex gap-3 justify-content-center mb-4">
                        <button type="button" class="btn btn-outline-secondary w-50 rounded-pill py-2">
                            <i class="bi bi-google"></i> Google
                        </button>
                        <button type="button" class="btn btn-outline-secondary w-50 rounded-pill py-2">
                            <i class="bi bi-github"></i> GitHub
                        </button>
                    </div>

                    <div class="text-center">
                        <p class="mb-0 small">
                            Already have an account?
                            <a asp-controller="Profile" asp-action="LoginForm"
                               class="text-primary fw-semibold text-decoration-none">Log in</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>

        @* Ícones finais *@
        <div class="d-flex justify-content-center gap-4 mt-4 small text-muted fw-semibold">
            <span><i class="bi bi-shield-lock"></i> SECURE SSL</span>
            <span><i class="bi bi-patch-check"></i> TRUSTED PROVIDER</span>
            <span><i class="bi bi-incognito"></i> PRIVACY FIRST</span>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/intlTelInput.min.js"></script>
    
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const phoneInputField = document.querySelector("#phone");
            
            window.phoneInput = window.intlTelInput(phoneInputField, {
                preferredCountries: ["pt", "br", "gb", "us"],
                utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js",
            });
            
            document.querySelector('.iti').style.width = '100%';
        });
    </script>
}