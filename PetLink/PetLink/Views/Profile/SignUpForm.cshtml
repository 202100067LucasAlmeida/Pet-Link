﻿@{
    ViewData["Title"] = "Sign Up";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.css" />

<div class="row justify-content-center">

    <div class="text-center m-4 mt-5">
        <h1 class="display-6 text-primary-blue fw-bold">
            <i class="text-primary me-2">
                <img src="~/images/logo.png" alt="PetLink Logo" height="40"
                     class="d-inline-block align-text-top me-2" />
            </i>PETLINK
        </h1>
        <p class="text-secondary-grey">Connecting pets with loving homes</p>
    </div>

    <div class="col-md-8 col-lg-6 m-4 mt-0">
        @* Card com fundo dinâmico e borda da marca *@
        <div class="card shadow-sm rounded-4"
             style="background-color: var(--petlink-card-bg); border: 2px solid var(--petlink-primary); border-radius: 50px;">
            <div class="card-body p-4 p-md-5">

                @* Título dinâmico *@
                <h3 class="h4 mb-2 text-primary-darkblue fw-bold">Create your account</h3>
                <p class="text-secondary-grey small mb-4">Join our community of pet lovers and professionals.</p>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success text-center rounded-3 small fw-semibold mb-4">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    </div>
                }

                <div id="successContainer" class="alert alert-success text-center rounded-3 small fw-semibold mb-4"
                     style="display: none;">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <span id="successMessage"></span>
                    <br>
                    <a asp-controller="Profile" asp-action="LoginForm"
                       class="btn btn-sm btn-success mt-2 rounded-pill fw-bold px-4">Go to Login</a>
                </div>

                <div id="errorContainer" class="alert alert-danger text-center rounded-3 small fw-semibold mb-4"
                     style="display: none;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <span id="errorMessage"></span>
                </div>

                <div id="fieldErrors" class="mb-3"></div>

                <form id="signupForm" asp-controller="Profile" asp-action="SignUpForm" method="post" novalidate>
                    
                    @* Input Nome: Cores Dinâmicas *@
                    <div class="mb-3">
                        <label for="fullName" class="form-label fw-semibold text-primary-darkblue">Full Name</label>
                        <input type="text" name="fullName" class="form-control py-2" id="fullName"
                               style="background-color: var(--petlink-grey-bg); color: var(--petlink-dark); border: 1px solid var(--petlink-border);"
                               placeholder="Jane Doe" value="@ViewBag.FullName" required>
                        <div class="invalid-feedback" id="fullNameError"></div>
                    </div>

                    @* Input Email: Cores Dinâmicas *@
                    <div class="mb-3">
                        <label for="email" class="form-label fw-semibold text-primary-darkblue">Email Address</label>
                        <div class="position-relative">
                            <input type="email" name="email" class="form-control py-2" id="email"
                                   style="background-color: var(--petlink-grey-bg); color: var(--petlink-dark); border: 1px solid var(--petlink-border);"
                                   placeholder="jane@example.com" value="@ViewBag.Email" required>
                            <div id="emailLoading"
                                 class="spinner-border spinner-border-sm text-primary position-absolute" role="status"
                                 style="right: 15px; top: 12px; display: none;">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                        <div class="invalid-feedback" id="emailError"></div>
                    </div>

                    @* Input Telefone: Adaptado para intl-tel-input *@
                    <div class="mb-3">
                        <label for="phone" class="form-label fw-semibold text-primary-darkblue">Phone Number</label>
                        <div class="w-100">
                            <input type="tel" name="phone" class="form-control py-2 w-100" id="phone"
                                   style="background-color: var(--petlink-grey-bg); color: var(--petlink-dark); border: 1px solid var(--petlink-border);"
                                   placeholder="912 345 678" value="@ViewBag.Phone" required>
                        </div>
                        <div class="invalid-feedback" id="phoneError"></div>
                    </div>

                    @* Input Password: Com Toggle Dinâmico *@
                    <div class="mb-3">
                        <label for="password" class="form-label fw-semibold text-primary-darkblue">Password</label>
                        <div class="input-group">
                            <input type="password" name="password" class="form-control py-2 border-end-0" id="password"
                                   style="background-color: var(--petlink-grey-bg); color: var(--petlink-dark); border: 1px solid var(--petlink-border);"
                                   placeholder="**********" required>
                            <button class="btn border border-start-0" type="button" id="togglePassword"
                                    style="background-color: var(--petlink-grey-bg); border-color: var(--petlink-border) !important;">
                                <i class="bi bi-eye text-secondary-grey" id="togglePasswordIcon"></i>
                            </button>
                        </div>
                        <div class="invalid-feedback" id="passwordError"></div>

                        <div class="mt-2">
                            <small class="password-requirement d-block" id="lengthReq"
                                   style="color: var(--petlink-dark); opacity: 0.7;">
                                <i class="bi bi-circle" id="lengthIcon"></i> <span id="lengthText">Minimum 6
                                characters</span>
                            </small>
                            <small class="password-requirement d-block" id="lowercaseReq"
                                   style="color: var(--petlink-dark); opacity: 0.7;">
                                <i class="bi bi-circle" id="lowercaseIcon"></i> <span id="lowercaseText">One lowercase
                                letter</span>
                            </small>
                            <small class="password-requirement d-block" id="uppercaseReq"
                                   style="color: var(--petlink-dark); opacity: 0.7;">
                                <i class="bi bi-circle" id="uppercaseIcon"></i> <span id="uppercaseText">One uppercase
                                letter</span>
                            </small>
                            <small class="password-requirement d-block" id="numberReq"
                                   style="color: var(--petlink-dark); opacity: 0.7;">
                                <i class="bi bi-circle" id="numberIcon"></i> <span id="numberText">One number</span>
                            </small>
                            <small class="password-requirement d-block" id="symbolReq"
                                   style="color: var(--petlink-dark); opacity: 0.7;">
                                <i class="bi bi-circle" id="symbolIcon"></i> <span id="symbolText">One symbol</span>
                            </small>
                        </div>
                    </div>

                    @* Confirm Password *@
                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label fw-semibold text-primary-darkblue">Confirm
                            Password
                        </label>
                        <div class="input-group">
                            <input type="password" name="confirmPassword" class="form-control py-2 border-end-0"
                                   id="confirmPassword"
                                   style="background-color: var(--petlink-grey-bg); color: var(--petlink-dark); border: 1px solid var(--petlink-border);"
                                   placeholder="**********" required>
                            <button class="btn border border-start-0" type="button" id="toggleConfirmPassword"
                                    style="background-color: var(--petlink-grey-bg); border-color: var(--petlink-border) !important;">
                                <i class="bi bi-eye text-secondary-grey" id="toggleConfirmPasswordIcon"></i>
                            </button>
                        </div>
                    </div>

                    @* User Type Radio Buttons *@
                    <div class="mb-4 mt-4">
                        <label class="form-label fw-semibold text-primary-darkblue">I am a:</label>
                        <div class="d-flex flex-wrap gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="userType" value="User" id="petOwner"
                                @(ViewBag.UserType == "User" || ViewBag.UserType == null ? "checked" : "")>
                                <label class="form-check-label text-primary-darkblue" for="petOwner">Pet Owner</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="userType" value="PetSitter"
                                       id="petSitter" @(ViewBag.UserType == "PetSitter" ? "checked" : "")>
                                <label class="form-check-label text-primary-darkblue" for="petSitter">Pet Sitter</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="userType" value="Shelter"
                                       id="association" @(ViewBag.UserType == "Shelter" ? "checked" : "")>
                                <label class="form-check-label text-primary-darkblue" for="association">Shelter</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="terms" required>
                            <label class="form-check-label small text-primary-darkblue" for="terms">
                                I agree to the <a href="#" class="text-primary text-decoration-none">Terms</a> and <a
                                href="#" class="text-primary text-decoration-none">Privacy Policy</a>.
                            </label>
                        </div>
                    </div>

                    <button type="submit" id="submitBtn" class="btn btn-primary w-100 py-2 mb-4 fw-bold rounded-pill">
                        Create Account
                    </button>

                    @* Divisor "OR" Dinâmico *@
                    <div class="text-center mb-4 position-relative">
                        <hr class="text-secondary-grey">
                        <span class="px-2 position-absolute top-50 start-50 translate-middle small text-secondary-grey"
                              style="background-color: var(--petlink-card-bg);">OR CONTINUE WITH</span>
                    </div>

                    <div class="d-flex gap-3 justify-content-center mb-4">
                        <a asp-controller = "Profile"
                           asp-action = "LoginWithGoogle"
                           class = "btn btn-outline-secondary w-50 rounded-pill py-2 text-primary-darkblue"
                           style = "border-color: var(--petlink-border);">
                            <i class = "bi bi-google"></i> Google
                        </a>
                        <button type="button"
                                class="btn btn-outline-secondary w-50 rounded-pill py-2 text-primary-darkblue"
                                style="border-color: var(--petlink-border);">
                            <i class="bi bi-github"></i> GitHub
                        </button>
                    </div>

                    <div class="text-center">
                        <p class="mb-0 small text-primary-darkblue">
                            Already have an account?
                            <a asp-controller="Profile" asp-action="LoginForm"
                               class="text-primary fw-semibold text-decoration-none">Log in</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-4 mt-4 small text-secondary-grey fw-semibold">
            <span><i class="bi bi-shield-lock"></i> SECURE SSL</span>
            <span><i class="bi bi-patch-check"></i> TRUSTED</span>
            <span><i class="bi bi-incognito"></i> PRIVACY</span>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/intlTelInput.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const phoneInputField = document.querySelector("#phone");
            window.phoneInput = window.intlTelInput(phoneInputField, {
                preferredCountries: ["pt", "br", "gb", "us"],
                utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js",
            });
            document.querySelector('.iti').style.width = '100%';
        });
    </script>
}