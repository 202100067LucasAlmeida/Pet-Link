@model IEnumerable<PetLink.Models.Petsitter>

@{
    ViewData["Title"] = "Find a Trusted Sitter";
}

<section class="breadcrumb-section py-3"
         style="background-color: var(--petlink-card-bg); border-bottom: 1px solid var(--petlink-border);">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index"
                       class="text-decoration-none text-highlight-darkblue">HOME</a>
                </li>
                <li class="breadcrumb-item active text-highlight-blue" aria-current="page">SITTERS</li>
            </ol>
        </nav>
    </div>
</section>

<div class="container my-5">
    <div class="row">

        <div class="col-lg-3 mb-4 mb-lg-0">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold text-primary-darkblue mb-0">Filters</h4>
            </div>

            <div class="card filter-card rounded-4 shadow-sm p-4"
                 style="background-color: var(--petlink-card-bg); border: 1px solid var(--petlink-border);">
                <form method="get" asp-action="Search" asp-controller="Petsitter">
                    

                    <div class="mb-4">
                        <div class="filter-section-title"><i class="bi bi-briefcase me-2"></i> SERVICE TYPE</div>
                        
                        <div class="form-check mb-2 mt-3">
                            <input class="form-check-input" type="radio" name="serviceType" value="Boarding" id="srvBoarding" checked>
                            <label class="form-check-label text-muted small fw-semibold" for="srvBoarding">Boarding
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="serviceType" value="Walking" id="srvWalking">
                            <label class="form-check-label text-muted small fw-semibold" for="srvWalking">Walking
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="serviceType" value="HouseSitting" id="srvHouse">
                            <label class="form-check-label text-muted small fw-semibold" for="srvHouse">House
                                Sitting
                            </label>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="filter-section-title"><i class="bi bi-cash me-2"></i> PRICE RANGE</div>
                        <div class="mt-3">
                            <input type="range" class="form-range" name="maxRate" min="0" max="30" id="priceRange" value="30">
                            <div class="d-flex justify-content-between text-muted small mt-1">
                                <span>0€/hr</span>
                                <span>30€/hr</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-5">
                        <div class="filter-section-title"><i class="bi bi-heart me-2"></i> PET PREFERENCES</div>
                        <div class="form-check mb-2 mt-3">
                            <input class="form-check-input" type="radio" name="petPreferences" value="SmallDogs" id="prefSmallDogs" checked>
                            <label class="form-check-label text-muted small fw-semibold" for="prefSmallDogs">Small
                                Dogs
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="petPreferences" value="Cats" id="prefCats">
                            <label class="form-check-label text-muted small fw-semibold" for="prefCats">Cats
                                only
                            </label>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="row g-2">
                            <div class="col-6">
                                <a asp-controller="Petsitter" asp-action="Index"
                                   class="btn btn-primary w-100 fw-bold py-2 rounded-3">Reset All</a>
                            </div>
                            <div class="col-6">
                                <button type="submit" class="btn btn-primary w-100 fw-bold py-2 rounded-3">Apply
                                    Filters
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="mb-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-3">
                    <div>
                        <h1 class="display-6 fw-bold mb-1 text-primary-darkblue">Find a Trusted Sitter</h1>
                        <p class="text-muted mb-0">Showing @Model.Count() verified sitters</p>
                        <div class="d-flex gap-2 flex-wrap mb-4">
                            <span class="badge rounded-pill py-2 px-3 fw-semibold border"
                                  style="background-color: rgba(8, 124, 217, 0.1); color: var(--petlink-highlight); border-color: rgba(8, 124, 217, 0.2) !important;">
                                Boarding <i class="bi bi-x ms-1 cursor-pointer"></i>
                            </span>
                            <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary py-2 px-3 fw-semibold border border-primary border-opacity-25">
                                Small Dogs <i class="bi bi-x ms-1 cursor-pointer"></i>
                            </span>
                        </div>
                    </div>
                    <div class="mt-3 mt-md-0 d-flex align-items-center">
                        <form method="get" asp-action="Search" asp-controller="Petsitter"
                              class="mt-3 mt-md-0 d-flex align-items-center">

                            <input type="hidden" name="serviceType" value="@Context.Request.Query["serviceType"]" />
                            <input type="hidden" name="maxRate" value="@Context.Request.Query["maxRate"]" />
                            <input type="hidden" name="petPreferences" value="@Context.Request.Query["petPreferences"]" />

                            <span class="text-muted small me-2">Sort by:</span>

                            <select name="sort"
                                    class="form-select form-select-sm rounded-3 shadow-sm fw-semibold"
                                    style="width: 150px;"
                                    onchange="this.form.submit()">

                                <option value="top"
                                        selected="@(Context.Request.Query["sort"] == "top")">
                                    Top Rated
                                </option>

                                <option value="price_asc"
                                        selected="@(Context.Request.Query["sort"] == "price_asc")">
                                    Price: Low to High
                                </option>

                                <option value="price_desc"
                                        selected="@(Context.Request.Query["sort"] == "price_desc")">
                                    Price: High to Low
                                </option>
                            </select>
                        </form>
                     </div>

                </div>
            </div>

            <div class="row g-4 mb-5">
                @foreach (var item in Model)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="card pet-card border-0 shadow-sm rounded-4 overflow-hidden h-100 d-flex flex-column"
                             style="background-color: var(--petlink-card-bg);">
                            
                            <div class="pet-card-img-wrapper position-relative">
                                <a asp-action="Details" asp-route-id="@item.Id">
                                    <img src="@(string.IsNullOrEmpty(item.User.ProfilePicture) ? "/images/default-avatar.jpg" : item.User.ProfilePicture)"
                                         alt="@item.User.Name's photo" class="img-fluid w-100"
                                         style="height: 250px; object-fit: cover;"
                                         onerror="this.src='/images/default-avatar.jpg'">
                                </a>

                                <span class="position-absolute top-0 end-0 m-3 px-2 py-1 shadow-sm fs-6 rounded-3 border"
                                      style="background-color: var(--petlink-card-bg); color: var(--petlink-dark); border-color: var(--petlink-border) !important;">
                                    <i class="bi bi-star-fill text-warning"></i> @item.Rating.ToString("0.0")
                                </span>
                            </div>

                            <div class="card-body p-3 d-flex flex-column flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <div>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                                            <h4 class="h5 fw-bold mb-0 text-primary-darkblue">@item.User.Name</h4>
                                        </a>
                                        <p class="text-muted small mb-0 mt-1">
                                            <i class="bi bi-geo-alt"></i> @item.LocationZone
                                        </p>
                                    </div>
                                    <div class="text-end">
                                        <span class="fw-bold fs-5 text-primary">@item.HourlyRate.ToString("0")€</span>

                                        <div class="text-muted"
                                             style="font-size: 0.6rem; font-weight: 800; letter-spacing: 0.5px; color: var(--petlink-dark) !important; opacity: 0.6;">
                                            PER HOUR
                                        </div>
                                    </div>
                                </div>

                                <p class="text-muted small mt-3 mb-3"
                                       style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; color: var(--petlink-dark) !important; opacity: 0.8;">
                                    @item.Bio
                                </p>

                                <div class="d-flex flex-wrap gap-2 mt-auto">
                                    @if (!string.IsNullOrEmpty(item.SpecialtyTags))
                                    {
                                        foreach (var tag in item.SpecialtyTags.Split(','))
                                        {
                                            <span class="badge rounded-1 border fw-bold"
                                                  style="font-size: 0.6rem; background-color: var(--petlink-light-bg); color: var(--petlink-primary); border-color: var(--petlink-primary) !important;">
                                                @tag.Trim().ToUpper()
                                            </span>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>