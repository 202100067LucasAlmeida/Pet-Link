@model PetLink.Models.Petsitter

@{
    ViewData["Title"] = Model.User.Name + " - Sitter Details";
}

@* 1. Breadcrumb Dinâmico *@
<section class="breadcrumb-section py-3"
         style="background-color: var(--petlink-card-bg); border-bottom: 1px solid var(--petlink-border);">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index"
                       class="text-decoration-none text-highlight-darkblue">HOME</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-action="Index" class="text-decoration-none text-highlight-darkblue">SITTERS</a>
                </li>
                <li class="breadcrumb-item active text-highlight-blue" aria-current="page">@Model.User.Name</li>
            </ol>
        </nav>
    </div>
</section>

<section class="py-4">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="mb-4">
                    @if (Model.User.IsVerified)
                    {
                        <span class="badge bg-success mb-2"><i class="bi bi-shield-check me-1"></i> VERIFIED SITTER</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary mb-2">NEW SITTER</span>
                    }

                    <h1 class="display-5 text-primary-darkblue mb-2 fw-bold">
                        @Model.User.Name
                        <span class="fs-4 text-warning ms-2"><i class="bi bi-star-fill"></i>
                            @Model.Rating.ToString("0.0")
                        </span>
                    </h1>
                    <p class="lead text-secondary-grey text-highlight-darkblue">
                        @Model.Age years old • @Model.LocationZone • @Model.DistanceKm km away
                    </p>
                </div>

                @* Foto Principal com botão coração  *@
                <div class="position-relative mb-4" style="max-height: 500px; border-radius: 1rem; overflow: hidden;">
                    <img src="@(string.IsNullOrEmpty(Model.User.ProfilePicture) ? "/images/default-avatar.jpg" : Model.User.ProfilePicture)"
                         alt="@Model.User.Name's photo" class="img-fluid rounded-4 shadow-sm w-100"
                         style="max-height: 500px; object-fit: cover; border: 1px solid var(--petlink-border);"
                         onerror="this.src='/images/default-avatar.jpg'" />
                    
                    @* Botão coração *@
                    @if (User.IsInRole("User"))
                    {
                        <button class="btn-heart favorite-petsitter-btn position-absolute top-0 end-0 m-3" 
                                data-petsitter-id="@Model.UserId"
                                style="background: white; border: none; border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 5px rgba(0,0,0,0.2); z-index: 10;">
                            <i class="bi bi-heart fs-4"></i>
                        </button>
                    }
                </div>

                <div class="shadow-sm card border-0 rounded-4 mb-5" style="background-color: var(--petlink-card-bg);">
                    <div class="card-body p-0">
                        <div class="p-4 d-flex justify-content-around flex-wrap rounded-top-4 border-bottom"
                             style="background-color: var(--petlink-grey-bg); border-color: var(--petlink-border) !important;">
                            <div class="text-center">
                                <span class="d-block text-secondary-grey small fw-bold text-uppercase">Rate</span>
                                <span class="text-primary-darkblue fs-5 fw-semibold">@Model.HourlyRate.ToString("0")€ / hr</span>
                            </div>
                            <div class="text-center">
                                <span class="d-block text-secondary-grey small fw-bold text-uppercase">Location</span>
                                <span class="text-primary-darkblue fs-5 fw-semibold">@Model.LocationZone</span>
                            </div>
                            <div class="text-center">
                                <span class="d-block text-secondary-grey small fw-bold text-uppercase">Experience</span>
                                <span class="text-primary-darkblue fs-5 fw-semibold">Pro Sitter</span>
                            </div>
                        </div>

                        <div class="p-4">
                            <h3 class="h5 text-primary-darkblue mb-3 fw-bold">About @Model.User.Name.Split(' ')[0]</h3>
                            <p class="lead text-secondary-grey mb-4"
                               style="color: var(--petlink-dark) !important; opacity: 0.8;">@Model.Bio</p>
        
                            @if (!ViewBag.IsSelf && User.Identity.IsAuthenticated)
                            {
                                <button class="btn btn-primary fw-bold rounded-pill px-5 py-2 w-100 shadow-sm"
                                        data-bs-toggle="modal" data-bs-target="#bookingModal">
                                    Book @Model.User.Name.Split(' ')[0]
                                </button>
                            }
                            else if (!ViewBag.IsSelf)
                            {
                                <a asp-controller="Profile" asp-action="LoginForm"
                                   class="btn btn-primary fw-bold rounded-pill px-5 py-2 w-100 shadow-sm">
                                    Book @Model.User.Name.Split(' ')[0]
                                </a>
                            }
                            else
                            {
                                <div class="alert alert-info border-0 rounded-4 text-center mt-3"
                                     style="background-color: var(--petlink-light-bg); color: var(--petlink-primary);">
                                    <i class="bi bi-info-circle me-2"></i>This is your PetSitter profile.
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="medical-history mb-5">
                    <h3 class="h4 text-primary-darkblue mb-3 fw-bold">Specialties & Preferences</h3>
                    <ul class="list-unstyled">
                        @if (!string.IsNullOrEmpty(Model.SpecialtyTags))
                        {
                            foreach (var tag in Model.SpecialtyTags.Split(','))
                            {
                                <li class="mb-2 text-primary-darkblue"><i class="bi bi-check text-success me-2"></i>
                                    @tag.Trim()
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>

            @* 3. Painel Lateral  *@
            <div class="col-lg-4">
                @if (ViewBag.IsSelf)
                {
                    @* Painel do próprio Sitter *@
                    <div class="card shadow-sm border-0 sticky-top"
                         style="top: 20px; border-radius: 20px; overflow: hidden; background-color: var(--petlink-card-bg); border: 1px solid var(--petlink-border) !important;">
                        <div class="card-body text-center p-5">
                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm"
                                 style="width: 70px; height: 70px; background-color: var(--petlink-grey-bg);">
                                <i class="bi bi-person-badge-fill text-primary" style="font-size: 2.5rem;"></i>
                            </div>
                            <h4 class="fw-bold text-primary-darkblue">This is your profile</h4>
                            <p class="text-secondary-grey small mb-4">You are viewing your public profile as it appears to clients.</p>
                            <a asp-action="Edit" asp-route-id="@Model.Id"
                               class="btn btn-primary rounded-pill w-100 fw-bold py-2 mb-2">
                                <i class="bi bi-pencil-square me-2"></i>Edit Profile
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    @* Painel de Contratação / Chat *@
                    <div class="card shadow-sm border-0 sticky-top"
                         style="top: 20px; border-radius: 20px; overflow: hidden; background-color: var(--petlink-card-bg); border: 1px solid var(--petlink-border) !important;">
            
                        <div class="card-header border-0 py-3"
                             style="background-color: var(--petlink-primary); color: white;">
                            <div class="d-flex align-items-center">
                                <div class="bg-white rounded-circle me-3 d-flex align-items-center justify-content-center"
                                     style="width: 40px; height: 40px;">
                                    <i class="bi bi-calendar-check-fill text-primary"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-bold">Hire @Model.User.Name</h6>
                                    <small style="opacity: 0.8; font-size: 0.75rem;">Check availability</small>
                                </div>
                            </div>
                        </div>

                        <div class="card-body" id="chatBox"
                             style="height: 400px; overflow-y: auto; background-color: var(--petlink-grey-bg);">
                            @if (ViewBag.ChatHistory != null &&
                                 ((IEnumerable<PetLink.Models.Message>)ViewBag.ChatHistory).Any())
                            {
                                var currentUserId = int.Parse(User.FindFirst("UserId")?.Value ?? "0");
                                foreach (var msg in (IEnumerable<PetLink.Models.Message>)ViewBag.ChatHistory)
                                {
                                    bool isMine = msg.SenderId == currentUserId;
                                    <div class="d-flex mb-3 @(isMine ? "justify-content-end" : "justify-content-start")">
                                        <div class="p-3 shadow-sm"
                                             style="max-width: 85%; border-radius: 18px; font-size: 0.85rem; line-height: 1.4;
                                                @(isMine ? "background-color: var(--petlink-highlight); color: white; border-bottom-right-radius: 4px;"
                                                        : "background-color: var(--petlink-card-bg); color: var(--petlink-dark); border-bottom-left-radius: 4px; border: 1px solid var(--petlink-border);")">
                                            <p class="mb-0">@msg.Content</p>
                                            <div class="text-end" style="font-size: 0.6rem; opacity: 0.6; margin-top: 5px;">
                                                @msg.Timestamp.ToString("HH:mm")
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="h-100 d-flex flex-column align-items-center justify-content-center text-center p-4">
                                    <i class="bi bi-chat-dots mb-2 opacity-25"
                                       style="font-size: 3rem; color: var(--petlink-primary);"></i>
                                    <p class="text-secondary-grey small">No messages yet. Say hi!</p>
                                </div>
                            }
                        </div>

                        <div class="card-footer border-0 p-3" style="background-color: var(--petlink-card-bg);">
                            <a asp-controller="Messages" asp-action="Index" asp-route-id="@Model.UserId"
                               class="btn btn-primary w-100 fw-bold rounded-pill py-2 d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-chat-dots-fill"></i> Message @Model.User.Name.Split(' ')[0]
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@* Booking Modal *@
@if (!ViewBag.IsSelf)
{
    <div class="modal fade" id="bookingModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <form asp-controller="Bookings" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="petsitterId" value="@Model.Id" />

                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title text-primary-darkblue fw-bold">Book @Model.User.Name.Split(' ')[0]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-primary-darkblue small">Service Type</label>
                            <select name="serviceType" class="form-select rounded-3" required>
                                <option value="Boarding" selected="@(Model.serviceType == PetLink.Models.Enums.ServiceType.Boarding)">Boarding</option>
                                <option value="Walking" selected="@(Model.serviceType == PetLink.Models.Enums.ServiceType.Walking)">Walking</option>
                                <option value="HouseSitting" selected="@(Model.serviceType == PetLink.Models.Enums.ServiceType.HouseSitting)">House Sitting</option>
                            </select>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-bold text-primary-darkblue small">Start Date</label>
                                <input type="date" name="startDate" class="form-control rounded-3" required min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold text-primary-darkblue small">End Date</label>
                                <input type="date" name="endDate" class="form-control rounded-3" required min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-bold text-primary-darkblue small">Pet Name</label>
                                <input type="text" name="petName" class="form-control rounded-3" placeholder="e.g. Rex" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold text-primary-darkblue small">Pet Species</label>
                                <input type="text" name="petSpecies" class="form-control rounded-3" placeholder="e.g. Dog" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-primary-darkblue small">Message to Sitter</label>
                            <textarea name="message" class="form-control rounded-3" rows="3" placeholder="Tell the sitter about your pet's needs..."></textarea>
                        </div>

                        <div class="p-3 rounded-3 mb-0" style="background-color: var(--petlink-grey-bg);">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-primary-darkblue fw-bold">Rate: @Model.HourlyRate.ToString("0")€ / hr</span>
                                <span class="text-primary fw-bold" id="estimatedTotal">Estimated: 0.00€</span>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-outline-secondary rounded-pill fw-bold px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill fw-bold px-5">Send Request</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<section class="featured-section py-5 mt-4 border-top"
         style="background-color: var(--petlink-grey-bg); border-color: var(--petlink-border) !important;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <span class="text-primary small fw-bold">LOCAL PROS</span>
                <h2 class="h3 text-primary-darkblue mb-0 fw-bold">Other Trusted Sitters</h2>
            </div>
            <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 fw-bold">View All</a>
        </div>

        <div class="row g-4">
            @foreach (var sitter in ViewBag.OtherSitters as IEnumerable<PetLink.Models.Petsitter>)
            {
                <div class="col-md-6 col-lg-3">
                    <a asp-action="Details" asp-route-id="@sitter.Id" class="text-decoration-none">
                        <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden pet-card"
                             style="background-color: var(--petlink-card-bg);">
                            <img src="@(string.IsNullOrEmpty(sitter.User.ProfilePicture) ? "/images/default-avatar.jpg" : sitter.User.ProfilePicture)"
                                 class="img-fluid w-100" style="height: 200px; object-fit: cover;"
                                 onerror="this.src='/images/default-avatar.jpg'" />

                            <div class="card-body">
                                <h3 class="h5 text-primary-darkblue fw-bold mb-2">@sitter.User.Name.Split(' ')[0]</h3>
                                <div class="text-secondary-grey small">
                                    <p class="mb-1"><i class="bi bi-geo-alt me-1"></i> @sitter.LocationZone</p>
                                    <p class="mb-0"><i class="bi bi-star-fill text-warning me-1"></i>
                                        @sitter.Rating.ToString("0.0")
                                    </p>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        var hourlyRate = @Model.HourlyRate.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

        function updateEstimatedTotal() {
            var startDate = new Date($('input[name="startDate"]').val());
            var endDate = new Date($('input[name="endDate"]').val());

            if (startDate && endDate && endDate > startDate) {
                var hours = (endDate - startDate) / (1000 * 60 * 60);
                var total = hours * hourlyRate;
                $('#estimatedTotal').text('Estimated: ' + total.toFixed(2) + '€');
            } else {
                $('#estimatedTotal').text('Estimated: 0.00€');
            }
        }

        $('input[name="startDate"], input[name="endDate"]').on('change', updateEstimatedTotal);

        $(document).ready(function() {
            var petsitterId = @Model.UserId;
            var favoriteBtn = $('.favorite-petsitter-btn');
            
            // Função para atualizar o ícone do coração 
            function updateHeartIcon(isFavorited) {
                if (isFavorited) {
                    favoriteBtn.html('<i class="bi bi-heart-fill text-danger fs-4"></i>');
                    favoriteBtn.addClass('active');
                } else {
                    favoriteBtn.html('<i class="bi bi-heart fs-4"></i>');
                    favoriteBtn.removeClass('active');
                }
            }
            
            // Verificar estado inicial
            $.ajax({
                url: '@Url.Action("CheckPetsitter", "Favorites")',
                type: 'GET',
                data: { petsitterId: petsitterId },
                success: function(isFavorited) {
                    updateHeartIcon(isFavorited);
                }
            });
            
            // Toggle favorito
            favoriteBtn.click(function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                $.ajax({
                    url: '@Url.Action("TogglePetsitter", "Favorites")',
                    type: 'POST',
                    data: { petsitterId: petsitterId },
                    success: function(response) {
                        if (response.success) {
                            updateHeartIcon(response.isFavorited);
                            showNotification(response.message);
                        }
                    },
                    error: function() {
                        showNotification('Error updating favorite', 'error');
                    }
                });
            });
            
            function showNotification(message) {
                $('.toast-notification').remove();
                var toast = $(`<div class="toast-notification">${message}</div>`);
                $('body').append(toast);
                setTimeout(() => toast.fadeOut(300, function() { $(this).remove(); }), 2000);
            }
        });
    </script>
}