@model PetLink.Models.Petsitter

@{
    ViewData["Title"] = Model.User.Name + " - Sitter Details";
}

<section class="breadcrumb-section py-3 bg-light">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-highlight-darkblue">HOME</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-highlight-darkblue">PETSITTING</a></li>
                <li class="breadcrumb-item active text-highlight-blue" aria-current="page">@Model.User.Name</li>
            </ol>
        </nav>
    </div>
</section>

<section class="py-4">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="mb-4">
                    @if (Model.User.IsVerified)
                    {
                        <span class="badge bg-success mb-2"><i class="bi bi-shield-check me-1"></i> VERIFIED SITTER</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary mb-2">NEW SITTER</span>
                    }

                    <h1 class="display-5 text-primary-darkblue mb-2 fw-bold">
                        @Model.User.Name
                        <span class="fs-4 text-warning ms-2"><i class="bi bi-star-fill"></i> @Model.Rating.ToString("0.0")</span>
                    </h1>
                    <p class="lead text-muted text-highlight-darkblue">
                        @Model.Age years old • @Model.LocationZone • @Model.DistanceKm km away
                    </p>
                </div>

                <img src="~/images/@(Model.User.Name.ToLower().Replace(" ", "")).jpg" alt="@Model.User.Name's photo"
                     class="img-fluid rounded-4 shadow-sm mb-4 w-100" style="max-height: 500px; object-fit: cover;" />

                <div class="m-3 shadow-sm card border-0 rounded-4 mb-5">
                    <div class="card-body p-4 d-flex justify-content-around flex-wrap bg-light rounded-top-4 border-bottom">
                        <div class="text-center">
                            <span class="d-block text-muted small fw-bold text-uppercase">Rate</span>
                            <span class="text-primary-darkblue fs-5 fw-semibold">@Model.HourlyRate.ToString("0")€ / hr</span>
                        </div>
                        <div class="text-center">
                            <span class="d-block text-muted small fw-bold text-uppercase">Location</span>
                            <span class="text-primary-darkblue fs-5 fw-semibold">@Model.LocationZone</span>
                        </div>
                        <div class="text-center">
                            <span class="d-block text-muted small fw-bold text-uppercase">Experience</span>
                            <span class="text-primary-darkblue fs-5 fw-semibold">Pro Sitter</span>
                        </div>
                    </div>

                    <div class="p-4">
                        <h3 class="h5 text-primary-darkblue mb-3 fw-bold">About @Model.User.Name.Split(' ')[0]</h3>
                        <p class="lead text-highlight-darkblue text-muted mb-4">@Model.Bio</p>
                        <button class="btn btn-primary text-white fw-bold rounded-pill px-5 py-2" style="background-color: #0a4f8b; border: none;">
                            Book @Model.User.Name.Split(' ')[0]
                        </button>
                    </div>
                </div>

                <div class="medical-history mb-5">
                    <h3 class="h4 text-primary-darkblue mb-3 fw-bold">Specialties & Preferences</h3>
                    <ul class="list-unstyled">
                        @if (!string.IsNullOrEmpty(Model.SpecialtyTags))
                        {
                            foreach (var tag in Model.SpecialtyTags.Split(','))
                            {
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> @tag.Trim()</li>
                            }
                        }
                    </ul>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0 rounded-4 sticky-top" style="top: 20px;">
                    <div class="card-header text-white py-3 rounded-top-4" style="background-color: var(--petlink-primary, #0a4f8b);">
                        <h3 class="h6 mb-0 fw-bold">
                            <i class="bi bi-chat-dots me-2"></i>
                            Chat with @Model.User.Name.Split(' ')[0]
                        </h3>
                    </div>

                    <div class="card-body bg-light" id="chatBox" style="height: 350px; overflow-y: auto;">
                        <div class="chat-message mb-3">
                            <div class="message-received d-flex mb-3">
                                <div class="message-bubble p-3 rounded-4 shadow-sm bg-white border" style="max-width: 85%;">
                                    <p class="mb-0 small text-dark">
                                        Hello! Let me know if you have any questions.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-white border-top-0 p-3 rounded-bottom-4 border">
                        <div class="input-group">
                            <input type="text" id="messageInput" class="form-control border bg-light rounded-start-pill ps-4"
                                   placeholder="Type a message...">
                            <button id="sendButton" class="btn btn-primary rounded-end-pill px-4" type="button" style="background-color: #0a4f8b; border: none;">
                                <i class="bi bi-send-fill"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="featured-section py-5 bg-light mt-4 border-top">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <span class="text-primary small fw-bold">LOCAL PROS</span>
                <h2 class="h3 text-primary-darkblue mb-0 fw-bold">Other Trusted Sitters in Your Area</h2>
            </div>
            <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 fw-bold">View All Sitters →</a>
        </div>

        <div class="row g-4">
            @foreach (var sitter in ViewBag.OtherSitters as IEnumerable<PetLink.Models.Petsitter>)
            {
                <div class="col-md-6 col-lg-3">
                    <a asp-action="Details" asp-route-id="@sitter.Id" class="text-decoration-none text-dark">
                        <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden pet-card">
                            <img src="~/images/@(sitter.User.Name.ToLower().Replace(" ", "")).jpg" 
                                 alt="@sitter.User.Name's photo"
                                 class="img-fluid w-100" style="height: 200px; object-fit: cover;" />
                            
                            <div class="card-body">
                                <h3 class="h5 text-primary-darkblue fw-bold mb-2">
                                    @sitter.User.Name.Split(' ')[0] 
                                    @if (sitter.User.IsVerified)
                                    {
                                        <i class="bi bi-check-circle-fill text-primary ms-1 fs-6"></i>
                                    }
                                </h3>
                                <div class="text-muted small">
                                    <p class="mb-1"><i class="bi bi-geo-alt me-1"></i> @sitter.LocationZone</p>
                                    <p class="mb-1"><i class="bi bi-star-fill text-warning me-1"></i> @sitter.Rating.ToString("0.0") Rating</p>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
            @if (((IEnumerable<PetLink.Models.Petsitter>)ViewBag.OtherSitters).Count() == 0)
            {
                <div class="col-12 text-center text-muted">
                    <p>No other sitters available in your area right now.</p>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/chat.js"></script>
}