@using PetLink.Models.Enums
@model IEnumerable<PetLink.Models.AnimalListing>

@{
    ViewData["Title"] = "Home Page";
}

<section class="hero-section py-5">
    <div class="container" style="padding-top: 50px;">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold mb-3 text-primary-light">Find your perfect
                    <span class="text-primary-lightblue">companion</span> today.
                </h1>

                <p class="lead text-secondary-grey mb-5 text-highlight-light">Connecting thousands of animals with
                    loving
                    homes.<br>Trustworthy, safe, and dedicated to animal welfare.
                </p>

                <form asp-controller="AnimalListings" asp-action="Search" method="get">
                    <div class="search-card p-3 shadow-sm" style="background-color: var(--petlink-card-bg);">
                        <div class="row g-4 align-items-end">
                            <div class="col-md-3 text-start">
                                <label class="form-label text-primary-blue small fw-bold mb-1">LOCATION</label>
                                @* Mudado bg-light para var(--petlink-grey-bg) *@
                                <input type="text" name="location" class="form-control text-highlight-blue border-0"
                                       style="background-color: var(--petlink-grey-bg);" placeholder="Where are you?">
                            </div>

                            <div class="col-md-3 text-start">
                                <label class="form-label text-primary-blue small fw-bold mb-1">ANIMAL TYPE</label>
                                <select name="species" class="form-select text-highlight-blue border-0"
                                        style="background-color: var(--petlink-grey-bg);">
                                    <option value="">All Animals</option>
                                    <option value="Dog">Dogs</option>
                                    <option value="Cat">Cats</option>
                                    <option value="Bird">Birds</option>
                                </select>
                            </div>

                            <div class="col-md-3 text-start">
                                <label class="form-label text-primary-blue small fw-bold mb-1">AGE RANGE</label>
                                <select name="age" class="form-select text-highlight-blue border-0"
                                        style="background-color: var(--petlink-grey-bg);">
                                    <option value="">Any Age</option>
                                    <option value="@Age.Puppy">Puppy (0-1 yr)</option>
                                    <option value="@Age.Adult">Adult (1-3 yrs)</option>
                                    <option value="@Age.Senior">Senior (3-7 yrs)</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <button type="submit"
                                        class="btn btn-primary rounded-pill px-4 py-2 w-100 fw-bold shadow-sm">Search
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<section class="features-section px-5 py-5">
    <div class="container">
        <div class="row align-content-center text-center">
            @* Os feature-cards já usam var(--petlink-card-bg) no CSS global *@
            <div class="col-md-4 py-2">
                <div class="feature-card p-3 mx-auto">
                    <h3 class="h5 text-primary-blue">Verified Shelters</h3>
                    <p class="text-secondary-grey small mb-0">100% vetted partners only.</p>
                </div>
            </div>

            <div class="col-md-4 py-2">
                <div class="feature-card p-3 mx-auto">
                    <h3 class="h5 text-primary-blue">Daily New Pets</h3>
                    <p class="text-secondary-grey small mb-0">Updated listings every hour.</p>
                </div>
            </div>

            <div class="col-md-4 py-2">
                <div class="feature-card p-3 mx-auto">
                    <h3 class="h5 text-primary-blue">Direct Contact</h3>
                    <p class="text-secondary-grey small mb-0">Message owners instantly.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="featured-section py-5 text-highlight-darkblue">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <span class="text-highlight-blue text-uppercase small fw-bold">RECENTLY ADDED</span>
                <h2 class="h3 text-primary-darkblue mb-0">Featured Animals for Adoption</h2>
            </div>

            <a asp-controller="AnimalListings" asp-action="Index" class="btn text-highlight-lightblue fw-bold">View All
                Pets &rarr;
            </a>
        </div>

        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="col-md-6 col-lg-3">
                        <div class="animal-card card h-100 shadow-sm border-0">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/default-pet.jpg" : item.ImageUrl)"
                                 class="card-img-top" style="height: 200px; object-fit: cover;"
                                 onerror="this.src='/images/default-pet.jpg'">
                            <div class="card-body">
                                <h4 class="h5 text-primary-darkblue mb-2 fw-bold">@item.Name</h4>
                                <div class="animal-details small text-secondary-grey">
                                    <p class="mb-1"><i class="bi bi-geo-alt"></i> @item.Location</p>
                                    <p class="mb-1"><i class="bi bi-calendar"></i> @item.AgeMonths months</p>
                                    <p class="mb-1"><i class="bi bi-tag"></i> @item.Species</p>
                                </div>
                            </div>

                            <div class="card-footer bg-transparent border-0 pb-3">
                                <a asp-controller="AnimalListings" asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-secondary rounded-pill w-100 fw-bold">View Details
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-4">
                    <p class="text-secondary-grey">No pets listed recently.</p>
                </div>
            }
        </div>
    </div>
    <div class="container mt-5 pt-5 border-top" style="border-color: var(--petlink-border) !important;">
        <div class="row align-items-end mb-4">
            <div class="col-lg-8">
                <h2 class="bi bi-compass me-1 h3 text-primary-darkblue mb-2">Find Pets Near You</h2>
                <p class="text-secondary-grey mb-0">
                    Explore our interactive map to discover animals looking for a loving home in your area. 
                    Allow location access to see exactly how close you are, and click on any paw to learn more!
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <span class="badge rounded-pill fw-normal px-3 py-2" style="background-color: var(--petlink-grey-bg); color: var(--petlink-dark); border: 1px solid var(--petlink-border);">
                    <i class="bi bi-geo-fill text-primary"></i> 15km Search Radius
                </span>
            </div>
        </div>

        <div class="map-wrapper shadow-sm" style="border-radius: 16px; overflow: hidden; border: 4px solid var(--petlink-card-bg); background-color: var(--petlink-grey-bg);">
            <div id="meuMapa" style="height: 550px; width: 100%;"></div>
        </div>
    </div>
</section>

<script>
    // 1. Converter o Model C# para JSON (Adicionei a idade para o cartão ficar mais completo)
    var petsArray = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(p => new {
        id = p.Id,
        name = p.Name,
        species = p.Species.ToString(),
        location = p.Location,
        ageMonths = p.AgeMonths,
        imageUrl = string.IsNullOrEmpty(p.ImageUrl) ? "/images/default-pet.jpg" : p.ImageUrl,
        lat = p.Tutor != null && !string.IsNullOrEmpty(p.Tutor.GetLatitude()) ? p.Tutor.GetLatitude() : "38.7223",
        lng = p.Tutor != null && !string.IsNullOrEmpty(p.Tutor.GetLongitude()) ? p.Tutor.GetLongitude() : "-9.1393"
    })));

    // 2. AGRUPAR OS ANIMAIS POR COORDENADAS
    var petsPorLocalizacao = {};
    petsArray.forEach(function(pet) {
        var chave = pet.lat + "_" + pet.lng; // Cria uma chave única para aquele GPS
        if (!petsPorLocalizacao[chave]) {
            petsPorLocalizacao[chave] = [];
        }
        petsPorLocalizacao[chave].push(pet);
    });

    // 3. Inicializar o Mapa
    var mapa = L.map('meuMapa').setView([38.7223, -9.1393], 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 20,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(mapa);

    var petIcon = L.icon({
        iconUrl: 'https://cdn-icons-png.flaticon.com/512/1076/1076928.png', 
        iconSize: [30, 30],
        iconAnchor: [15, 30],
        popupAnchor: [0, -30]
    });

    var marcadoresLeaflet = []; 
    
    // 4. Desenhar UM marcador por cada Localização (e não por cada animal)
    Object.keys(petsPorLocalizacao).forEach(function(chaveGPS) {
        var animaisAqui = petsPorLocalizacao[chaveGPS];
        
        var coords = chaveGPS.split('_');
        var lat = parseFloat(coords[0].replace(',', '.'));
        var lng = parseFloat(coords[1].replace(',', '.'));

        if (!isNaN(lat) && !isNaN(lng)) {
            var marker = L.marker([lat, lng], {icon: petIcon}).addTo(mapa);
            
            // Construir o HTML do Popup (Com scroll se houver mais de 1 animal)
            var popupContent = `<div style="text-align: center; min-width: 170px; max-height: 280px; overflow-y: auto; overflow-x: hidden; padding-right: 5px;">`;
            
            // Se houver vários, colocamos um título a dizer quantos são!
            if(animaisAqui.length > 1) {
                popupContent += `
                    <div style="position: sticky; top: 0; background: white; padding-bottom: 5px; border-bottom: 2px solid var(--petlink-border); margin-bottom: 10px; z-index: 2;">
                        <span class="badge bg-primary rounded-pill mb-1" style="font-family: var(--font-primary);">${animaisAqui.length} Pets Here</span>
                    </div>`;
            }

            // Adicionar os cartões de todos os animais que estão nesta localização
            animaisAqui.forEach(function(pet) {
                popupContent += `
                    <div style="margin-bottom: 15px; background: var(--petlink-grey-bg); padding: 8px; border-radius: 12px; border: 1px solid var(--petlink-border);">
                        <img src="${pet.imageUrl}" alt="${pet.name}" style="width: 100%; height: 100px; object-fit: cover; border-radius: 8px; margin-bottom: 8px;">
                        <h6 style="margin: 0; font-weight: bold; color: var(--petlink-primary-darkblue); font-family: var(--font-primary);">${pet.name}</h6>
                        <p style="margin: 0; font-size: 11px; color: var(--petlink-secondary-grey);">${pet.species} • ${pet.ageMonths} mo.</p>
                        <a href="/AnimalListings/Details/${pet.id}" class="btn btn-sm w-100 mt-2" style="background-color: var(--petlink-primary); color: white; border-radius: 20px; font-weight: bold; font-size: 12px;">Adopt ${pet.name}</a>
                    </div>
                `;
            });

            popupContent += `</div>`;
            marker.bindPopup(popupContent);
            marcadoresLeaflet.push(marker);
        }
    });

    // 5. Localização do Utilizador (Igual ao anterior)
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
            function (posicao) {
                var userLat = posicao.coords.latitude;
                var userLng = posicao.coords.longitude;

                var userMarker = L.circleMarker([userLat, userLng], {
                    radius: 8,
                    fillColor: "#087CD9",
                    color: "#fff",
                    weight: 2,
                    opacity: 1,
                    fillOpacity: 0.9
                }).addTo(mapa).bindPopup("<b style='color: var(--petlink-primary-darkblue);'>You are here!</b>").openPopup();

                L.circle([userLat, userLng], {
                    color: '#087CD9',
                    fillColor: '#087CD9',
                    fillOpacity: 0.1,
                    radius: 15000 
                }).addTo(mapa);

                var grupoDeLimites = new L.featureGroup(marcadoresLeaflet);
                grupoDeLimites.addLayer(userMarker); 
                mapa.fitBounds(grupoDeLimites.getBounds().pad(0.1)); 
            },
            function (erro) {
                console.warn("Localização recusada ou indisponível: " + erro.message);
                if (marcadoresLeaflet.length > 0) {
                    var grupoDeLimites = new L.featureGroup(marcadoresLeaflet);
                    mapa.fitBounds(grupoDeLimites.getBounds().pad(0.1));
                }
            }
        );
    }
</script>

