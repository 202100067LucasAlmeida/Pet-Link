@model IEnumerable<PetLink.Models.AnimalListing>

@{
    ViewData["Title"] = "Home Page";
}

<section class="hero-section py-5">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold mb-3 text-primary-light">Find your perfect <span
                    class="text-primary-lightblue">companion</span> today.</h1>
                    <p class="lead text-muted mb-5 text-highlight-light">Connecting thousands of animals with loving
                        homes.<br>Trustworthy, safe, and dedicated to animal welfare.</p>

                        <form asp-controller="AnimalListings" asp-action="Index" method="get">
                            <div class="search-card p-3 shadow-sm bg-white">
                                <div class="row g-4 align-items-end">
                                    <div class="col-md-3 text-start">
                                        <label class="form-label text-primary-blue small fw-bold mb-1">LOCATION</label>
                                        <input type="text" name="location"
                                               class="form-control text-highlight-blue border-0 bg-light"
                                               placeholder="Where are you?">
                                    </div>

                                    <div class="col-md-3 text-start">
                                        <label class="form-label text-primary-blue small fw-bold mb-1">ANIMAL TYPE</label>
                                        <select name="species" class="form-select text-highlight-blue border-0 bg-light">
                                            <option value="">All Animals</option>
                                            <option value="Dog">Dogs</option>
                                            <option value="Cat">Cats</option>
                                            <option value="Bird">Birds</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3 text-start">
                                        <label class="form-label text-primary-blue small fw-bold mb-1">AGE RANGE</label>
                                        <select name="age" class="form-select text-highlight-blue border-0 bg-light">
                                            <option value="">Any Age</option>
                                            <option value="0-1">Puppy (0-1 yr)</option>
                                            <option value="1-3">Adult (1-7 yrs)</option>
                                            <option value="3-7">Senior (7+ yrs)</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <button type="submit"
                                                class="btn btn-primary rounded-pill px-4 py-2 w-100 fw-bold shadow-sm">Search</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </section>

        <section class="features-section px-5 py-5">
            <div class="container">
                <div class="row align-content-center text-center">
                    <div class="col-md-4 py-2">
                        <div class="feature-card p-3 mx-auto">
                            <h3 class="h5 text-primary-blue">Verified Shelters</h3>
                            <p class="text-muted small mb-0">100% vetted partners only.</p>
                        </div>
                    </div>
                    <div class="col-md-4 py-2">
                        <div class="feature-card p-3 mx-auto">
                            <h3 class="h5 text-primary-blue">Daily New Pets</h3>
                            <p class="text-muted small mb-0">Updated listings every hour.</p>
                        </div>
                    </div>
                    <div class="col-md-4 py-2">
                        <div class="feature-card p-3 mx-auto">
                            <h3 class="h5 text-primary-blue">Direct Contact</h3>
                            <p class="text-muted small mb-0">Message owners instantly.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="featured-section py-5 text-highlight-darkblue">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <span class="text-highlight-blue text-uppercase small fw-bold">RECENTLY ADDED</span>
                        <h2 class="h3 text-primary-darkblue mb-0">Featured Animals for Adoption</h2>
                    </div>
                    <a asp-controller="AnimalListings" asp-action="Index" class="btn text-highlight-lightblue fw-bold">View All
                        Pets &rarr;</a>
                    </div>

                    <div class="row g-4">
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <div class="col-md-6 col-lg-3">
                                    <div class="animal-card card h-100 shadow-sm border-0">
                                        <img src="~/images/@(item.Name.ToLower()).jpg" alt="@item.Name's photo" class="card-img-top">
                                            <div class="card-body">
                                                <h3 class="h5 text-primary-darkblue mb-2 fw-bold">@item.Name</h3>
                                                <div class="animal-details small text-muted">
                                                    <p class="mb-1"><i class="bi bi-geo-alt"></i> @item.Location</p>
                                                    <p class="mb-1"><i class="bi bi-calendar"></i> @item.AgeMonths months</p>
                                                    <p class="mb-1"><i class="bi bi-tag"></i> @item.Species</p>
                                                </div>
                                            </div>
                                            <div class="card-footer bg-transparent border-0 pb-3">
                                                <a asp-controller="AnimalListings" asp-action="Details" asp-route-id="@item.Id"
                                                   class="btn btn-secondary rounded-pill w-100 fw-bold"
                                                   style="color: var(--petlink-dark);">View Details</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
            else
                            {
                                <div class="col-12 text-center py-4">
                                    <p class="text-muted">Nenhum animal listado recentemente.</p>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3">
                        <a href="#" class="btn btn-secondary rounded-pill w-100 text-highlight-darkblue">View Details</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Footer -->
<div class="text-center border-top mb-5 p-5 bg-light">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3">
                <h4 class="h5 text-primary-blue mb-3">PETLINK</h4>
                <p class="small text-muted">Making pet adopting simple,
                                                transparent, and joyful. Our mission is to
                                                ensure every pet finds its forever home.
                </p>
            </div>

            <div class="col-lg-3">
                <h5 class="h6 text-primary-blue mb-3">Platform</h5>
                <ul class="list-unstyled small">
                    <li class="mb-2"><a href="#" class="text-muted text-decoration-none">How it works</a></li>
                    <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Safety center</a></li>
                    <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Success stories</a></li>
                    <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Verification process</a></li>
                </ul>
            </div>

            <div class="col-lg-3">
                <h5 class="h6 text-primary-blue mb-3">Community</h5>
                <ul class="list-unstyled small">
                    <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Pet care resources</a></li>
                    <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Local shelters</a></li>
                    <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Volunteering</a></li>
                    <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Events</a></li>
                </ul>
            </div>

            <div class="col-lg-3">
                <h5 class="h6 text-primary-blue mb-3">Support</h5>
                <ul class="list-unstyled small">
                    <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Help Center</a></li>
                    <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Contact Us</a></li>
                    <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Privacy Policy</a></li>
                    <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Terms of Service</a></li>
                </ul>
            </div>
        </div>

    </div>
</div>
