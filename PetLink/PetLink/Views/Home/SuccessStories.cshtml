@{
    ViewData["Title"] = "Success Stories";
}

<section class="py-5" style="background-color: var(--petlink-grey-bg);">
    <div class="container">
        <div class="text-center mb-5">
            <span class="text-primary small fw-bold">HAPPY ENDINGS</span>
            <h1 class="display-5 fw-bold text-primary-darkblue">Success Stories</h1>
            <p class="lead text-secondary-grey">Real families. Real love. Real happy endings.</p>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="card border-0 rounded-4 shadow-sm h-100" style="background-color: var(--petlink-card-bg);">
                    <img src="/images/default-pet.jpg" class="card-img-top rounded-top-4" style="height: 220px; object-fit: cover;" />
                    <div class="card-body p-4">
                        <div class="d-flex mb-2">
                            <i class="bi bi-star-fill text-warning me-1"></i>
                            <i class="bi bi-star-fill text-warning me-1"></i>
                            <i class="bi bi-star-fill text-warning me-1"></i>
                            <i class="bi bi-star-fill text-warning me-1"></i>
                            <i class="bi bi-star-fill text-warning me-1"></i>
                        </div>
                        <h5 class="fw-bold text-primary-darkblue">Luna found her forever home!</h5>
                        <p class="text-secondary-grey small">"We found Luna on PetLink and from the first moment we knew she was the one. The process was smooth and the shelter was incredibly helpful."</p>
                        <div class="d-flex align-items-center mt-3">
                            <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 36px; height: 36px;">
                                <i class="bi bi-person-fill text-white"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-primary-darkblue small">Sarah & Tom</div>
                                <div class="text-muted" style="font-size: 0.75rem;">Adopted Luna • Lisbon</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 rounded-4 shadow-sm h-100" style="background-color: var(--petlink-card-bg);">
                    <img src="/images/default-pet.jpg" class="card-img-top rounded-top-4" style="height: 220px; object-fit: cover;" />
                    <div class="card-body p-4">
                        <div class="d-flex mb-2">
                            <i class="bi bi-star-fill text-warning me-1"></i>
                            <i class="bi bi-star-fill text-warning me-1"></i>
                            <i class="bi bi-star-fill text-warning me-1"></i>
                            <i class="bi bi-star-fill text-warning me-1"></i>
                            <i class="bi bi-star-fill text-warning me-1"></i>
                        </div>
                        <h5 class="fw-bold text-primary-darkblue">Max is living his best life!</h5>
                        <p class="text-secondary-grey small">"Adopting Max through PetLink was the best decision we ever made. He has brought so much joy to our family. Highly recommend!"</p>
                        <div class="d-flex align-items-center mt-3">
                            <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 36px; height: 36px;">
                                <i class="bi bi-person-fill text-white"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-primary-darkblue small">Miguel</div>
                                <div class="text-muted" style="font-size: 0.75rem;">Adopted Max • Porto</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 rounded-4 shadow-sm h-100" style="background-color: var(--petlink-card-bg);">
                    <img src="/images/default-pet.jpg" class="card-img-top rounded-top-4" style="height: 220px; object-fit: cover;" />
                    <div class="card-body p-4">
                        <div class="d-flex mb-2">
                            <i class="bi bi-star-fill text-warning me-1"></i>
                            <i class="bi bi-star-fill text-warning me-1"></i>
                            <i class="bi bi-star-fill text-warning me-1"></i>
                            <i class="bi bi-star-fill text-warning me-1"></i>
                            <i class="bi bi-star-fill text-warning me-1"></i>
                        </div>
                        <h5 class="fw-bold text-primary-darkblue">Bella completes our family!</h5>
                        <p class="text-secondary-grey small">"We were nervous about adopting but PetLink made everything so easy. Bella settled in immediately and we couldn't be happier."</p>
                        <div class="d-flex align-items-center mt-3">
                            <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 36px; height: 36px;">
                                <i class="bi bi-person-fill text-white"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-primary-darkblue small">Ana & João</div>
                                <div class="text-muted" style="font-size: 0.75rem;">Adopted Bella • Setúbal</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 text-center mb-5">
            <div class="col-6 col-md-3">
                <div class="card border-0 rounded-4 shadow-sm p-4" style="background-color: var(--petlink-card-bg);">
                    <h2 class="fw-bold text-primary display-5">500+</h2>
                    <p class="text-secondary-grey mb-0 small fw-bold">Adoptions</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 rounded-4 shadow-sm p-4" style="background-color: var(--petlink-card-bg);">
                    <h2 class="fw-bold text-primary display-5">50+</h2>
                    <p class="text-secondary-grey mb-0 small fw-bold">Shelters</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 rounded-4 shadow-sm p-4" style="background-color: var(--petlink-card-bg);">
                    <h2 class="fw-bold text-primary display-5">98%</h2>
                    <p class="text-secondary-grey mb-0 small fw-bold">Happy Families</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 rounded-4 shadow-sm p-4" style="background-color: var(--petlink-card-bg);">
                    <h2 class="fw-bold text-primary display-5">4.9★</h2>
                    <p class="text-secondary-grey mb-0 small fw-bold">Average Rating</p>
                </div>
            </div>
        </div>

        <div class="text-center">
            <a asp-controller="AnimalListings" asp-action="Index" class="btn btn-primary rounded-pill px-5 py-3 fw-bold fs-5">
                <i class="bi bi-heart me-2"></i>Write Your Own Story
            </a>
        </div>
    </div>
</section>