<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PetLink</title>

    <link rel="icon" type="image/png" href="~/favicon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PetLink.styles.css" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Oxygen:wght@300;400;700&family=Poetsen+One&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center text-primary-blue fw-bold fs-4" asp-area=""
                       asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="PetLink Logo" height="40"
                         class="d-inline-block align-text-top me-2">PETLINK
                    </a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                        <ul class="navbar-nav align-items-center fw-semibold">

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item me-3">
                                    <a class="nav-link text-primary-blue" asp-controller="Users" asp-action="Index">Users</a>
                                </li>

                                <li class="nav-item me-3">
                                    <a class="nav-link text-primary-blue" asp-controller="AnimalListings"
                                           asp-action="Manage">Listings
                                    </a>
                                </li>
                            }

                            <li class="nav-item me-3">
                                <a class="nav-link text-primary-blue" asp-controller="AnimalListings"
                                       asp-action="Index">Adopt
                                </a>
                            </li>

                            <li class="nav-item me-3">
                                <a class="nav-link text-primary-blue" asp-controller="Petsitter"
                                       asp-action="Index">Petsitting
                                </a>
                            </li>

                            <li class="nav-item me-4"><a class="nav-link text-primary-blue" href="#">Resources</a></li>

                            <li class="nav-item me-4">
                                <a class="nav-link text-primary-blue" href="#"><i class="bi bi-moon-fill fs-5"></i></a>
                            </li>


                            @if (User.Identity.IsAuthenticated)
                            {
                                <li class="nav-item me-3">
                                    <span class="nav-link text-dark fw-bold"><i class="bi bi-person-circle me-1"></i>
                                        Olá, @User.Identity.Name!
                                    </span>
                                </li>

                                <li class="nav-item">
                                    <a class="btn btn-outline-danger rounded-pill px-4 py-2 fw-bold shadow-sm"
                                           asp-controller="Profile" asp-action="Logout">Sair
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item me-3">
                                    <a class="nav-link text-primary-blue" asp-controller="Profile"
                                       asp-action="LoginForm">Login</a>
                                </li>
                                <li class="nav-item">
                                    <a class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" asp-controller="Profile"
                                           asp-action="SignUpForm">Sign Up
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <main role="main" class="pb-3">
            @RenderBody()
        </main>

        <footer class="border-top py-2 footer text-muted bg-white">
            <div class="container text-center small text-muted">
                <p class="mb-0">© 2026 PetLink. All rights reserved.</p>
            </div>
        </footer>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>