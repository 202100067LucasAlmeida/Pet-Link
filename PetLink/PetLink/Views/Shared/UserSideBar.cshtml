@using PetLink.Models.Enums
@{
    ViewData["Title"] = "User Side Bar";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<div class="list-group list-group-flush mb-3 sidebar-profile">
    <a href="#" class="list-group-item list-group-item-action mb-1">
        <i class="bi bi-person-circle me-2"></i>My Profile
    </a>
    @if (userRole == UserRole.User.ToString() || userRole == UserRole.PetSitter.ToString())
    {

        <a asp-controller="Favorites" asp-action="Index" class="list-group-item list-group-item-action mb-1">
            <i class="bi bi-heart me-2"></i>My Favorites
        </a>
    }
    <a href="#" class="list-group-item list-group-item-action mb-1">
        <i class="bi bi-file-ruled me-2"></i>Applications
    </a>

    <a asp-controller="Messages" asp-action="Index"
           class="list-group-item list-group-item-action mb-1 @(currentAction == "Index" ? "active" : "")">
        <i class="bi bi-chat-left me-2"></i>Messages
    </a>

</div>
<p class="text-muted small">SUPPORT</p>
<div class="list-group list-group-flush sidebar-profile">
    <a href="#" class="list-group-item list-group-item-action mb-1">
        <i class="bi bi-question-circle me-2"></i>Help Center
    </a>
    <a asp-controller="Profile" asp-action="AccountSettings" class="list-group-item list-group-item-action mb-1">
        <i class="bi bi-gear me-2"></i>Account Settings
    </a>
</div>