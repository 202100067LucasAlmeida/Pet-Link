@using PetLink.Models.Enums
@model IEnumerable<PetLink.Models.AnimalListing>

@{
    ViewData["Title"] = "My Favorites";
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-3 mb-4">
            @await Html.PartialAsync("~/Views/Shared/UserSideBar.cshtml")
        </div>
        
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-primary-blue fw-bold mb-0">
                    <i class="bi bi-heart-fill me-2"></i>My Favorites</h2>
                <span class="badge bg-primary rounded-pill">@Model.Count() Pets</span>
            </div>
            
            @if (!Model.Any())
            {
                <div class="text-center py-5 bg-light rounded-4 border-dashed">
                    <div class="mb-3">
                        <i class="bi bi-heart text-secondary-grey opacity-25" style="font-size: 4rem;"></i>
                    </div>
                    <h4 class="fw-bold text-secondary-grey">Your favorites list is empty</h4>
                    <p class="text-secondary-grey px-3">Start adding pets to your favorites by clicking the heart icon on pet
                        listings!
                    </p>
                    <a asp-controller="AnimalListings" asp-action="Index" class="btn btn-primary rounded-pill px-4 mt-2">
                        Browse Pets
                    </a>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var item in Model)
                    {
                        <div class="col-md-6 col-xl-4 favorite-card-container">
                            <div class="card pet-card border-0 shadow-sm rounded-4 overflow-hidden h-100 d-flex flex-column">
                                <div class="pet-card-img-wrapper position-relative">
                                    <a asp-controller="AnimalListings" asp-action="Details" asp-route-id="@item.Id">
                                        @* Lógica de imagem idêntica ao Index.cshtml *@
                                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/default-pet.jpg" : item.ImageUrl)"
                                             class="img-fluid w-100" style="height: 220px; object-fit: cover;"
                                             onerror="this.src='/images/default-pet.jpg'">
                                    </a>

                                    <button class="btn-heart favorite-toggle active position-absolute top-0 end-0 m-2"
                                            data-pet-id="@item.Id">
                                        <i class="bi bi-heart-fill text-danger"></i>
                                    </button>

                                    @if (item.Status == ListingStatus.Published)
                                    {
                                        <span class="badge-adoptable position-absolute bottom-0 start-0 m-3">ADOPTABLE</span>
                                    }
                                </div>

                                <div class="card-body p-3 d-flex flex-column flex-grow-1">
                                    <a asp-controller="AnimalListings" asp-action="Details" asp-route-id="@item.Id"
                                           class="text-decoration-none">
                                        <h4 class="h5 fw-bold mb-0 text-primary-darkblue">@item.Name</h4>
                                    </a>
                                    <p class="text-secondary-grey small mb-1">
                                        <i class="bi bi-geo-alt"></i> @item.Location
                                    </p>
                                    <p class="text-secondary-grey small mb-3">@item.Species • @item.AgeMonths mo.</p>

                                    <div class="d-flex flex-wrap gap-2 mt-auto">
                                        @if (item.IsVaccinated)
                                        {
                                            <span class="pet-tag pet-tag-green">VACCINATED</span>
                                        }
                                        @if (item.IsSterilized)
                                        {
                                            <span class="pet-tag pet-tag-green">STERILIZED</span>
                                        }
                                        @if (!item.IsVaccinated && !item.IsSterilized)
                                        {
                                            <span class="pet-tag">NEEDS VET</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Handler para remover dos favoritos nesta página específica
            $(document).on('click', '.btn-heart', function (e) {
                e.preventDefault();
                e.stopPropagation();

                var button = $(this);
                var petId = button.data('pet-id');
                var cardContainer = button.closest('.favorite-card-container');

                $.ajax({
                    url: '@Url.Action("Toggle", "Favorites")',
                    type: 'POST',
                    data: { animalListingId: petId },
                    success: function (response) {
                        if (response.success) {
                            if (!response.isFavorited) {
                                // Efeito visual de remoção
                                cardContainer.fadeOut(300, function () {
                                    $(this).remove();
                                    // Se não sobrarem cards, recarrega para mostrar o estado vazio
                                    if ($('.favorite-card-container').length === 0) {
                                        location.reload();
                                    }
                                });
                                showNotification('Removed from favorites!');
                            }
                        }
                    },
                    error: function () {
                        showNotification('Error updating favorite', 'error');
                    }
                });
            });

            function showNotification(message) {
                $('.toast-notification').remove();
                var toast = $(`<div class="toast-notification">${message}</div>`);
                $('body').append(toast);
                setTimeout(() => toast.fadeOut(300, function () { $(this).remove(); }), 2000);
            }
        });
    </script>
}