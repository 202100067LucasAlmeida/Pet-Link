@using PetLink.Models.Enums
@model PetLink.Models.ViewModels.FavoritesViewModel

@{
    ViewData["Title"] = "My Favorites";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="row">
            <div class="col-lg-3 mb-4">
                @await Html.PartialAsync("~/Views/Shared/UserSideBar.cshtml")
            </div>
        
            <div class="col-lg-9">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="text-primary-blue fw-bold mb-0">
                        <i class="bi bi-heart-fill me-2"></i>My Favorites
                    </h2>
                </div>

                <!-- SECÇÃO: ANIMAIS FAVORITOS -->
                <div class="mb-5">
                    <h4 class="fw-bold text-primary-darkblue mb-3">
                        <i class="bi bi-paw-fill me-2 text-primary"></i>Favorite Pets
                    </h4>
                    
                    @if (Model.FavoritePets == null || !Model.FavoritePets.Any())
                    {
                        <div class="text-center py-5 bg-primary-light rounded-3">
                            <i class="bi bi-heart" style="font-size: 3rem; color: var(--petlink-muted-icon);"></i>
                            <p class="text-muted mt-2">No favorite pets yet</p>
                            <a asp-controller="AnimalListings" asp-action="Index"
                                   class="btn btn-sm btn-primary rounded-pill">
                                Browse Pets
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="row g-4">
                            @foreach (var pet in Model.FavoritePets)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <div class="card h-100 border-0 shadow-sm pet-card">
                                        <div class="pet-card-img-wrapper position-relative">
                                            <img src="@(string.IsNullOrEmpty(pet.ImageUrl) ? "/images/default-avatar.jpg" : pet.ImageUrl)"
                                                 alt="@pet.Name" class="w-100" class="img-fluid w-100 h-100"
                                                 style="height: 200px; width: 100%; object-fit: cover; border-radius: 12px 12px 0 0;">
                                            
                                            <button class="btn-heart active position-absolute top-0 end-0 m-2"
                                                    data-pet-id="@pet.Id" data-type="pet">
                                                <i class="bi bi-heart-fill text-danger"></i>
                                            </button>
                                            
                                            <span
                                            class="badge-adoptable position-absolute bottom-0 start-0 m-3">ADOPTABLE</span>
                                        </div>
                                        
                                        <div class="card-body">
                                            <h6 class="fw-bold text-primary-darkblue mb-1">@pet.Name</h6>
                                            <small class="text-muted d-block">
                                                <i class="bi bi-geo-alt"></i>@pet.Location
                                            </small>
                                            <small class="text-muted">@pet.Species • @pet.AgeMonths months</small>
                                            <div class="mt-3">
                                                <a asp-controller="AnimalListings" asp-action="Details" asp-route-id="@pet.Id"
                                                       class="btn btn-outline-primary rounded-pill w-100 btn-sm">
                                                    View Details
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- SECÇÃO: PETSITTERS FAVORITOS -->
                
                <div class="mt-5">
                    <h4 class="fw-bold text-primary-darkblue mb-3">
                        <i class="bi bi-person-badge me-2 text-primary"></i>Favorite Petsitters
                    </h4>
                    
                    @if (Model.FavoritePetsitters == null || !Model.FavoritePetsitters.Any())
                    {
                        <div class="text-center py-5 bg-primary-light rounded-3">
                            <i class="bi bi-heart" style="font-size: 3rem; color: var(--petlink-muted-icon);"></i>
                            <p class="text-muted mt-2">No favorite petsitters yet</p>
                            <a asp-controller="Petsitter" asp-action="Index" 
                                    class="btn btn-sm btn-primary rounded-pill">
                                Browse Petsitters
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="row g-4">
                            @foreach (var petsitter in Model.FavoritePetsitters)
                            {
                                <div class="col-md-6 col-lg-4">
                                    
                                    <div class="card h-100 border-0 shadow-sm pet-card d-flex flex-column"
                                         style="background-color: var(--petlink-card-bg); border-radius: 12px;">
                                        
                                        <div class="pet-card-img-wrapper position-relative">
                                            <a asp-controller="Petsitter" asp-action="Details" asp-route-id="@petsitter.Id">
                                                <img src="@(string.IsNullOrEmpty(petsitter.User.ProfilePicture) ? "/images/default-avatar.jpg" : petsitter.User.ProfilePicture)"
                                                     alt="@petsitter.User.Name" class="w-100"
                                                     style="height: 200px; width: 100%; object-fit: cover; border-radius: 12px 12px 0 0;"
                                                     onerror="this.src='/images/default-avatar.jpg'">
                                            </a>
                                            
                                            <!-- Botão de coração atualizado com a classe 'btn-heart' para ficar igual ao dos pets -->
                                            <button
                                                class="favorite-petsitter-btn btn-heart active position-absolute top-0 end-0 m-2"
                                                data-petsitter-id="@petsitter.Id">
                                                <i class="bi bi-heart-fill text-danger"></i>
                                            </button>
                                        </div>

                                        <div class="card-body">
                                            <h6 class="fw-bold text-primary-darkblue mb-1">@petsitter.User.Name</h6>
                                            <small class="text-muted d-block">
                                                <i class="bi bi-geo-alt"></i>@petsitter.User.City
                                            </small>
                                            <div class="mt-3">
                                                <a asp-controller="Petsitter" asp-action="Details" asp-route-id="@petsitter.Id"
                                                       class="btn btn-outline-primary rounded-pill w-100 btn-sm">
                                                    View Details
                                                </a>
                                            </div>
                                        </div>


                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Toggle para animais
            $('.btn-heart').click(function (e) {
                e.preventDefault();
                e.stopPropagation();
                
                var button = $(this);
                var petId = button.data('pet-id');
                var card = button.closest('.col-md-6');
                
                $.ajax({
                    url: '@Url.Action("Toggle", "Favorites")',
                    type: 'POST',
                    data: { animalListingId: petId },
                    success: function (response) {
                        if (response.success) {
                            card.fadeOut(300, function () { $(this).remove(); });
                            showNotification(response.message);
                        }
                    }
                });
            });
            
            // Toggle para petsitters
            $('.favorite-petsitter-btn').click(function (e) {
                e.preventDefault();
                
                var button = $(this);
                var petsitterId = button.data('petsitter-id');
                var card = button.closest('.col-md-6');
                
                $.ajax({
                    url: '@Url.Action("TogglePetsitter", "Favorites")',
                    type: 'POST',
                    data: { petsitterId: petsitterId },
                    success: function (response) {
                        if (response.success) {
                            card.fadeOut(300, function () { $(this).remove(); });
                            showNotification(response.message);
                        }
                    }
                });
            });
            
            function showNotification(message) {
                $('.toast-notification').remove();
                var toast = $(`<div class="toast-notification">${message}</div>`);
                $('body').append(toast);
                setTimeout(() => toast.fadeOut(300, function () { $(this).remove(); }), 2000);
            }
        });
    </script>
}

