@using PetLink.Models.Enums
@model PetLink.Models.ViewModels.FavoritesViewModel

@{
    ViewData["Title"] = "My Favorites";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="row">
            <div class="col-lg-3 mb-4">
                @await Html.PartialAsync("~/Views/Shared/UserSideBar.cshtml")
            </div>
        
            <div class="col-lg-9">
                <h2 class="text-primary-blue mb-4">My Favorites</h2>

                <!-- SECÇÃO: ANIMAIS FAVORITOS -->
                <div class="mb-5">
                    <h4 class="fw-bold text-primary-darkblue mb-3">
                        <i class="bi bi-paw-fill me-2 text-primary"></i>Favorite Pets
                    </h4>
                    
                    @if (Model.FavoritePets == null || !Model.FavoritePets.Any())
                    {
                        <div class="text-center py-5 bg-primary-light rounded-3">
                            <i class="bi bi-heart" style="font-size: 3rem; color: #ccc;"></i>
                            <p class="text-muted mt-2">No favorite pets yet</p>
                            <a asp-controller="AnimalListings" asp-action="Index" class="btn btn-sm btn-primary rounded-pill">
                                Browse Pets
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="row g-4">
                            @foreach (var pet in Model.FavoritePets)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <div class="card h-100 border-0 shadow-sm pet-card">
                                        <div class="pet-card-img-wrapper position-relative">
                                            @{
                                                var imagePath = $"/images/{pet.Name.ToLower()}.jpg";
                                                var fullPath = System.IO.Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "images", $"{pet.Name.ToLower()}.jpg");
                                                var imageExists = System.IO.File.Exists(fullPath);
                                            }
                                            @if (imageExists)
                                            {
                                                <img src="@imagePath" alt="@pet.Name" 
                                                     class="w-100" style="height: 160px; object-fit: cover; border-radius: 12px 12px 0 0;">
                                            }
                                            else
                                            {
                                                <div class="bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center" 
                                                     style="height: 160px; border-radius: 12px 12px 0 0;">
                                                    <i class="bi bi-image text-muted fs-1"></i>
                                                </div>
                                            }
                                            <button class="btn-heart active position-absolute top-0 end-0 m-2" 
                                                    data-pet-id="@pet.Id" data-type="pet">
                                                <i class="bi bi-heart-fill text-danger"></i>
                                            </button>
                                            <span class="badge-adoptable position-absolute bottom-0 start-0 m-3">ADOPTABLE</span>
                                        </div>
                                        <div class="card-body">
                                            <h6 class="fw-bold text-primary-darkblue mb-1">@pet.Name</h6>
                                            <small class="text-muted d-block">@pet.Location, Portugal</small>
                                            <small class="text-muted">@pet.Species • @pet.AgeMonths months</small>
                                            <div class="mt-3">
                                                <a asp-controller="AnimalListings" asp-action="Details" asp-route-id="@pet.Id" 
                                                   class="btn btn-outline-primary rounded-pill w-100 btn-sm">
                                                    View Details
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- SECÇÃO: PETSITTERS FAVORITOS -->
                <div class="mt-5">
                    <h4 class="fw-bold text-primary-darkblue mb-3">
                        <i class="bi bi-person-badge me-2 text-primary"></i>Favorite Petsitters
                    </h4>
                    
                    @if (Model.FavoritePetsitters == null || !Model.FavoritePetsitters.Any())
                    {
                        <div class="text-center py-5 bg-primary-light rounded-3">
                            <i class="bi bi-heart" style="font-size: 3rem; color: #ccc;"></i>
                            <p class="text-muted mt-2">No favorite petsitters yet</p>
                            <a asp-controller="Petsitter" asp-action="Index" class="btn btn-sm btn-primary rounded-pill">
                                Browse Petsitters
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="row g-4">
                            @foreach (var petsitter in Model.FavoritePetsitters)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body text-center">
                                            <div class="mb-3">
                                                @if (!string.IsNullOrEmpty(petsitter.ProfilePicture))
                                                {
                                                    <img src="@petsitter.ProfilePicture" alt="@petsitter.Name" 
                                                         class="rounded-circle" style="width: 80px; height: 80px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="bg-secondary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mx-auto" 
                                                         style="width: 80px; height: 80px;">
                                                        <i class="bi bi-person-circle text-secondary fs-1"></i>
                                                    </div>
                                                }
                                            </div>
                                            <h6 class="fw-bold text-primary-darkblue mb-1">@petsitter.Name</h6>
                                            <small class="text-muted d-block">@petsitter.City</small>
                                            <small class="text-muted">@petsitter.Email</small>
                                            <div class="mt-3 d-flex gap-2">
                                                <a asp-controller="Profile" asp-action="TutorProfile" asp-route-id="@petsitter.Id" 
                                                   class="btn btn-outline-primary rounded-pill w-100 btn-sm">
                                                    View Profile
                                                </a>
                                                <button class="btn btn-outline-danger rounded-pill favorite-petsitter-btn" 
                                                        data-petsitter-id="@petsitter.Id">
                                                    <i class="bi bi-heart-fill text-danger"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Toggle para animais
            $('.btn-heart').click(function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                var button = $(this);
                var petId = button.data('pet-id');
                var card = button.closest('.col-md-6');
                
                $.ajax({
                    url: '@Url.Action("Toggle", "Favorites")',
                    type: 'POST',
                    data: { animalListingId: petId },
                    success: function(response) {
                        if (response.success) {
                            card.fadeOut(300, function() { $(this).remove(); });
                            showNotification(response.message);
                        }
                    }
                });
            });
            
            // Toggle para petsitters
            $('.favorite-petsitter-btn').click(function(e) {
                e.preventDefault();
                
                var button = $(this);
                var petsitterId = button.data('petsitter-id');
                var card = button.closest('.col-md-6');
                
                $.ajax({
                    url: '@Url.Action("TogglePetsitter", "Favorites")',
                    type: 'POST',
                    data: { petsitterId: petsitterId },
                    success: function(response) {
                        if (response.success) {
                            card.fadeOut(300, function() { $(this).remove(); });
                            showNotification(response.message);
                        }
                    }
                });
            });
            
            function showNotification(message) {
                $('.toast-notification').remove();
                var toast = $(`<div class="toast-notification">${message}</div>`);
                $('body').append(toast);
                setTimeout(() => toast.fadeOut(300, function() { $(this).remove(); }), 2000);
            }
        });
    </script>
}

