@model PetLink.Models.User

@{
    ViewData["Title"] = @Model.Name + " - Profile";
}

<section class="py-4">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="mb-4">
                    @if (Model.IsVerified)
                    {
                        <span class="badge bg-success mb-2"><i class="bi bi-shield-check me-1"></i> VERIFIED USER</span>
                    }

                    <h1 class="display-5 text-primary-darkblue mb-2 fw-bold">@Model.Name</h1>
                    <p class="lead text-muted">@Model.Role • ID: #@Model.Id</p>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-5">
                    <div class="card-body p-4">
                        <h3 class="h5 text-primary-darkblue mb-3 fw-bold">About @Model.Name</h3>
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted fw-semibold mb-2">Email</dt>
                            <dd class="col-sm-8 mb-3">@Model.Email</dd>
                            <dt class="col-sm-4 text-muted fw-semibold mb-2">Phone</dt>
                            <dd class="col-sm-8 mb-3">@(Model.Phone ?? "Not provided")</dd>
                            <dt class="col-sm-4 text-muted fw-semibold mb-2">Role</dt>
                            <dd class="col-sm-8 mb-3">
                                <span class="badge bg-secondary rounded-pill px-3">@Model.Role</span>
                            </dd>
                            <dt class="col-sm-4 text-muted fw-semibold mb-2">Verified</dt>
                            <dd class="col-sm-8 mb-0">
                                @if (Model.IsVerified)
                                {
                                    <span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i> Yes</span>
                                }
                                else
                                {
                                    <span class="text-warning fw-bold"><i class="bi bi-exclamation-circle-fill me-1"></i> No</span>
                                }
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0 sticky-top" style="top: 20px; border-radius: 20px; overflow: hidden;">
                    <div class="card-header border-0 py-3" style="background-color: var(--petlink-primary); color: white;">
                        <div class="d-flex align-items-center">
                            <div class="bg-white rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi bi-chat-dots-fill" style="color: var(--petlink-primary);"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">Message @Model.Name</h6>
                                <small style="opacity: 0.8;">Start a conversation</small>
                            </div>
                        </div>
                    </div>

                    <div class="card-body" id="chatBox" style="height: 400px; overflow-y: auto; background-color: var(--petlink-grey-bg);">
                        @if (ViewBag.ChatHistory != null && ((IEnumerable<PetLink.Models.Message>)ViewBag.ChatHistory).Any())
                        {
                            var currentUserId = int.Parse(User.FindFirst("UserId")?.Value ?? "0");
                            @foreach (var msg in (IEnumerable<PetLink.Models.Message>)ViewBag.ChatHistory)
                            {
                                bool isMine = msg.SenderId == currentUserId;
                                <div class="d-flex mb-3 @(isMine ? "justify-content-end" : "justify-content-start")">
                                    <div class="p-3 shadow-sm" 
                                         style="max-width: 85%; border-radius: 18px; font-size: 0.85rem;
                                                @(isMine ? "background-color: var(--petlink-primary); color: white; border-bottom-right-radius: 4px;" 
                                                         : "background-color: white; color: var(--petlink-dark); border-bottom-left-radius: 4px;")">
                                        <p class="mb-0">@msg.Content</p>
                                        <div class="text-end" style="font-size: 0.6rem; opacity: 0.7; margin-top: 4px;">
                                            @msg.Timestamp.ToString("HH:mm")
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="h-100 d-flex flex-column align-items-center justify-content-center text-center p-4">
                                <i class="bi bi-chat-dots mb-2" style="font-size: 3rem; color: var(--petlink-primary); opacity: 0.25;"></i>
                                <p class="text-muted small">No messages yet. Say hi to @Model.Name.Split(' ')[0]!</p>
                            </div>
                        }
                    </div>

                    <div class="card-footer bg-white border-0 p-3">
                        <a asp-controller="Messages" asp-action="Index" asp-route-id="@Model.Id" 
                           class="btn w-100 text-white fw-bold rounded-pill py-2 d-flex align-items-center justify-content-center gap-2"
                           style="background-color: var(--petlink-primary);">
                            <i class="bi bi-chat-dots-fill"></i>
                            Message @Model.Name
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@if (User.IsInRole("Admin"))
{
    <div class="container my-5">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-footer bg-light border-0 rounded-bottom-4 p-4 d-flex justify-content-end gap-2">
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary rounded-pill px-4 fw-bold">
                    <i class="bi bi-pencil me-1"></i> Edit User
                </a>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            var chatBox = document.getElementById("chatBox");
            if (chatBox) {
                chatBox.scrollTop = chatBox.scrollHeight;
            }
        });
    </script>
}
