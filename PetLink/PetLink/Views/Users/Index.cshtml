@model IEnumerable<PetLink.Models.User>

@{
    ViewData["Title"] = "Test Users";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary-blue fw-bold">
            <i class="bi bi-people-fill me-2"></i> Users in Database
        </h2>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Verified?</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-4 text-muted">#@user.Id</td>
                            <td class="fw-bold text-dark">@user.Name</td>
                            <td>@user.Email</td>
                            <td>
                                @* Mostra a Role (Admin, Adotante, etc) numa badge cinzenta *@
                                <span class="badge bg-secondary rounded-pill fw-normal">@user.Role</span>
                            </td>
                            <td>
                                @* Mostra uma badge verde ou amarela dependendo se está verificado *@
                                @if (user.IsVerified)
                                {
                                    <span class="badge bg-success rounded-pill fw-normal px-3">
                                        <i class="bi bi-check-circle me-1"></i> Yes
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark rounded-pill fw-normal px-3">
                                        <i class="bi bi-hourglass-split me-1"></i> Pending
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* Mensagem de segurança caso a base de dados esteja vazia *@
    @if (!Model.Any())
    {
        <div class="alert alert-info mt-4 rounded-4" role="alert">
            <i class="bi bi-info-circle me-2"></i> No users found in the database. Did the SeedData run?
        </div>
    }
</div>