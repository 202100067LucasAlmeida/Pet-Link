@model IEnumerable<PetLink.Models.User>

@{
    ViewData["Title"] = "Manage Users";
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-3 mb-4">
            @await Html.PartialAsync("~/Views/Shared/UserSideBar.cshtml")
        </div>

        <div class="col-lg-9">
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-primary-blue fw-bold mb-0">
                    <i class="bi bi-people-fill me-2"></i> User Management
                </h2>
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                    <i class="bi bi-plus-lg me-2"></i> Add User
                </a>
            </div>

            @* Card com fundo dinâmico *@
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden"
                 style="background-color: var(--petlink-card-bg);">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="color: var(--petlink-dark);">
                        @* Cabeçalho Dinâmico: Substituído table-light por var(--petlink-grey-bg) *@
                        <thead style="background-color: var(--petlink-grey-bg); color: var(--petlink-dark);">
                            <tr style="border-bottom: 1px solid var(--petlink-border);">
                                <th class="ps-4 py-3 small text-uppercase opacity-75">ID</th>
                                <th class="py-3 small text-uppercase opacity-75">Name</th>
                                <th class="py-3 small text-uppercase opacity-75">Email</th>
                                <th class="py-3 small text-uppercase opacity-75">Role</th>
                                <th class="py-3 small text-uppercase opacity-75">Verified?</th>
                                <th class="text-end pe-4 py-3 small text-uppercase opacity-75">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr onclick="window.location.href='@Url.Action("Details", new { id = item.Id })';"
                                    style="cursor: pointer; border-bottom: 1px solid var(--petlink-border);">
                                    
                                    <td class="ps-4 small opacity-50">#@item.Id</td>
                                    <td class="fw-bold">@item.Name</td>
                                    <td class="small opacity-75">@item.Email</td>

                                    <td>
                                        @if (item.Role.ToString() == "Admin")
                                        {
                                            <span class="badge rounded-pill fw-bold px-3 border"
                                                  class="badge-status-rejected">
                                                @item.Role
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill fw-bold px-3 border"
                                                  style="background-color: var(--petlink-light-bg); color: var(--petlink-primary); border-color: var(--petlink-primary) !important;">
                                                @item.Role
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.IsVerified)
                                        {
                                            <span class="badge rounded-pill fw-bold px-3 border"
                                                  class="badge-status-confirmed">
                                                <i class="bi bi-check-circle me-1"></i> Yes
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill fw-bold px-3 border"
                                                  class="badge-status-pending">
                                                <i class="bi bi-hourglass-split me-1"></i> Pending
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end pe-4">
                                        <div class="btn-group shadow-sm rounded-pill overflow-hidden"
                                             style="border: 1px solid var(--petlink-border);">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm py-1 px-3"
                                                   title="Edit"
                                                   style="background-color: var(--petlink-card-bg); color: var(--petlink-primary);"
                                                   onclick="event.stopPropagation();">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm py-1 px-3"
                                                   title="Delete"
                                                   style="background-color: var(--petlink-card-bg); color: #dc3545;"
                                                   onclick="event.stopPropagation();">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (!Model.Any())
            {
                <div class="alert mt-4 rounded-4 border-0 shadow-sm" role="alert"
                     style="background-color: var(--petlink-light-bg); color: var(--petlink-primary);">
                    <i class="bi bi-info-circle me-2"></i> No users found in the database.
                </div>
            }
        </div>
    </div>
</div>