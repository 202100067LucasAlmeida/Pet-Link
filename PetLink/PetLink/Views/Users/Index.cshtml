@model IEnumerable<PetLink.Models.User>

@{
    ViewData["Title"] = "Manage Users";
}

<div class="container py-4">
    <div class="row">
        <!-- Barra Lateral à Esquerda -->
        <div class="col-lg-3 mb-4">
            @await Html.PartialAsync("~/Views/Shared/UserSideBar.cshtml")
        </div>

        <!-- Conteúdo Principal à Direita -->
        <div class="col-lg-9">
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-primary-blue fw-bold mb-0">
                    <i class="bi bi-people-fill me-2"></i> User Management
                </h2>
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                    <i class="bi bi-plus-lg me-2"></i> Add User
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-4">ID</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Verified?</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr onclick="window.location.href='@Url.Action("Details", new { id = item.Id })';"
                                    style="cursor: pointer;">
                                    
                                    <td class="ps-4 text-muted small">#@item.Id</td>
                                    <td class="fw-bold text-dark">@item.Name</td>
                                    <td>@item.Email</td>

                                    <td>
                                        @if (item.Role.ToString() == "Admin")
                                        {
                                            <span class="badge bg-danger rounded-pill fw-normal px-3">@item.Role</span>
                                        }
                                        else if (item.Role.ToString() == "User")
                                        {
                                            <span class="badge bg-primary rounded-pill fw-normal px-3">@item.Role</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark rounded-pill fw-normal px-3">@item.Role</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.IsVerified)
                                        {
                                            <span class="badge bg-success rounded-pill fw-normal px-3">
                                                <i class="bi bi-check-circle me-1"></i> Yes
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill fw-normal px-3">
                                                <i class="bi bi-hourglass-split me-1"></i> Pending
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end pe-4">
                                        <div class="btn-group shadow-sm rounded-pill" role="group">
                                            <!-- event.stopPropagation() aplicado aqui também -->
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-outline-primary py-1 px-2" title="Edit"
                                                   onclick="event.stopPropagation();">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            
                                            <a asp-action="Delete" asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-outline-danger py-1 px-2" title="Delete"
                                                   onclick="event.stopPropagation();">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info mt-4 rounded-4" role="alert">
                    <i class="bi bi-info-circle me-2"></i> No users found in the database.
                </div>
            }
        </div>
    </div>
</div>